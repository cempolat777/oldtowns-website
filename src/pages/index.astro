---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Old Towns Walks - Explore World Cities in 4K</title>

    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />

    <style is:inline>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        height: 100%;
        background-color: #0f0f0f;
        color: #f1f1f1;
        font-family: 'Roboto', sans-serif;
        overflow: hidden;
      }

      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0f0f0f;
      }
      ::-webkit-scrollbar-thumb {
        background: #373737;
        border-radius: 4px;
      }

      /* Navbar Layout */
      .navbar {
        height: 56px;
        background-color: #0f0f0f;
        border-bottom: 1px solid #222222;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
      }
      .nav-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .icon-btn {
        background: transparent;
        border: none;
        color: #f1f1f1;
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .icon-btn:hover {
        background-color: #272727;
      }

      /* Brand Logo */
      .brand-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        font-weight: 800;
        font-size: 15px;
        letter-spacing: 0.5px;
        border-radius: 3px;
        overflow: hidden;
      }
      .logo-box-1 {
        background-color: #1a1a1a;
        color: #fbc02d;
        padding: 4px 8px;
      }
      .logo-box-2 {
        background-color: #fbc02d;
        color: #0f0f0f;
        padding: 4px 8px;
      }

      /* Search Bar */
      .nav-center {
        display: flex;
        align-items: center;
        width: 45%;
        max-width: 650px;
      }
      .search-box {
        display: flex;
        width: 100%;
      }
      .search-input {
        width: 100%;
        background-color: #121212;
        border: 1px solid #303030;
        border-radius: 40px 0 0 40px;
        padding: 8px 16px;
        color: #f1f1f1;
        font-size: 14px;
        outline: none;
      }
      .search-input:focus {
        border-color: #fbc02d;
      }
      .search-btn {
        background-color: #222222;
        border: 1px solid #303030;
        border-left: none;
        border-radius: 0 40px 40px 0;
        padding: 0 20px;
        color: #f1f1f1;
        cursor: pointer;
        display: flex;
        align-items: center;
      }
      .search-btn:hover {
        background-color: #272727;
      }

      /* App Body Structure */
      .app-body {
        display: flex;
        margin-top: 56px;
        height: calc(100vh - 56px);
      }

      /* FIXED SIDEBAR */
      .sidebar {
        width: 240px;
        background-color: #0f0f0f;
        border-right: 1px solid #222222;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex-shrink: 0;
        height: 100%;
        overflow-y: auto;
      }
      .nav-link {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 10px 12px;
        border-radius: 10px;
        color: #aaaaaa;
        text-decoration: none;
        font-size: 14px;
      }
      .nav-link:hover {
        background-color: #272727;
        color: #ffffff;
      }
      .nav-link.active {
        background-color: #272727;
        color: #ffffff;
        font-weight: 500;
      }
      .nav-link.active .material-symbols-outlined {
        color: #fbc02d;
      }
      .sidebar-divider {
        border: none;
        border-top: 1px solid #222222;
        margin: 8px 0;
      }
      .sidebar-label {
        font-size: 11px;
        font-weight: 700;
        color: #aaaaaa;
        text-transform: uppercase;
        padding: 8px 12px 4px 12px;
      }

      /* REKLAM ALANLARI (SADECE SİLİK ÇİZGİLERLE BELİRTİLMİŞ YAZISIZ KUTULAR) */
      .sidebar-ad-container {
        position: sticky;
        top: 10px;
        margin-top: auto;
        padding: 12px;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        min-height: 250px;
        width: 100%;
      }

      .ad-banner-top {
        width: 100%;
        min-height: 90px;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        margin-bottom: 24px;
      }

      .ad-card-slot {
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        min-height: 220px;
        width: 100%;
      }

      /* MAIN CONTENT CONTAINER */
      .content-area {
        flex: 1;
        overflow-y: auto;
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      /* FIXED TOP HEADER INSIDE CONTENT AREA (KATEGORİLER VE ÜST BANNER KAYDIRILDIĞINDA SABİT KALIR) */
      .sticky-header-wrapper {
        position: sticky;
        top: 0;
        background-color: #0f0f0f;
        z-index: 10;
        padding: 24px 24px 0 24px;
      }

      .chips-bar {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 16px;
      }
      .chips-bar::-webkit-scrollbar {
        display: none;
      }
      .chip {
        background-color: #272727;
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
        cursor: pointer;
      }
      .chip:hover {
        background-color: #3f3f3f;
      }
      .chip.active {
        background-color: #ffffff;
        color: #000000;
      }

      .scrollable-grid-container {
        padding: 0 24px 24px 24px;
      }

      /* Video Grid (3 Columns) */
      .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px 20px;
      }

      .video-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      
      .thumbnail-wrapper {
        position: relative;
        width: 100%;
        padding-top: 56.25%;
        border-radius: 12px;
        overflow: hidden;
        background-color: #1f1f1f;
        border: 1px solid #222222;
        cursor: pointer;
      }

      .video-poster {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .thumbnail-wrapper:hover .video-poster {
        transform: scale(1.03);
      }

      .custom-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 58px;
        height: 58px;
        background-color: #fbc02d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        transition: transform 0.2s ease, background-color 0.2s ease;
        z-index: 2;
      }

      .custom-play-btn span {
        color: #0f0f0f;
        font-size: 32px;
        margin-left: 3px;
      }

      .thumbnail-wrapper:hover .custom-play-btn {
        transform: translate(-50%, -50%) scale(1.12);
        background-color: #ffca28;
      }

      .thumbnail-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      .video-details {
        display: flex;
        gap: 12px;
      }
      .video-info {
        display: flex;
        flex-direction: column;
        width: 100%;
      }
      .video-title {
        font-size: 15px;
        font-weight: 500;
        color: #f1f1f1;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .channel-name {
        font-size: 13px;
        color: #aaaaaa;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .verified-icon {
        font-size: 15px;
        color: #aaaaaa;
      }
      .video-stats {
        font-size: 13px;
        color: #aaaaaa;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 2px;
      }
      .badge-tag {
        margin-left: auto;
        background-color: #272727;
        color: #aaaaaa;
        font-size: 11px;
        font-weight: bold;
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid #303030;
      }

      /* MOBILE RESPONSIVE RULES */
      @media (max-width: 1100px) {
        .video-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 700px) {
        .sidebar {
          display: none;
        }
        .video-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }
        .nav-center {
          width: 60%;
        }
        .content-area {
          padding-bottom: 80px;
        }
        .sticky-header-wrapper {
          padding: 12px 12px 0 12px;
        }
        .scrollable-grid-container {
          padding: 0 12px 12px 12px;
        }
        .ad-banner-top {
          min-height: 50px;
        }
        .ad-card-slot {
          min-height: 180px;
        }
      }

      .mobile-bottom-nav {
        display: none;
      }
      @media (max-width: 700px) {
        .mobile-bottom-nav {
          display: flex;
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          height: 60px;
          background-color: #0f0f0f;
          border-top: 1px solid #222222;
          justify-content: space-around;
          align-items: center;
          z-index: 1000;
        }
        .mobile-nav-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          color: #aaaaaa;
          text-decoration: none;
          font-size: 10px;
          gap: 2px;
        }
        .mobile-nav-item.active, .mobile-nav-item:hover {
          color: #fbc02d;
        }
        .mobile-nav-item .material-symbols-outlined {
          font-size: 22px;
        }
      }
    </style>
  </head>
  
  <body>

    <!-- FIXED TOP NAVBAR -->
    <header class="navbar">
      <div class="nav-left">
        <button class="icon-btn">
          <span class="material-symbols-outlined">menu</span>
        </button>
        <a href="/" class="brand-logo">
          <div class="logo-box-1">OLD</div>
          <div class="logo-box-2">TOWNS</div>
        </a>
      </div>

      <div class="nav-center">
        <div class="search-box">
          <input 
            type="text" 
            placeholder="Search cities, countries, or walking tours..." 
            class="search-input"
          />
          <button class="search-btn">
            <span class="material-symbols-outlined">search</span>
          </button>
        </div>
      </div>
    </header>

    <!-- MAIN APP STRUCTURE -->
    <div class="app-body">
      
      <!-- FIXED SIDEBAR -->
      <aside class="sidebar">
        <a href="#" class="nav-link active">
          <span class="material-symbols-outlined">home</span> Home
        </a>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">directions_walk</span> Walking Tours
        </a>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">flight</span> Drone & Aerial
        </a>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">pedal_bike</span> POV Rides
        </a>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">nights_stay</span> Night & Rain
        </a>
        
        <hr class="sidebar-divider" />
        
        <div class="sidebar-label">Explore</div>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">museum</span> Museums
        </a>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">restaurant</span> Street Food
        </a>
        <a href="#" class="nav-link">
          <span class="material-symbols-outlined">movie</span> Documentaries
        </a>

        <!-- REKLAM 1: SOL SIDEBAR STICKY AD SLOT -->
        <div class="sidebar-ad-container"></div>
        <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid #1f2937; font-size: 0.75rem; color: #9ca3af;">
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; padding: 0 0.5rem; margin-bottom: 0.5rem;">
          <a href="/about" style="color: #9ca3af; text-decoration: none;">About</a>
          <a href="/privacy" style="color: #9ca3af; text-decoration: none;">Privacy</a>
          <a href="/contact" style="color: #9ca3af; text-decoration: none;">Contact</a>
        </div>
        <p style="padding: 0 0.5rem; font-size: 0.65rem; color: #4b5563;">&copy; {new Date().getFullYear()} Old Towns Walks</p>
      </div>
      </aside>

      <!-- MAIN SCROLLABLE CONTENT AREA -->
      <main class="content-area">
        
        <!-- FIXED TOP HEADER INSIDE CONTENT AREA (KATEGORİLER VE TOP BANNER) -->
        <div class="sticky-header-wrapper">
          <div class="chips-bar">
            {categories.map((category, index) => (
              <button class={`chip ${index === 0 ? 'active' : ''}`}>
                {category}
              </button>
            ))}
          </div>

          <!-- REKLAM 2: TOP BANNER AD SLOT -->
          <div class="ad-banner-top"></div>
        </div>

        <!-- VIDEO GRID CONTAINER -->
        <div class="scrollable-grid-container">
          <div class="video-grid">
            {myVideos.map((video, index) => (
              <>
                <div class="video-card">
                  <div class="thumbnail-wrapper" data-video-id={video.id}>
                    <img 
                      src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} 
                      alt={video.title} 
                      class="video-poster"
                      loading="lazy"
                    />
                    <div class="custom-play-btn">
                      <span class="material-symbols-outlined">play_arrow</span>
                    </div>
                  </div>

                  <div class="video-details">
                    <div class="video-info">
                      <h3 class="video-title">{video.title}</h3>
                      
                      <div class="channel-name">
                        <span>{video.channel}</span>
                        <span class="material-symbols-outlined verified-icon">check_circle</span>
                      </div>

                      <div class="video-stats">
                        <span class="badge-tag">{video.badge}</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- REKLAM 3: HER 5 VİDEODAN SONRA 6. SLOT OLARAK GELEN IN-FEED AD SLOT -->
                {(index + 1) % 5 === 0 && (
                  <div class="ad-card-slot"></div>
                )}
              </>
            ))}
          </div>
        </div>

      </main>

    </div>

    <!-- MOBILE NAVIGATION BAR -->
    <nav class="mobile-bottom-nav">
      <a href="/" class="mobile-nav-item active">
        <span class="material-symbols-outlined">home</span>
        <span>Home</span>
      </a>
      <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">bolt</span>
        <span>Shorts</span>
      </a>
      <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">flight</span>
        <span>Drone</span>
      </a>
      <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">grid_view</span>
        <span>Categories</span>
      </a>
    </nav>

    <!-- Inline Script -->
    <script is:inline>
      document.querySelectorAll('.thumbnail-wrapper').forEach(wrapper => {
        wrapper.addEventListener('click', () => {
          const videoId = wrapper.getAttribute('data-video-id');
          wrapper.innerHTML = `
            <iframe 
              src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&modestbranding=1&rel=0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
            ></iframe>
          `;
});
});
</script>
<!-- VideoObject Schema Structure for Google Videos -->
<script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  }))
)} />
  </body>
</html>


  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": walk.title,
  "description": `${walk.title} - High quality 4K 60fps POV walking tour.`,
  "thumbnailUrl": [
    `https://img.youtube.com/vi/${walk.id}/maxresdefault.jpg`

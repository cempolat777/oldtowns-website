<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function() {
        // Tarayıcı dilini al (tr, de, ja vb.)
        const userLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
        let targetLang = 'en';

        if (userLang.startsWith('tr')) {
          targetLang = 'tr';
        } else if (userLang.startsWith('de')) {
          targetLang = 'de';
        } else if (userLang.startsWith('ja')) {
          targetLang = 'ja';
        }

        // Kullanıcıyı tarayıcı diline göre ilgili klasöre uçur (/tr/, /de/, /en/)
        window.location.replace('/' + targetLang + '/');
      })();
    </script>
  </head>
  <body>
  </body>
</html>
---
import heroIzmir from "../assets/Walk for a Lifetime.png";
import heroGermany from "../assets/Walk for a Lifetime (1).png";
import hero03 from "../assets/hero-03.jpg";
import hero04 from "../assets/hero-04.jpg";
import hero05 from "../assets/hero-05.jpg";
import hero06 from "../assets/hero-06.jpg";
import hero07 from "../assets/hero-07.jpg";
import hero08 from "../assets/hero-08.jpg";
import hero09 from "../assets/hero-09.jpg";
import hero10 from "../assets/hero-10.jpg";

const featuredVideo = "cXorOhK2Abo";

const heroImages = [
  heroIzmir,
  heroGermany,
  hero03,
  hero04,
  hero05,
  hero06,
  hero07,
  hero08,
  hero09,
  hero10
];

const izmirTours = [
  {
    id: "-_CnD2d4Zus",
    title: "Izmir City Walk | Vibrant Streets & Old Town",
    views: "18,607 views"
  },
  {
    id: "BjBfo1UPJZA",
    title: "Izmir Walking Tour | Lively Spring Atmosphere",
    views: "11,201 views"
  },
  {
    id: "1c4lvi2geng",
    title: "Izmir Walking Tour | Lively City Streets",
    views: "10,783 views"
  },
  {
    id: "DrtuvDgJvmc",
    title: "Izmir Walking Tour | Historic Kemeraltı Bazaar",
    views: "6,809 views"
  },
  {
    id: "HsQ0-45emcU",
    title: "Izmir Walking Tour | Historic Streets & City Life",
    views: "5,796 views"
  }
];

const germanyTours = [
  {
    id: "cXorOhK2Abo",
    title: "Düsseldorf Walking Tour",
    views: ""
  },
  {
    id: "7e8o68jZyvU",
    title: "Düsseldorf Walking Tour",
    views: ""
  },
  {
    id: "JFWYuQnf1yg",
    title: "Düsseldorf Walking Tour",
    views: ""
  },
  {
    id: "pHAFLoHfFz8",
    title: "Düsseldorf Walking Tour",
    views: ""
  },
  {
    id: "MUw1riHcsaA",
    title: "Düsseldorf Walking Tour",
    views: ""
  }
];

const youtubeHighlights = [
  {
    id: "cXorOhK2Abo",
    title: "Düsseldorf Walking Tour"
  },
  {
    id: "-_CnD2d4Zus",
    title: "Izmir City Walk | Vibrant Streets & Old Town"
  },
  {
    id: "BjBfo1UPJZA",
    title: "Izmir Walking Tour | Lively Spring Atmosphere"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Old Towns | Walking Tours Around the World</title>

    <meta
      name="description"
      content="Explore cities, streets and destinations through immersive walking tours."
    />
  </head>

  <body>
    <header>
      <div class="container nav-inner">
        <a href="/" class="logo" aria-label="Old Towns Home">
          <span class="logo-old">OLD</span><span class="logo-towns">TOWNS</span>
        </a>

        <button
          class="menu-toggle"
          id="menuToggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mainNav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav id="mainNav">
          <a href="/">Home</a>
          <a href="/walking-tours">Walking Tours</a>
          <a href="/explore">Explore</a>
          <a href="/map">Map</a>
          <a href="/journal">Journal</a>
          <a href="/about">About</a>

          <a
            href="https://www.youtube.com/@oldtowns?sub_confirmation=1"
            class="youtube-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube
          </a>
        </nav>
      </div>
    </header>

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="hero-slides">
          {
            heroImages.map((image, index) => (
              <img
                src={image.src}
                alt={`Old Towns walking tour ${index + 1}`}
                class:list={{ active: index === 0 }}
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))
          }
        </div>

        <div class="hero-overlay">
          <div class="container hero-content">

            <div class="hero-copy">
              <p class="eyebrow">WALKING TOURS</p>

              <h1>
                Explore the world<br />
                one walk at a time.
              </h1>

              <p class="hero-text">
                Discover cities, streets and unforgettable places through
                immersive walking tours.
              </p>

              <div class="hero-actions">
                <a href="/walking-tours" class="button">
                  Explore Walking Tours
                </a>

                <a
                  href="https://www.youtube.com/@oldtowns?sub_confirmation=1"
                  class="hero-youtube"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit YouTube
                </a>
              </div>
            </div>

            <div class="hero-video">
              <div class="video-frame">
                <iframe
                  src={`https://www.youtube.com/embed/${featuredVideo}`}
                  title="Düsseldorf Walking Tour"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>

                <a
                  class="youtube-watch"
                  href={`https://www.youtube.com/watch?v=${featuredVideo}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Watch on YouTube
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>


      <!-- FROM OUR YOUTUBE -->
      <section class="youtube-section">
        <div class="container">

          <div class="section-heading">
            <p class="section-label">FROM OUR YOUTUBE</p>
            <h2>Selected Walks</h2>
          </div>

          <div class="youtube-grid">
            {
              youtubeHighlights.map((tour) => (
                <button
                  class="youtube-card"
                  data-video={tour.id}
                  data-title={tour.title}
                >
                  <div class="youtube-thumbnail">

                    <img
                      src={`https://img.youtube.com/vi/${tour.id}/maxresdefault.jpg`}
                      alt={tour.title}
                      loading="lazy"
                      onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${tour.id}/hqdefault.jpg';`}
                    />

                    <div class="youtube-play">
                      ▶
                    </div>

                    <div class="youtube-watch-small">
                      Watch on YouTube
                    </div>

                  </div>

                  <div class="youtube-card-info">
                    <h3>{tour.title}</h3>
                  </div>
                </button>
              ))
            }
          </div>

          <div class="youtube-more">
            <a
              href="https://www.youtube.com/@oldtowns?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Old Towns on YouTube →
            </a>
          </div>

        </div>
      </section>


      <!-- POPULAR IZMIR -->
      <section class="popular">
        <div class="container">

          <div class="section-heading">
            <p class="section-label">POPULAR WALKS</p>
            <h2>Turkey · İzmir</h2>
          </div>

          <div class="tour-grid five">
            {
              izmirTours.map((tour) => (
                <button
                  class="tour-card"
                  data-video={tour.id}
                  data-title={tour.title}
                >
                  <div class="thumbnail">

                    <img
                      src={`https://img.youtube.com/vi/${tour.id}/maxresdefault.jpg`}
                      alt={tour.title}
                      loading="lazy"
                      onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${tour.id}/hqdefault.jpg';`}
                    />

                    <div class="play-button">
                      ▶
                    </div>

                    <div class="youtube-watch-small">
                      Watch on YouTube
                    </div>

                  </div>

                  <div class="tour-info">
                    <span>🇹🇷 İZMIR · TURKEY</span>

                    <h3>{tour.title}</h3>

                    <small>
                      {tour.views ? `${tour.views} · ` : ""}4K
                    </small>
                  </div>
                </button>
              ))
            }
          </div>

        </div>
      </section>


      <!-- POPULAR GERMANY -->
      <section class="popular germany">
        <div class="container">

          <div class="section-heading">
            <p class="section-label">POPULAR WALKS</p>
            <h2>Germany · Düsseldorf</h2>
          </div>

          <div class="tour-grid five">
            {
              germanyTours.map((tour) => (
                <button
                  class="tour-card"
                  data-video={tour.id}
                  data-title={tour.title}
                >
                  <div class="thumbnail">

                    <img
                      src={`https://img.youtube.com/vi/${tour.id}/maxresdefault.jpg`}
                      alt={tour.title}
                      loading="lazy"
                      onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${tour.id}/hqdefault.jpg';`}
                    />

                    <div class="play-button">
                      ▶
                    </div>

                    <div class="youtube-watch-small">
                      Watch on YouTube
                    </div>

                  </div>

                  <div class="tour-info">
                    <span>🇩🇪 DÜSSELDORF · GERMANY</span>

                    <h3>{tour.title}</h3>

                    <small>
                      {tour.views ? `${tour.views} · ` : ""}4K
                    </small>
                  </div>
                </button>
              ))
            }
          </div>

        </div>
      </section>


      <!-- VIDEO MODAL -->
      <div class="video-modal" id="videoModal">
        <div class="modal-content">

          <button class="close-modal" id="closeModal" aria-label="Close video">
            ×
          </button>

          <div class="modal-video">
            <iframe
              id="modalPlayer"
              src=""
              title="Walking Tour"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>

          <h3 id="modalTitle"></h3>

          <a
            id="modalYoutube"
            class="modal-youtube"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch on YouTube
          </a>

        </div>
      </div>


      <!-- DESTINATIONS -->
      <section class="destinations">
        <div class="container">

          <div class="section-heading">
            <p class="section-label">EXPLORE</p>
            <h2>Our Destinations</h2>
          </div>

          <div class="destination-grid">

            <a href="/destinations/turkey" class="destination">
              <span>Turkey</span>
              <small>Explore →</small>
            </a>

            <a href="/destinations/germany" class="destination">
              <span>Germany</span>
              <small>Explore →</small>
            </a>

            <div class="destination coming-soon">
              <span>More destinations</span>
              <small>Coming soon</small>
            </div>

          </div>

        </div>
      </section>


      <!-- LATEST -->
      <section class="latest">
        <div class="container">

          <div class="section-heading">
            <p class="section-label">LATEST</p>
            <h2>Latest Walking Tours</h2>
          </div>

          <p class="empty-message">
            More walking tours will be added here.
          </p>

        </div>
      </section>

    </main>


    <footer>
      <div class="container footer-inner">
        <strong>OLD TOWNS</strong>
        <span>Walking Tours Around the World</span>
      </div>
    </footer>


    <script>
      const slides = document.querySelectorAll(".hero-slides img");

      let currentSlide = 0;

      if (slides.length > 1) {
        setInterval(() => {
          slides[currentSlide].classList.remove("active");

          currentSlide = (currentSlide + 1) % slides.length;

          slides[currentSlide].classList.add("active");
        }, 8000);
      }


      // Mobile menu toggle
      const menuToggle = document.getElementById("menuToggle");
      const mainNav = document.getElementById("mainNav");

      if (menuToggle && mainNav) {
        menuToggle.addEventListener("click", () => {
          const isOpen = mainNav.classList.toggle("open");
          menuToggle.classList.toggle("open", isOpen);
          menuToggle.setAttribute("aria-expanded", String(isOpen));
        });

        mainNav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            mainNav.classList.remove("open");
            menuToggle.classList.remove("open");
            menuToggle.setAttribute("aria-expanded", "false");
          });
        });
      }


      const modal = document.getElementById("videoModal");
      const player = document.getElementById("modalPlayer");
      const modalTitle = document.getElementById("modalTitle");
      const modalYoutube = document.getElementById("modalYoutube");
      const closeButton = document.getElementById("closeModal");


      document
        .querySelectorAll(".tour-card, .youtube-card")
        .forEach((card) => {

          card.addEventListener("click", () => {

            const videoId = card.getAttribute("data-video");
            const title = card.getAttribute("data-title");

            player.src =
              `https://www.youtube.com/embed/${videoId}?autoplay=1`;

            player.title = title;

            modalTitle.textContent = title;

            modalYoutube.href =
              `https://www.youtube.com/watch?v=${videoId}`;

            modal.classList.add("open");

            document.body.classList.add("modal-open");

          });

        });


      function closeVideo() {
        modal.classList.remove("open");

        player.src = "";

        document.body.classList.remove("modal-open");
      }


      closeButton.addEventListener("click", closeVideo);


      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeVideo();
        }
      });


      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeVideo();
        }
      });
    </script>

  </body>
</html>


<style>
  * {
    box-sizing: border-box;
  }


  body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: #111;
    background: #fff;
  }


  body.modal-open {
    overflow: hidden;
  }


  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }


  /* HEADER */

  header {
    border-bottom: 1px solid #eee;
    background: #fff;
  }


  .nav-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }


  .logo {
    display: inline-flex;
    align-items: stretch;
    text-decoration: none;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1px;
    line-height: 1;
  }


  .logo-old {
    background: #111;
    color: #f3c400;
    padding: 12px 11px;
  }


  .logo-towns {
    background: #f3c400;
    color: #111;
    padding: 12px 11px;
  }


  nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }


  nav a {
    color: #333;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
  }


  nav a:hover {
    color: #111;
  }


  .youtube-button {
    background: #111;
    color: #f3c400 !important;
    padding: 11px 17px;
    font-weight: 800 !important;
  }


  /* MOBILE MENU TOGGLE */

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;

    width: 40px;
    height: 40px;

    padding: 8px;

    background: transparent;
    border: 0;

    cursor: pointer;
  }


  .menu-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: #111;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }


  .menu-toggle.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }


  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
  }


  .menu-toggle.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }


  /* HERO */

  .hero {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    color: #fff;
  }


  .hero-slides {
    position: absolute;
    inset: 0;
  }


  .hero-slides img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.02);

    transition:
      opacity 1.8s ease,
      transform 8s ease;
  }


  .hero-slides img.active {
    opacity: 1;
    transform: scale(1);
  }


  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;

    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.55) 34%,
        rgba(0, 0, 0, 0.20) 67%,
        rgba(0, 0, 0, 0.10) 100%
      );
  }


  .hero-content {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    align-items: center;
    gap: 65px;
  }


  .hero-copy {
    max-width: 620px;
  }


  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }


  h1 {
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1.02;
    margin: 0 0 24px;
    max-width: 800px;
  }


  .hero-text {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 30px;
  }


  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }


  .button {
    display: inline-block;
    padding: 14px 22px;
    background: #fff;
    color: #111;
    text-decoration: none;
    font-weight: 700;
  }


  .hero-youtube {
    display: inline-block;
    padding: 14px 22px;
    background: #111;
    color: #f3c400;
    text-decoration: none;
    font-weight: 800;
  }


  .hero-video {
    width: 100%;
  }


  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.35);
  }


  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }


  .youtube-watch {
    position: absolute;
    left: 15px;
    bottom: 15px;

    padding: 8px 12px;

    background: #fff;
    color: #111;

    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
  }


  /* SECTIONS */

  section:not(.hero) {
    padding: 82px 0;
  }


  .section-heading {
    margin-bottom: 38px;
  }


  .section-label {
    display: inline-block;

    margin: 0 0 14px;

    padding: 8px 12px;

    background: #111;
    color: #f3c400;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.7px;
  }


  h2 {
    font-size: 42px;
    margin: 0;
    line-height: 1.1;
  }


  /* YOUTUBE */

  .youtube-section {
    background: #fff;
  }


  .youtube-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }


  .youtube-card {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    color: #111;
    text-align: left;
    font-family: inherit;
    background: #f5f5f5;
    overflow: hidden;
    cursor: pointer;
  }


  .youtube-thumbnail {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }


  .youtube-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

    transition: transform 0.3s ease;
  }


  .youtube-card:hover img {
    transform: scale(1.03);
  }


  .youtube-play {
    position: absolute;
    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    width: 60px;
    height: 60px;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.80);
    color: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 22px;
    padding-left: 4px;
  }


  .youtube-watch-small {
    position: absolute;
    left: 12px;
    bottom: 12px;

    padding: 7px 10px;

    background: #fff;
    color: #111;

    font-size: 10px;
    font-weight: 800;
  }


  .youtube-card-info {
    padding: 18px;
  }


  .youtube-card-info h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
  }


  .youtube-more {
    margin-top: 30px;
  }


  .youtube-more a {
    color: #111;
    font-weight: 800;
    text-decoration: none;
  }


  /* POPULAR */

  .popular {
    background: #fff;
  }


  .germany {
    background: #fafafa;
  }


  .tour-grid {
    display: grid;
    gap: 22px;
  }


  .tour-grid.five {
    grid-template-columns: repeat(5, 1fr);
  }


  .tour-card {
    display: block;
    width: 100%;
    padding: 0;

    border: 0;

    color: #111;

    text-align: left;
    font-family: inherit;

    background: #f5f5f5;

    overflow: hidden;

    cursor: pointer;

    transition: transform 0.2s ease;
  }


  .tour-card:hover {
    transform: translateY(-4px);
  }


  .thumbnail {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #ddd;
  }


  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

    transition: transform 0.3s ease;
  }


  .tour-card:hover .thumbnail img {
    transform: scale(1.03);
  }


  .play-button {
    position: absolute;
    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    width: 54px;
    height: 54px;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.78);
    color: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 20px;
    padding-left: 4px;
  }


  .tour-info {
    padding: 17px;
  }


  .tour-info span {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }


  .tour-info h3 {
    font-size: 16px;
    line-height: 1.35;
    margin: 9px 0;
  }


  .tour-info small {
    color: #777;
    font-size: 11px;
  }


  /* DESTINATIONS */

  .destination-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }


  .destination {
    min-height: 180px;
    padding: 28px;

    background: #f3f3f3;
    color: #111;

    text-decoration: none;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }


  .destination span {
    font-size: 28px;
    font-weight: 700;
  }


  .destination small {
    font-size: 13px;
  }


  .coming-soon {
    color: #777;
  }


  .empty-message {
    color: #777;
  }


  /* MODAL */


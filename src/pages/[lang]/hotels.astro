---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLang, languages, ui } from '../../i18n/ui';
import { formatHotelDistance } from '../../lib/nearbyHotels';
import { env } from 'cloudflare:workers';

export const prerender = false;

type HotelDirectoryRow = {
  hotel_id: string;
  canonical_name: string;
  city: string | null;
  country: string | null;
  address: string | null;
  distance_meters: number;
  video_id: string;
  video_raw_json: string | null;
  provider: string | null;
  star_rating: number | null;
  guest_rating: number | null;
  review_count: number | null;
  thumbnail_url: string | null;
  booking_url: string | null;
};

type WalkData = {
  title?: string;
  thumbnail?: string;
  city?: string;
  country?: string;
};

type HotelCard = {
  id: string;
  name: string;
  city: string;
  country: string;
  address: string;
  distanceMeters: number;
  videoId: string;
  walkTitle: string;
  walkThumbnail?: string;
  provider?: string;
  starRating?: number;
  guestRating?: number;
  reviewCount?: number;
  thumbnailUrl?: string;
  bookingUrl?: string;
};

const { lang } = Astro.params;
const currentLang = lang && lang in languages ? lang : defaultLang;
const translations = ui as Record<string, Record<string, string>>;
const t = translations[currentLang] || translations.en;
const db = (env as any).oldtowns_db;

if (!db) {
  throw new Error('D1 binding oldtowns_db is not available.');
}

function optionalText(value: string | null | undefined) {
  const cleaned = String(value || '').trim();
  return cleaned || undefined;
}

function optionalNumber(value: number | null) {
  return typeof value === 'number' && Number.isFinite(value)
    ? value
    : undefined;
}

function isMissingHotelSchema(error: unknown) {
  const message = error instanceof Error
    ? error.message
    : String(error || '');

  return /no such table:\s*(hotels|hotel_sources|video_hotels|videos)/i
    .test(message);
}

function parseWalk(rawJson: string | null): WalkData {
  if (!rawJson) {
    return {};
  }

  try {
    return JSON.parse(rawJson) as WalkData;
  } catch {
    return {};
  }
}

let hotelRows: HotelDirectoryRow[] = [];

try {
  const result = await db.prepare(`
    WITH ranked_walks AS (
      SELECT
        vh.hotel_id,
        vh.video_id,
        vh.distance_meters,
        ROW_NUMBER() OVER (
          PARTITION BY vh.hotel_id
          ORDER BY
            vh.distance_meters ASC,
            vh.rank ASC,
            vh.video_id ASC
        ) AS row_number
      FROM video_hotels AS vh
      INNER JOIN videos AS v
        ON v.id = vh.video_id
        AND v.active = 1
      WHERE vh.active = 1
        AND vh.verified = 1
    ),
    ranked_sources AS (
      SELECT
        hs.hotel_id,
        hs.provider,
        hs.star_rating,
        hs.guest_rating,
        hs.review_count,
        hs.thumbnail_url,
        hs.booking_url,
        ROW_NUMBER() OVER (
          PARTITION BY hs.hotel_id
          ORDER BY
            CASE LOWER(COALESCE(hs.provider, ''))
              WHEN 'booking' THEN 0
              WHEN 'expedia' THEN 1
              WHEN 'agoda' THEN 2
              WHEN 'trip' THEN 3
              WHEN 'google' THEN 4
              WHEN 'openstreetmap' THEN 5
              ELSE 6
            END ASC,
            CASE
              WHEN LENGTH(TRIM(COALESCE(hs.booking_url, ''))) > 0 THEN 0
              ELSE 1
            END ASC,
            CASE
              WHEN LENGTH(TRIM(COALESCE(hs.thumbnail_url, ''))) > 0 THEN 0
              ELSE 1
            END ASC,
            hs.updated_at DESC
        ) AS row_number
      FROM hotel_sources AS hs
      WHERE hs.active = 1
        AND (
          hs.content_expires_at IS NULL
          OR hs.content_expires_at > CURRENT_TIMESTAMP
        )
    )
    SELECT
      h.id AS hotel_id,
      h.canonical_name,
      h.city,
      h.country,
      h.address,
      rw.distance_meters,
      rw.video_id,
      v.raw_json AS video_raw_json,
      rs.provider,
      rs.star_rating,
      rs.guest_rating,
      rs.review_count,
      rs.thumbnail_url,
      rs.booking_url
    FROM hotels AS h
    INNER JOIN ranked_walks AS rw
      ON rw.hotel_id = h.id
      AND rw.row_number = 1
    INNER JOIN videos AS v
      ON v.id = rw.video_id
      AND v.active = 1
    LEFT JOIN ranked_sources AS rs
      ON rs.hotel_id = h.id
      AND rs.row_number = 1
    WHERE h.active = 1
    ORDER BY
      CASE WHEN rs.booking_url IS NOT NULL THEN 0 ELSE 1 END ASC,
      CASE WHEN rs.thumbnail_url IS NOT NULL THEN 0 ELSE 1 END ASC,
      CASE WHEN rs.guest_rating IS NOT NULL THEN 0 ELSE 1 END ASC,
      h.country ASC,
      h.city ASC,
      h.canonical_name ASC
    LIMIT 120
  `).all() as { results?: HotelDirectoryRow[] };

  hotelRows = result.results || [];
} catch (error) {
  if (!isMissingHotelSchema(error)) {
    throw error;
  }
}

const hotels: HotelCard[] = hotelRows.map((row) => {
  const walk = parseWalk(row.video_raw_json);

  return {
    id: row.hotel_id,
    name: row.canonical_name,
    city: optionalText(row.city) || optionalText(walk.city) || '',
    country: optionalText(row.country) || optionalText(walk.country) || '',
    address: optionalText(row.address) || '',
    distanceMeters: Number(row.distance_meters) || 0,
    videoId: row.video_id,
    walkTitle: optionalText(walk.title || null) || t['hotels.watchWalk'],
    walkThumbnail: optionalText(walk.thumbnail || null),
    provider: optionalText(row.provider),
    starRating: optionalNumber(row.star_rating),
    guestRating: optionalNumber(row.guest_rating),
    reviewCount: optionalNumber(row.review_count),
    thumbnailUrl: optionalText(row.thumbnail_url),
    bookingUrl: optionalText(row.booking_url)
  };
});

type Destination = {
  key: string;
  city: string;
  country: string;
  count: number;
  thumbnail?: string;
};

const destinationMap = new Map<string, Destination>();

for (const hotel of hotels) {
  const city = hotel.city.trim();
  const country = hotel.country.trim();

  if (!city && !country) {
    continue;
  }

  const key = `${city}|${country}`.toLocaleLowerCase(currentLang);
  const existing = destinationMap.get(key);

  if (existing) {
    existing.count += 1;
    existing.thumbnail ||= hotel.walkThumbnail;
  } else {
    destinationMap.set(key, {
      key,
      city,
      country,
      count: 1,
      thumbnail: hotel.walkThumbnail
    });
  }
}

const destinations = Array.from(destinationMap.values())
  .sort(
    (left, right) =>
      right.count - left.count ||
      left.city.localeCompare(right.city, currentLang)
  )
  .slice(0, 8);

const title = `${t['nav.hotels']} | Old Towns Walks`;
const description = t['hotels.subtitle'];
const shouldIndex = hotels.length > 0;
Astro.response.headers.set(
  'X-Robots-Tag',
  shouldIndex ? 'index, follow' : 'noindex, follow'
);
---

<BaseLayout title={title} description={description}>
  <div
    class:list={['hotel-directory', { rtl: currentLang === 'ar' }]}
    data-hotel-directory
  >
    <aside class="hotel-sidebar" aria-label={t['nav.categories']}>
      <nav class="hotel-sidebar-nav">
        <a href={`/${currentLang}/`} class="sidebar-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 10.8 12 3l9 7.8v9.4a.8.8 0 0 1-.8.8h-5.4v-6.4H9.2V21H3.8a.8.8 0 0 1-.8-.8z" />
          </svg>
          <span>{t['nav.home']}</span>
        </a>

        <a href={`/${currentLang}/map`} class="sidebar-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.2 2.5 3.3 5.5 3.3 9S14.2 18.5 12 21M12 3C9.8 5.5 8.7 8.5 8.7 12S9.8 18.5 12 21" />
          </svg>
          <span>{t['nav.map']}</span>
        </a>

        <a
          href={`/${currentLang}/hotels`}
          class="sidebar-link active"
          aria-current="page"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5" y="3" width="14" height="18" rx="1.5" />
            <path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M10 21v-2.5h4V21" />
          </svg>
          <span>{t['nav.hotels']}</span>
        </a>
      </nav>

      <div class="sidebar-divider"></div>

      <nav class="hotel-sidebar-nav secondary">
        <a href={`/${currentLang}/about`} class="sidebar-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 10.7v5.5M12 7.4h.01" />
          </svg>
          <span>{t['nav.about']}</span>
        </a>

        <a href={`/${currentLang}/privacy`} class="sidebar-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 5.5 5.7v5.6c0 4.2 2.6 7.8 6.5 9.7 3.9-1.9 6.5-5.5 6.5-9.7V5.7z" />
            <path d="m9.2 12 1.8 1.8 3.8-4" />
          </svg>
          <span>{t['nav.privacy']}</span>
        </a>

        <a href={`/${currentLang}/contact`} class="sidebar-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="m4 7 8 6 8-6" />
          </svg>
          <span>{t['nav.contact']}</span>
        </a>
      </nav>
    </aside>

    <div class="hotel-content" role="main">
      <section class="hotel-hero">
        <div class="hero-glow"></div>
        <div class="hero-copy">
          <span class="hero-kicker">OLD TOWNS STAYS</span>
          <h1>{t['hotels.title']}</h1>
          <p>{t['hotels.subtitle']}</p>

          <label class="hotel-search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m16 16 4 4" />
            </svg>
            <span class="sr-only">{t['hotels.searchPlaceholder']}</span>
            <input
              type="search"
              placeholder={t['hotels.searchPlaceholder']}
              autocomplete="off"
              data-hotel-search
            />
          </label>
        </div>

        <div class="hero-mark" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <path d="M28 102V24c0-5 4-9 9-9h46c5 0 9 4 9 9v78" />
            <path d="M18 102h84M43 36h10M67 36h10M43 53h10M67 53h10M43 70h10M67 70h10M51 102V85h18v17" />
          </svg>
        </div>
      </section>

      {destinations.length > 0 && (
        <section class="directory-section destinations-section">
          <div class="section-heading">
            <div>
              <span class="section-kicker">OLD TOWNS</span>
              <h2>{t['hotels.popularDestinations']}</h2>
            </div>
          </div>

          <div class="destination-grid">
            {destinations.map((destination) => (
              <button
                type="button"
                class="destination-card"
                data-destination={destination.city || destination.country}
              >
                {destination.thumbnail ? (
                  <img
                    src={destination.thumbnail}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="destination-placeholder" aria-hidden="true"></span>
                )}
                <span class="destination-shade"></span>
                <span class="destination-copy">
                  <strong>{destination.city || destination.country}</strong>
                  {destination.city && destination.country && (
                    <small>{destination.country}</small>
                  )}
                </span>
                <span class="destination-count">{destination.count}</span>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="directory-section hotel-results-section">
        <div class="section-heading">
          <div>
            <span class="section-kicker">OLD TOWNS STAYS</span>
            <h2>{t['hotels.allHotels']}</h2>
          </div>
          {hotels.length > 0 && (
            <span class="result-total" data-result-total>{hotels.length}</span>
          )}
        </div>

        {hotels.length > 0 ? (
          <>
            <div class="hotel-grid" data-hotel-grid>
              {hotels.map((hotel) => {
                const location = [hotel.city, hotel.country]
                  .filter(Boolean)
                  .join(', ');
                const searchText = [
                  hotel.name,
                  hotel.city,
                  hotel.country,
                  hotel.address,
                  hotel.walkTitle
                ].join(' ').toLocaleLowerCase(currentLang);
                const roundedStars = hotel.starRating
                  ? Math.max(1, Math.min(5, Math.round(hotel.starRating)))
                  : 0;

                return (
                  <article class="hotel-card" data-hotel-card data-search={searchText}>
                    <div class="hotel-media">
                      {hotel.thumbnailUrl ? (
                        <img
                          src={hotel.thumbnailUrl}
                          alt={hotel.name}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="hotel-image-placeholder" aria-hidden="true">
                          <svg viewBox="0 0 90 90">
                            <path d="M22 76V18c0-4 3-7 7-7h32c4 0 7 3 7 7v58" />
                            <path d="M14 76h62M34 29h8M50 29h8M34 42h8M50 42h8M34 55h8M50 55h8M39 76V64h12v12" />
                          </svg>
                        </div>
                      )}

                      {hotel.guestRating !== undefined && (
                        <span class="guest-rating">
                          {new Intl.NumberFormat(currentLang, {
                            minimumFractionDigits: 1,
                            maximumFractionDigits: 1
                          }).format(hotel.guestRating)}
                        </span>
                      )}
                    </div>

                    <div class="hotel-card-body">
                      <div class="hotel-location-row">
                        <span>{location || hotel.address}</span>
                        {hotel.provider && <small>{hotel.provider}</small>}
                      </div>

                      <h3>{hotel.name}</h3>

                      {(roundedStars > 0 || hotel.reviewCount !== undefined) && (
                        <div class="hotel-reputation">
                          {roundedStars > 0 && (
                            <span class="hotel-stars" aria-label={`${roundedStars} stars`}>
                              {'â˜…'.repeat(roundedStars)}
                            </span>
                          )}
                          {hotel.reviewCount !== undefined && (
                            <span>{new Intl.NumberFormat(currentLang).format(hotel.reviewCount)}</span>
                          )}
                        </div>
                      )}

                      <div class="route-distance">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M8 19c-2.7-2.8-4-5.2-4-7.4A4 4 0 0 1 8 7.5a4 4 0 0 1 4 4.1c0 2.2-1.3 4.6-4 7.4Z" />
                          <circle cx="8" cy="11.5" r="1.3" />
                          <path d="M12.5 5.5h5.8M15.6 3l2.7 2.5-2.7 2.5M13.5 15h6M16.5 12.5 20 15l-3.5 2.5" />
                        </svg>
                        <div>
                          <strong>{formatHotelDistance(hotel.distanceMeters, currentLang)}</strong>
                          <span>{t['hotels.fromRoute']}</span>
                        </div>
                      </div>

                      <a
                        href={`/${currentLang}/walks/${hotel.videoId}`}
                        class="walk-link"
                        title={hotel.walkTitle}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="3" y="5" width="18" height="14" rx="2" />
                          <path d="m10 9 5 3-5 3z" />
                        </svg>
                        <span>
                          <small>{t['hotels.nearWalk']}</small>
                          <strong>{hotel.walkTitle}</strong>
                        </span>
                      </a>

                      <div class="hotel-actions">
                        <a
                          href={`/${currentLang}/walks/${hotel.videoId}`}
                          class="secondary-action"
                        >
                          {t['hotels.watchWalk']}
                        </a>

                        {hotel.bookingUrl && (
                          <a
                            href={hotel.bookingUrl}
                            class="primary-action"
                            target="_blank"
                            rel="nofollow sponsored noopener"
                          >
                            {t['hotels.viewHotel']}
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M5 12h13M14 7l5 5-5 5" />
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>

            <div class="empty-search-state" data-empty-search hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m16 16 4 4M8.5 11h5" />
              </svg>
              <p>{t['hotels.noResults']}</p>
            </div>

            <p class="affiliate-disclosure">{t['hotels.disclosure']}</p>
          </>
        ) : (
          <div class="preparing-state">
            <div class="preparing-icon">
              <svg viewBox="0 0 90 90" aria-hidden="true">
                <path d="M22 76V18c0-4 3-7 7-7h32c4 0 7 3 7 7v58" />
                <path d="M14 76h62M34 29h8M50 29h8M34 42h8M50 42h8M34 55h8M50 55h8M39 76V64h12v12" />
              </svg>
            </div>
            <h2>{t['nav.hotels']}</h2>
            <p>{t['hotels.preparing']}</p>
          </div>
        )}
      </section>
    </div>
  </div>

  <script>
    const searchInput = document.querySelector('[data-hotel-search]');
    const hotelCards = Array.from(document.querySelectorAll('[data-hotel-card]'));
    const emptyState = document.querySelector('[data-empty-search]');
    const resultTotal = document.querySelector('[data-result-total]');
    const destinationButtons = document.querySelectorAll('[data-destination]');

    function applyHotelFilter(value: string) {
      const query = String(value || '').trim().toLocaleLowerCase();
      let visibleCount = 0;

      for (const card of hotelCards) {
        const searchText = card.getAttribute('data-search') || '';
        const isVisible = !query || searchText.includes(query);
        card.toggleAttribute('hidden', !isVisible);

        if (isVisible) {
          visibleCount += 1;
        }
      }

      if (emptyState) {
        emptyState.toggleAttribute('hidden', visibleCount !== 0);
      }

      if (resultTotal) {
        resultTotal.textContent = String(visibleCount);
      }
    }

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', () => {
        applyHotelFilter(searchInput.value);
      });
    }

    for (const button of destinationButtons) {
      button.addEventListener('click', () => {
        if (!(searchInput instanceof HTMLInputElement)) {
          return;
        }

        searchInput.value = button.getAttribute('data-destination') || '';
        applyHotelFilter(searchInput.value);
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        searchInput.focus({ preventScroll: true });
      });
    }
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #0d0f12;
  }

  .hotel-directory {
    min-height: calc(100vh - 56px);
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    background: #0d0f12;
    color: #f8fafc;
  }

  .hotel-directory.rtl {
    direction: rtl;
  }

  .hotel-sidebar {
    position: sticky;
    top: 56px;
    height: calc(100vh - 56px);
    align-self: start;
    padding: 20px 12px;
    background: #0d0d0e;
    border-inline-end: 1px solid #25272a;
  }

  .hotel-sidebar-nav {
    display: grid;
    gap: 5px;
  }

  .hotel-sidebar-nav.secondary {
    margin-top: 18px;
  }

  .sidebar-link {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 13px;
    border-radius: 10px;
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 600;
    transition: color 160ms ease, background 160ms ease;
  }

  .sidebar-link:hover {
    color: #ffffff;
    background: #1a1b1d;
  }

  .sidebar-link.active {
    color: #ffffff;
    background: #292a2d;
  }

  .sidebar-link svg {
    width: 21px;
    height: 21px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sidebar-link:first-child svg path:first-child {
    fill: none;
  }

  .sidebar-divider {
    height: 1px;
    margin: 20px 0 0;
    background: #25272a;
  }

  .hotel-content {
    width: 100%;
    max-width: 1680px;
    margin: 0 auto;
    padding: 28px 28px 56px;
    overflow: hidden;
  }

  .hotel-hero {
    min-height: 330px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 48px clamp(28px, 5vw, 76px);
    border: 1px solid #2b2e33;
    border-radius: 22px;
    background:
      radial-gradient(circle at 82% 18%, rgba(245, 183, 0, .18), transparent 33%),
      linear-gradient(130deg, #17191d 0%, #111318 58%, #18150b 100%);
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49%, rgba(255, 255, 255, .025) 50%, transparent 51%),
      linear-gradient(0deg, transparent 49%, rgba(255, 255, 255, .02) 50%, transparent 51%);
    background-size: 64px 64px;
    mask-image: linear-gradient(to left, #000, transparent 82%);
    pointer-events: none;
  }

  .hero-copy {
    width: min(760px, 72%);
    position: relative;
    z-index: 2;
  }

  .hero-kicker,
  .section-kicker {
    display: block;
    margin-bottom: 10px;
    color: #f5b700;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.7px;
  }

  .hotel-hero h1 {
    max-width: 760px;
    font-size: clamp(34px, 4.1vw, 64px);
    line-height: 1.02;
    letter-spacing: -2.5px;
  }

  .hotel-hero p {
    max-width: 690px;
    margin-top: 18px;
    color: #b8c0cc;
    font-size: 17px;
    line-height: 1.65;
  }

  .hotel-search {
    width: min(680px, 100%);
    height: 54px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding: 0 18px;
    border: 1px solid #343840;
    border-radius: 12px;
    background: rgba(8, 10, 13, .78);
    box-shadow: 0 18px 50px rgba(0, 0, 0, .28);
  }

  .hotel-search:focus-within {
    border-color: rgba(245, 183, 0, .8);
    box-shadow: 0 0 0 3px rgba(245, 183, 0, .12);
  }

  .hotel-search svg {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    fill: none;
    stroke: #f5b700;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .hotel-search input {
    width: 100%;
    border: 0;
    outline: 0;
    color: #ffffff;
    background: transparent;
    font: inherit;
    font-size: 15px;
  }


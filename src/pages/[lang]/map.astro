---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, defaultLang } from '../../i18n/ui';
import videos from '../../data/videos.json';

interface Video {
  id: string;
  title: string;
  description?: string;
  thumbnail?: string;
  category?: string;
  channel?: string;
  channelTitle?: string;
  badge?: string;
  publishedAt?: string;
  city?: string;
  country?: string;
}

interface MapPoint {
  city: string;
  country: string;
  lat: number;
  lng: number;
  videoCount: number;
  categories: string[];
  thumbnail: string;
  cityUrl: string;
  countryUrl: string;
}

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;

const currentLang =
  lang && lang in languages
    ? lang
    : defaultLang;

function createSlug(value: string) {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function normalizeKey(value: string) {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}


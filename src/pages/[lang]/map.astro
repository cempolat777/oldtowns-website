function label(key: string) {
  return labels[key]?.[currentLang] || labels[key]?.en || key;
}

const allVideos = videos as Video[];

const cityGroups = new Map<
  string,
  {
    city: string;
    country: string;
    videos: Video[];
  }
>();

for (const video of allVideos) {
  if (!video.city) continue;

  const key = `${normalizeKey(video.city)}|${normalizeKey(video.country || '')}`;

  if (!cityGroups.has(key)) {
    cityGroups.set(key, {
      city: video.city,
      country: video.country || '',
      videos: []
    });
  }

  cityGroups.get(key)?.videos.push(video);
}

const mapPoints: MapPoint[] = [];
const unmappedCities: Array<{
  city: string;
  country: string;
  videoCount: number;
  cityUrl: string;
}> = [];

for (const group of cityGroups.values()) {
  const cityKey = normalizeKey(group.city);
  const coordinates = coordinateIndex[cityKey];

  const heroVideo =
    group.videos.find((video) => video.thumbnail) ||
    group.videos[0];

  const thumbnail =
    heroVideo?.thumbnail ||
    (heroVideo
      ? `https://i.ytimg.com/vi/${heroVideo.id}/hqdefault.jpg`
      : '');

  const cityUrl =
    `/${currentLang}/cities/${createSlug(group.city)}`;

  const countryUrl =
    group.country
      ? `/${currentLang}/countries/${createSlug(group.country)}`
      : '';

  const categories = Array.from(
    new Set(
      group.videos
        .map((video) => video.category)
        .filter((category): category is string => Boolean(category))
    )
  );

  if (coordinates) {
    mapPoints.push({
      city: group.city,
      country: group.country,
      lat: coordinates[0],
      lng: coordinates[1],
      videoCount: group.videos.length,
      categories,
      thumbnail,
      cityUrl,
      countryUrl
    });
  } else {
    unmappedCities.push({
      city: group.city,
      country: group.country,
      videoCount: group.videos.length,
      cityUrl
    });
  }
}

mapPoints.sort(
  (a, b) =>
    b.videoCount - a.videoCount ||
    a.city.localeCompare(b.city)
);

unmappedCities.sort(
  (a, b) =>
    b.videoCount - a.videoCount ||
    a.city.localeCompare(b.city)
);

const countries = Array.from(
  new Set(
    mapPoints
      .map((point) => point.country)
      .filter(Boolean)
  )
).sort((a, b) => a.localeCompare(b));

const countryCount = new Set(
  allVideos
    .map((video) => video.country)
    .filter(Boolean)
).size;

const cityCount = cityGroups.size;
const videoCount = allVideos.length;

const pageTitle =
  `${label('title')} | Old Towns Walks`;

const pageDescription =
  label('intro');

const pageUrl = Astro.url.href;

const mapSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {

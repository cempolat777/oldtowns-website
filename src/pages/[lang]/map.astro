      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: currentLang,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Old Towns Walks',
        url: Astro.url.origin
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: mapPoints.map((point, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: point.city,
          url: new URL(point.cityUrl, Astro.url.origin).href
        }))
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: label('home'),
          item: new URL(`/${currentLang}/`, Astro.url.origin).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: label('title'),
          item: pageUrl
        }
      ]
    }
  ]
};

const clientLabels = {
  openCity: label('openCity'),
  videos: label('videos'),
  allCountries: label('allCountries')
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class="map-page">
    <div class="map-shell">

      <nav
        class="breadcrumbs"
        aria-label="Breadcrumb"
      >
        <a href={`/${currentLang}/`}>
          {label('home')}
        </a>

        <span>/</span>

        <span aria-current="page">
          {label('title')}
        </span>
      </nav>

      <section class="map-hero">
        <div>
          <span class="eyebrow">
            Old Towns Walks
          </span>

          <h1>{label('title')}</h1>

          <p>{label('subtitle')}</p>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <strong>{cityCount}</strong>
            <span>{label('cities')}</span>
          </div>

          <div class="stat">
            <strong>{countryCount}</strong>
            <span>{label('countries')}</span>
          </div>

          <div class="stat">
            <strong>{videoCount}</strong>
            <span>{label('videos')}</span>
          </div>
        </div>
      </section>

      <section class="intro-card">
        <p>{label('intro')}</p>
      </section>

      <section class="map-layout">

        <div class="map-panel">
          <div class="map-toolbar">

            <div class="search-box">
              <span aria-hidden="true">⌕</span>

              <input
                id="mapSearch"
                type="search"
                placeholder={label('search')}
                autocomplete="off"
              />
            </div>

            <select
              id="countryFilter"
              aria-label={label('countries')}
            >
              <option value="">
                {label('allCountries')}
              </option>

              {countries.map((country) => (
                <option value={country}>
                  {country}
                </option>
              ))}
            </select>

          </div>

          <div
            id="worldMap"
            class="world-map"
            aria-label={label('title')}
          ></div>

          <div class="map-footer">
            <span>
              {mapPoints.length} {label('destinations')}
            </span>

            <span>
              {label('mapNote')}
            </span>
          </div>
        </div>

        <aside class="destination-panel">
          <div class="panel-heading">
            <div>
              <span class="section-kicker">
                {label('explore')}
              </span>

              <h2>{label('destinations')}</h2>
            </div>

            <span
              id="visibleDestinationCount"
              class="destination-count"
            >
              {mapPoints.length}
            </span>
          </div>

          <div
            id="destinationList"
            class="destination-list"
          >
            {mapPoints.map((point) => (
              <a
                href={point.cityUrl}
                class="destination-card"
                data-destination-card
                data-city={point.city.toLowerCase()}
                data-country={point.country.toLowerCase()}
              >
                <div class="destination-thumb">
                  {point.thumbnail ? (
                    <img
                      src={point.thumbnail}
                      alt={point.city}
                      loading="lazy"
                    />
                  ) : (
                    <div class="destination-placeholder">
                      {point.city.slice(0, 1)}
                    </div>
                  )}
                </div>

                <div class="destination-info">
                  <h3>{point.city}</h3>

                  {point.country && (
                    <p>{point.country}</p>
                  )}

                  <span>
                    {point.videoCount} {label('videos')}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </aside>

      </section>

      {unmappedCities.length > 0 && (
        <section class="more-destinations">
          <div class="section-heading">
            <span class="section-kicker">
              {label('destinations')}
            </span>

            <h2>{label('cities')}</h2>
          </div>

          <div class="more-grid">
            {unmappedCities.map((item) => (
              <a
                href={item.cityUrl}
                class="more-card"
              >
                <div>
                  <strong>{item.city}</strong>

                  {item.country && (
                    <span>{item.country}</span>
                  )}
                </div>

                <em>
                  {item.videoCount} {label('videos')}
                </em>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(mapSchema)}
  />

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    crossorigin=""
  ></script>

  <script
    is:inline
    define:vars={{
      mapPoints,
      currentLang,
      clientLabels
    }}
  >
    const mapElement = document.getElementById('worldMap');

    if (mapElement && window.L) {
      const map = L.map(mapElement, {
        worldCopyJump: true,
        minZoom: 2,
        zoomControl: true
      }).setView([24, 8], 2);

      L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
          maxZoom: 19,
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }
      ).addTo(map);

      const markerLayer = L.layerGroup().addTo(map);
      const markerRecords = [];

      const escapeHtml = (value) =>
        String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      const createPopup = (point) => {
        const city = escapeHtml(point.city);
        const country = escapeHtml(point.country);
        const cityUrl = escapeHtml(point.cityUrl);
        const countryUrl = escapeHtml(point.countryUrl);
        const thumbnail = escapeHtml(point.thumbnail);

        const image = thumbnail
          ? `<img src="${thumbnail}" alt="${city}" class="map-popup-image" />`
          : '';

        const countryLine = country
          ? countryUrl
            ? `<a href="${countryUrl}" class="map-popup-country">${country}</a>`
            : `<span class="map-popup-country">${country}</span>`
          : '';

        return `
          <div class="map-popup-card">
            ${image}
            <div class="map-popup-body">
              <strong>${city}</strong>
              ${countryLine}
              <span>${point.videoCount} ${escapeHtml(clientLabels.videos)}</span>
              <a href="${cityUrl}" class="map-popup-button">
                ${escapeHtml(clientLabels.openCity)} →
              </a>
            </div>
          </div>
        `;
      };

      mapPoints.forEach((point) => {
        const radius = Math.min(
          13,
          5 + Math.log2(Math.max(1, point.videoCount)) * 1.7
        );

        const marker = L.circleMarker(
          [point.lat, point.lng],
          {
            radius,
            weight: 2,
            opacity: 1,
            fillOpacity: 0.78
          }
        );

        marker.bindPopup(
          createPopup(point),
          {
            maxWidth: 280,
            minWidth: 220
          }
        );

        marker.on('click', () => {
          map.flyTo(
            [point.lat, point.lng],
            Math.max(map.getZoom(), 5),
            {
              duration: 0.7
            }
          );
        });

        marker.addTo(markerLayer);

        markerRecords.push({
          marker,
          point
        });
      });

      const searchInput =
        document.getElementById('mapSearch');

      const countrySelect =
        document.getElementById('countryFilter');

      const destinationCards =
        Array.from(
          document.querySelectorAll(
            '[data-destination-card]'
          )
        );

      const visibleCount =
        document.getElementById(
          'visibleDestinationCount'
        );

      const updateFilters = () => {
        const searchTerm =
          String(searchInput?.value || '')
            .toLowerCase()
            .trim();

        const selectedCountry =
          String(countrySelect?.value || '')
            .toLowerCase()
            .trim();

        markerLayer.clearLayers();

        let shown = 0;
        const visibleMarkers = [];

        markerRecords.forEach((record) => {
          const city =
            String(record.point.city || '')
              .toLowerCase();

          const country =
            String(record.point.country || '')
              .toLowerCase();

          const matchesSearch =
            !searchTerm ||
            city.includes(searchTerm) ||
            country.includes(searchTerm);

          const matchesCountry =
            !selectedCountry ||
            country === selectedCountry;

          if (matchesSearch && matchesCountry) {
            record.marker.addTo(markerLayer);
            visibleMarkers.push(record.marker);
            shown += 1;
          }
        });

        destinationCards.forEach((card) => {
          const city =
            String(card.dataset.city || '');

          const country =
            String(card.dataset.country || '');

          const matchesSearch =
            !searchTerm ||
            city.includes(searchTerm) ||
            country.includes(searchTerm);

          const matchesCountry =
            !selectedCountry ||
            country === selectedCountry;

          card.classList.toggle(
            'is-hidden',
            !(matchesSearch && matchesCountry)
          );
        });

        if (visibleCount) {
          visibleCount.textContent =
            String(shown);
        }

        if (visibleMarkers.length === 1) {
          const marker = visibleMarkers[0];
          map.flyTo(
            marker.getLatLng(),
            6,
            {
              duration: 0.7
            }
          );
        } else if (visibleMarkers.length > 1) {
          const group =
            L.featureGroup(visibleMarkers);

          map.fitBounds(
            group.getBounds().pad(0.18),
            {
              maxZoom: 5,
              animate: true
            }
          );
        }
      };

      searchInput?.addEventListener(
        'input',
        updateFilters
      );

      countrySelect?.addEventListener(
        'change',
        updateFilters
      );

      destinationCards.forEach((card) => {
        card.addEventListener(
          'mouseenter',
          () => {
            const city =
              String(card.dataset.city || '');

            const country =
              String(card.dataset.country || '');

            const record =
              markerRecords.find((item) => {
                return (
                  String(item.point.city || '')
                    .toLowerCase() === city &&
                  String(item.point.country || '')
                    .toLowerCase() === country
                );
              });

            if (record) {
              record.marker.openPopup();
            }
          }
        );
      });

      window.addEventListener(
        'resize',
        () => {
          map.invalidateSize();
        }
      );
    }
  </script>
</BaseLayout>


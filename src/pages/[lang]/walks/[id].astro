---

import BaseLayout from '../../../layouts/BaseLayout.astro';

import { languages, defaultLang } from '../../../i18n/ui';

import videos from '../../../data/videos.json';

import {

  getVideoCardTitle,

  getVideoSchema,

  getCategoryName

} from '../../../lib/videoSeo';

interface Video {

  id: string;

  title: string;

  description?: string;

  thumbnail?: string;

  category?: string;

  channel?: string;

  channelTitle?: string;

  channelId?: string;

  badge?: string;

  publishedAt?: string;

  city?: string;

  country?: string;

}

export async function getStaticPaths() {

  const paths: Array<{

    params: { lang: string; id: string };

    props: { video: Video };

  }> = [];

  Object.keys(languages).forEach((lang) => {

    (videos as unknown as Video[]).forEach((video) => {

      paths.push({

        params: {

          lang,

          id: video.id

        },

        props: {

          video

        }

      });

    });

  });

  return paths;

}

const { lang } = Astro.params;

const video = Astro.props.video as Video;

const currentLang =

  lang && lang in languages

    ? lang

    : defaultLang;

const seoTitle =

  getVideoCardTitle(video, currentLang);

const videoSchema =

  getVideoSchema(video, currentLang);

const categoryLabel =

  getCategoryName(video.category, currentLang);

const locationLabel =

  seoTitle.includes('|')

    ? seoTitle.split('|')[0].trim()

    : video.city || video.country || '';

const sourceName =

  video.channelTitle ||

  video.channel ||

  'YouTube';

function createSlug(value: string) {

  return value

    .normalize('NFD')

    .replace(/[\u0300-\u036f]/g, '')

    .toLowerCase()

    .replace(/[^a-z0-9]+/g, '-')

    .replace(/^-+|-+$/g, '');

}

const cityUrl = video.city

  ? `/${currentLang}/cities/${createSlug(video.city)}`

  : null;

const countryUrl = video.country

  ? `/${currentLang}/countries/${createSlug(video.country)}`

  : null;


const relatedVideos =

  (videos as unknown as Video[])

    .filter((item) =>

      item.id !== video.id &&

      item.category === video.category

    )

    .slice(0, 30);


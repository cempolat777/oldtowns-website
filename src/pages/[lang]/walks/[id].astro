const label = (key: string) =>

  labels[key]?.[currentLang] ||

  labels[key]?.en ||

  key;

const descriptions: Record<string, string[]> = {

  tr: [

    `${locationLabel} bölgesini bu etkileyici 4K ${categoryLabel.toLocaleLowerCase('tr-TR')} deneyimiyle keşfedin. Tur, sokak atmosferini, kentsel ortamı ve günlük yaşamı gerçekçi bir bakış açısıyla sergiliyor.`,

    `Old Towns Walks bu içeriği bölgeyi sanal olarak keşfetmek, seyahat fikirleri edinmek ve benzer videolar bulmak isteyen ziyaretçiler için düzenler. Video kaynağı: ${sourceName}.`

  ],

  en: [

    `Explore ${locationLabel} through this immersive 4K ${categoryLabel.toLowerCase()} experience. The video offers a street-level view of the local atmosphere, urban surroundings and everyday life.`,

    `Old Towns Walks organizes this content for viewers who want to explore the area virtually, discover travel ideas and find related experiences. Video source: ${sourceName}.`

  ],

  de: [

    `Entdecke ${locationLabel} mit diesem immersiven 4K-Erlebnis. Die Tour zeigt die Straßenatmosphäre, die urbane Umgebung und das tägliche Leben aus einer realistischen Perspektive.`,

    `Old Towns Walks ordnet dieses Video für Besucher ein, die die Region virtuell erkunden, Reiseideen entdecken und ähnliche Videos finden möchten. Videoquelle: ${sourceName}.`

  ],


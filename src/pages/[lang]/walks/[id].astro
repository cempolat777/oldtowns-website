---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, ui, defaultLang } from '../../../i18n/ui';
import videos from '../../../data/videos.json';
import { getVideoCardTitle, getVideoSeoDescription, getVideoSchema, getCategoryName } from '../../../lib/videoSeo';

interface Video {
  id: string;
  title: string;
  description?: string;
  thumbnail?: string;
  category?: string;
  channel?: string;
  channelTitle?: string;
  channelId?: string;
  badge?: string;
  publishedAt?: string;
  city?: string;
  country?: string;
}

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; id: string }; props: { video: Video } }> = [];

  Object.keys(languages).forEach((lang) => {
    (videos as unknown as Video[]).forEach((video) => {
      paths.push({
        params: { lang, id: video.id },
        props: { video },
      });
    });
  });

  return paths;
}

const { lang } = Astro.params;
const video = Astro.props.video as Video;

const currentLang = (lang && lang in languages ? lang : defaultLang) as keyof typeof ui;

const seoTitle = getVideoCardTitle(video, currentLang);
const seoDescription = getVideoSeoDescription(video, currentLang);
const videoSchema = getVideoSchema(video, currentLang);
const categoryLabel = getCategoryName(video.category, currentLang);

const labels: Record<string, Record<string, string>> = {
  back: {
    en: 'Back to Home', tr: 'Ana Sayfaya Dön', de: 'Zur Startseite', es: 'Volver al Inicio',
    it: 'Torna alla Home', fr: "Retour à l'accueil", ja: 'ホームに戻る', pt: 'Voltar ao Início',
    ru: 'На главную', zh: '返回首页', ko: '홈으로', ar: 'العودة للرئيسية', hi: 'होम पर वापस',
    nl: 'Terug naar Home', pl: 'Powrót na stronę główną', sv: 'Till startsidan',
    id: 'Kembali ke Beranda', vi: 'Về Trang Chủ'
  },
  about: {
    en: 'About this walk', tr: 'Bu yürüyüş hakkında', de: 'Über diesen Rundgang', es: 'Sobre este recorrido',
    it: 'Informazioni su questo percorso', fr: 'À propos de cette balade', ja: 'この散策について',
    pt: 'Sobre este passeio', ru: 'Об этой прогулке', zh: '关于这次步行', ko: '이 도보 여행 소개',
    ar: 'حول هذه الجولة', hi: 'इस वॉक के बारे में', nl: 'Over deze wandeling',
    pl: 'O tym spacerze', sv: 'Om denna promenad', id: 'Tentang perjalanan ini', vi: 'Về chuyến đi bộ này'
  },
  city: {
    en: 'City', tr: 'Şehir', de: 'Stadt', es: 'Ciudad', it: 'Città', fr: 'Ville', ja: '都市',
    pt: 'Cidade', ru: 'Город', zh: '城市', ko: '도시', ar: 'المدينة', hi: 'शहर',
    nl: 'Stad', pl: 'Miasto', sv: 'Stad', id: 'Kota', vi: 'Thành phố'
  },
  country: {
    en: 'Country', tr: 'Ülke', de: 'Land', es: 'País', it: 'Paese', fr: 'Pays', ja: '国',
    pt: 'País', ru: 'Страна', zh: '国家', ko: '국가', ar: 'الدولة', hi: 'देश',
    nl: 'Land', pl: 'Kraj', sv: 'Land', id: 'Negara', vi: 'Quốc gia'
  },
  category: {
    en: 'Category', tr: 'Kategori', de: 'Kategorie', es: 'Categoría', it: 'Categoria', fr: 'Catégorie',
    ja: 'カテゴリー', pt: 'Categoria', ru: 'Категория', zh: '分类', ko: '카테고리', ar: 'الفئة',
    hi: 'श्रेणी', nl: 'Categorie', pl: 'Kategoria', sv: 'Kategori', id: 'Kategori', vi: 'Danh mục'
  },
  quality: {
    en: 'Quality', tr: 'Kalite', de: 'Qualität', es: 'Calidad', it: 'Qualità', fr: 'Qualité',
    ja: '画質', pt: 'Qualidade', ru: 'Качество', zh: '画质', ko: '화질', ar: 'الجودة',
    hi: 'गुणवत्ता', nl: 'Kwaliteit', pl: 'Jakość', sv: 'Kvalitet', id: 'Kualitas', vi: 'Chất lượng'
  },
  channel: {
    en: 'Source channel', tr: 'Kaynak kanal', de: 'Quellkanal', es: 'Canal de origen', it: 'Canale sorgente',
    fr: 'Chaîne source', ja: '配信元チャンネル', pt: 'Canal de origem', ru: 'Канал-источник',
    zh: '来源频道', ko: '원본 채널', ar: 'القناة المصدر', hi: 'स्रोत चैनल', nl: 'Bronkanaal',
    pl: 'Kanał źródłowy', sv: 'Källkanal', id: 'Kanal sumber', vi: 'Kênh nguồn'
  }
};

const l = currentLang as string;
const label = (key: keyof typeof labels) => labels[key]?.[l] || labels[key]?.en || key;
---

<BaseLayout title={seoTitle}>
  <main class="walk-page">
    <div class="walk-shell">
      <a href={`/${currentLang}/`} class="back-link">← {label('back')}</a>

      <article class="walk-card">
        <header class="walk-header">
          <h1>{seoTitle}</h1>
        </header>

        <div class="video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.id}`}
            title={seoTitle}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <section class="meta-row" aria-label="Video information">
          {video.city && (
            <div class="meta-item">
              <span class="meta-label">{label('city')}</span>
              <span class="meta-value">{video.city}</span>
            </div>
          )}

          {video.country && (
            <div class="meta-item">
              <span class="meta-label">{label('country')}</span>
              <span class="meta-value">{video.country}</span>
            </div>
          )}

          {video.category && (
            <div class="meta-item">
              <span class="meta-label">{label('category')}</span>
              <span class="meta-value">{categoryLabel}</span>
            </div>
          )}

          {video.badge && (
            <div class="meta-item">
              <span class="meta-label">{label('quality')}</span>
              <span class="meta-value">{video.badge}</span>
            </div>
          )}

          {(video.channelTitle || video.channel) && (
            <div class="meta-item meta-channel">
              <span class="meta-label">{label('channel')}</span>
              <span class="meta-value">{video.channelTitle || video.channel}</span>
            </div>
          )}
        </section>

        <section class="description-card">
          <h2>{label('about')}</h2>
          <p>{seoDescription}</p>
        </section>
      </article>
    </div>
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(videoSchema)}
  />
</BaseLayout>

<style>
  .walk-page {
    min-height: calc(100vh - 70px);
    background: #0d1117;
    color: #f5f7fa;
    padding: 84px 24px 64px;
  }

  .walk-shell {
    width: min(1380px, 100%);
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 18px;
    color: #aeb8c6;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .back-link:hover {
    color: #ffffff;
  }

  .walk-header {
    margin-bottom: 18px;
  }

  .walk-header h1 {
    margin: 0;
    max-width: 1000px;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #242b35;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid #252d38;
    background: #151b23;
    border-radius: 10px;
  }

  .meta-label {
    color: #7f8a99;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta-value {
    color: #e9edf2;
    font-size: 13px;
    font-weight: 600;
  }

  .meta-channel {
    margin-left: auto;
  }

  .description-card {
    margin-top: 22px;
    padding: 24px;
    background: #121821;
    border: 1px solid #252d38;
    border-radius: 14px;
  }

  .description-card h2 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 20px;
  }

  .description-card p {
    margin: 0;
    color: #c5ccd6;
    font-size: 15px;
    line-height: 1.75;
  }

  @media (max-width: 760px) {
    .walk-page {
      padding: 74px 12px 44px;
    }

    .walk-header h1 {
      font-size: 25px;
      line-height: 1.2;
    }

    .video-frame {
      border-radius: 10px;
    }

    .meta-row {
      gap: 8px;
      margin-top: 14px;
    }

    .meta-item {
      width: 100%;
      justify-content: space-between;
    }

    .meta-channel {
      margin-left: 0;
    }

    .description-card {
      padding: 18px;
      margin-top: 16px;
    }

    .description-card p {
      font-size: 14px;
      line-height: 1.7;
    }
  }
</style>

import videos from '../../data/videos.json';

interface Video {
  id: string;
  title: string;
  thumbnail?: string;
  category?: string;
  city?: string;
  country?: string;
  active?: boolean | number;
}

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;

const currentLang =
  lang && lang in languages
    ? lang
    : defaultLang;


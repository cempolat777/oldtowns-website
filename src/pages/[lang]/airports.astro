};

function label(key: string) {
  return labels[key]?.[currentLang] || labels[key]?.en || key;
}

function normalize(value: string) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

const allVideos = videos as Video[];

const airportVideos = allVideos
  .filter((video) => {
    if (video.active === false || video.active === 0) return false;

    const category = normalize(video.category || '');
    const title = normalize(video.title || '');

    return (
      category.includes('airport') ||
      title.includes('airport')
    );
  })
  .map((video) => ({
    id: video.id,
    title: video.title,
    thumbnail:
      video.thumbnail ||
      `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
    city: video.city || '',
    country: video.country || '',
    cityKey: normalize(video.city || ''),
    countryKey: normalize(video.country || ''),
    titleKey: normalize(video.title || ''),
    url: `/${currentLang}/walks/${video.id}`
  }));

function mixedVideos<T extends { countryKey: string; cityKey: string }>(
  items: T[]
) {
  const buckets = new Map<string, T[]>();

  for (const item of items) {
    const key =
      item.countryKey ||
      item.cityKey ||
      'other';

    if (!buckets.has(key)) {
      buckets.set(key, []);
    }

    buckets.get(key)?.push(item);
  }

  const queues = Array.from(buckets.values());
  const result: T[] = [];
  let previousKey = '';

  while (queues.some((queue) => queue.length > 0)) {
    queues.sort(
      (a, b) =>
        b.length - a.length
    );

    let chosenIndex = queues.findIndex((queue) => {
      const first = queue[0];
      if (!first) return false;

      const key =
        first.countryKey ||
        first.cityKey ||
        'other';

      return key !== previousKey;
    });

    if (chosenIndex < 0) {
      chosenIndex = queues.findIndex(
        (queue) => queue.length > 0
      );
    }

    const queue = queues[chosenIndex];
    const item = queue?.shift();

    if (!item) break;

    result.push(item);
    previousKey =
      item.countryKey ||
      item.cityKey ||
      'other';
  }

  return result;
}

const mixedAirportVideos =
  mixedVideos(airportVideos);

const pageTitle =
  `${label('title')} | Old Towns Walks`;

const pageDescription =
  label('subtitle');

const pageUrl =
  Astro.url.href;

const airportMapSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#airport-map`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: currentLang,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Old Towns Walks',
        url: Astro.url.origin
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: label('home'),
          item: new URL(
            `/${currentLang}/`,
            Astro.url.origin
          ).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: label('title'),
          item: pageUrl
        }
      ]
    }
  ]
};

const clientLabels = {
  loading: label('loading'),
  airports: label('airports'),
  countries: label('countries'),
  videos: label('videos')
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class="airport-page">
    <div class="airport-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={`/${currentLang}/`}>
          {label('home')}
        </a>
        <span>/</span>
        <span aria-current="page">
          {label('title')}
        </span>
      </nav>

      <section class="airport-hero">
        <div>
          <span class="eyebrow">
            Old Towns Walks
          </span>
          <h1>
            <span aria-hidden="true">✈</span>
            {label('title')}
          </h1>
          <p>{label('subtitle')}</p>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <strong id="airportCount">—</strong>
            <span>{label('airports')}</span>
          </div>
          <div class="stat">
            <strong id="countryCount">—</strong>
            <span>{label('countries')}</span>
          </div>
          <div class="stat">
            <strong>{airportVideos.length}</strong>
            <span>{label('videos')}</span>
          </div>
        </div>
      </section>

      <section class="map-layout">
        <div class="map-panel">
          <div class="map-toolbar">
            <div class="search-box">
              <span aria-hidden="true">⌕</span>
              <input
                id="airportSearch"
                type="search"
                placeholder={label('search')}
                autocomplete="off"
              />
            </div>

            <select
              id="airportCountryFilter"
              aria-label={label('countries')}
            >
              <option value="">
                {label('allCountries')}
              </option>
            </select>
          </div>

          <div class="map-stage">
            <div
              id="airportMap"
              class="airport-map"
              aria-label={label('title')}
            ></div>

            <div
              id="airportLoading"
              class="airport-loading"
              role="status"
            >
              <span class="airport-loading-plane" aria-hidden="true">
                ✈
              </span>
              <span>{label('loading')}</span>
            </div>
          </div>

          <div class="map-footer">
            <span id="visibleAirportCount">
              — {label('airports')}
            </span>
            <span>
              OurAirports · Esri Satellite
            </span>
          </div>
        </div>

        <aside class="destination-panel">
          <div class="panel-heading">
            <div>
              <span class="section-kicker">
                {label('explore')}
              </span>
              <h2>{label('airportWalks')}</h2>
            </div>

            <span class="destination-count">
              {airportVideos.length}
            </span>
          </div>

          <div
            id="airportVideoList"
            class="destination-list"
          >
            {mixedAirportVideos.map((video) => (
              <a
                href={video.url}
                class="destination-card"
                data-airport-video
                data-video-id={video.id}
                data-city={video.cityKey}
                data-country={video.countryKey}
              >
                <div class="destination-thumb">
                  <img
                    src={video.thumbnail}
                    alt={video.title}
                    loading="lazy"
                  />
                </div>

                <div class="destination-info">
                  <h3>{video.title}</h3>

                  {(video.city || video.country) && (
                    <p>
                      {[video.city, video.country]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                  )}

                  <span>
                    {label('airportWalks')}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </aside>
      </section>
    </div>
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(airportMapSchema)}
  />

  <!--
    FIX: these two library scripts must be `is:inline`.

    Without `is:inline`, Astro hoists/processes external <script src="..."> tags
    and re-emits them as `type="module"`. Module scripts are always deferred
    (they only run after the whole document has finished parsing), while the
    big `is:inline` script below them is a classic script that runs the
    instant the parser reaches it. That meant the map-init script was running
    BEFORE Leaflet / Leaflet.markercluster had executed, so `window.L` and
    `L.markerClusterGroup` were undefined, the `if (mapElement && window.L &&
    L.markerClusterGroup)` guard silently evaluated to false, and none of the
    map/fetch/counter/overlay logic ever ran.

    Adding `is:inline` here keeps all three scripts as classic, blocking
    scripts that execute synchronously in document order (Leaflet ->
    markercluster plugin -> init script), so `window.L` is guaranteed to be
    ready when the init script needs it.
  -->
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    crossorigin=""
  ></script>

  <script
    is:inline
    src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
  ></script>

  <script
    is:inline
    define:vars={{
      airportVideos,
      clientLabels
    }}
  >
    const AIRPORT_DATA_URL =
      '/data/airports.min.json';

    const mapElement =
      document.getElementById('airportMap');

    const loadingElement =
      document.getElementById('airportLoading');

    const searchInput =
      document.getElementById('airportSearch');

    const countrySelect =
      document.getElementById('airportCountryFilter');

    const airportCountElement =
      document.getElementById('airportCount');

    const countryCountElement =
      document.getElementById('countryCount');

    const visibleAirportCount =
      document.getElementById('visibleAirportCount');

    const airportVideoCards =
      Array.from(
        document.querySelectorAll(
          '[data-airport-video]'
        )
      );

    const normalizeText = (value) =>
      String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    const canonicalCountryKey = (value) => {
      const key = normalizeText(value);

      const aliases = {
        turkiye: 'turkey',
        turkey: 'turkey',
        'united states of america': 'united states',
        usa: 'united states',
        'u s a': 'united states',
        uk: 'united kingdom',
        'u k': 'united kingdom',
        'republic of korea': 'south korea',
        korea: 'south korea',
        'viet nam': 'vietnam',
        uae: 'united arab emirates',
        'czech republic': 'czechia'
      };

      return aliases[key] || key;
    };

    const escapeHtml = (value) =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    const debounce = (fn, wait) => {
      let timeoutId;

      return (...args) => {
        window.clearTimeout(timeoutId);

        timeoutId = window.setTimeout(
          () => fn(...args),
          wait
        );
      };
    };

    const countryDisplayNames =
      typeof Intl !== 'undefined' &&
      Intl.DisplayNames
        ? new Intl.DisplayNames(
            ['en'],
            { type: 'region' }
          )
        : null;

    const getCountryName = (code) => {
      if (!code) return '';

      try {
        return (
          countryDisplayNames?.of(code) ||
          code
        );
      } catch {
        return code;
      }
    };

    const typeRank = {
      large_airport: 4,
      medium_airport: 3,
      small_airport: 2,
      heliport: 1,
      seaplane_base: 1,
      balloonport: 1
    };

    const cleanAirportName = (value) =>
      normalizeText(value)
        .replace(
          /\b(international|airport|airfield|aerodrome|municipal|regional)\b/g,
          ' '
        )
        .replace(/\s+/g, ' ')
        .trim();

    const findBestAirportForVideo = (
      video,
      airports,
      codeIndex,
      cityCountryIndex
    ) => {
      const title =
        normalizeText(video.titleKey);

      const codeMatches =
        String(video.title || '')
          .toUpperCase()
          .match(/\b[A-Z0-9]{3,4}\b/g) ||
        [];

      for (const code of codeMatches) {
        const match =
          codeIndex.get(code);

        if (match) {
          return match;
        }
      }

      const cityKey =
        normalizeText(video.city);

      const countryKey =
        canonicalCountryKey(
          video.country
        );

      const candidates =
        cityCountryIndex.get(
          `${cityKey}|${countryKey}`
        ) ||
        cityCountryIndex.get(
          `${cityKey}|`
        ) ||
        [];

      if (candidates.length === 0) {
        return null;
      }

      let best = null;
      let bestScore = -Infinity;

      for (const airport of candidates) {
        const properties =
          airport.properties;

        const airportName =
          cleanAirportName(
            properties.name
          );

        let score =
          Number(
            typeRank[properties.type] || 0
          ) * 10;

        if (
          properties.scheduled === 'yes'
        ) {
          score += 8;
        }

        if (
          airportName.length >= 4 &&
          title.includes(airportName)
        ) {
          score += 60;
        }

        if (
          properties.iata &&
          title.includes(
            normalizeText(
              properties.iata
            )
          )
        ) {
          score += 80;
        }

        if (
          properties.icao &&
          title.includes(
            normalizeText(
              properties.icao
            )
          )
        ) {
          score += 80;
        }

        if (score > bestScore) {
          bestScore = score;
          best = airport;
        }
      }

      return best;
    };

    if (
      mapElement &&
      window.L &&
      L.markerClusterGroup
    ) {
      const worldBounds = L.latLngBounds(
        [-85, -180],
        [85, 180]
      );

      const map = L.map(
        mapElement,
        {
          worldCopyJump: false,
          maxBoundsViscosity: 1,
          maxZoom: 21,
          zoomControl: true,
          zoomSnap: 0.25,
          zoomDelta: 0.5
        }
      );

      const fitMinZoomToContainer = () => {
        const boundsZoom = map.getBoundsZoom(
          worldBounds,
          true
        );

        map.setMinZoom(boundsZoom);

        if (map.getZoom() < boundsZoom) {
          map.setView(
            [23, 8],
            boundsZoom
          );
        }
      };

      fitMinZoomToContainer();
      map.setView([23, 8], map.getMinZoom());

      map.setMaxBounds(worldBounds);

      map.attributionControl.setPrefix(
        false
      );

      L.tileLayer(
        'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
        {
          noWrap: true,
          maxNativeZoom: 19,
          maxZoom: 21,
          attribution:
            'Tiles &copy; Esri, Maxar, Earthstar Geographics, and the GIS User Community'
        }
      ).addTo(map);

      L.tileLayer(
        'https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
        {
          noWrap: true,
          maxNativeZoom: 19,
          maxZoom: 21,
          opacity: 0.76,
          attribution:
            'Labels &copy; Esri'
        }
      ).addTo(map);

      const markerLayer =
        L.markerClusterGroup({
          maxClusterRadius: 42,
          disableClusteringAtZoom: 7,
          showCoverageOnHover: false,
          spiderfyOnMaxZoom: true,
          removeOutsideVisibleBounds: true,
          animate: true,
          animateAddingMarkers: false,
          chunkedLoading: true,
          chunkInterval: 80,
          chunkDelay: 20,
          chunkProgress: (processed, total) => {
            if (loadingElement && total > 0) {
              loadingElement.innerHTML = `
                <span class="airport-loading-plane" aria-hidden="true">✈</span>
                <span>${processed.toLocaleString()} / ${total.toLocaleString()} ${clientLabels.airports}</span>
              `;
            }
          },
          iconCreateFunction: (cluster) => {
            const markers =
              cluster.getAllChildMarkers();

            const videoCount =
              markers.reduce(
                (sum, marker) =>
                  sum +
                  Number(
                    marker.options.relatedVideoCount ||
                    0
                  ),
                0
              );

            const airportCount =
              cluster.getChildCount();

            const hasVideos =
              videoCount > 0;

            const className =
              hasVideos
                ? 'airport-cluster has-videos'
                : 'airport-cluster';

            return L.divIcon({
              html: `
                <div class="${className}">
                  <span class="cluster-plane">✈</span>
                  <strong>${airportCount.toLocaleString()}</strong>
                </div>
              `,
              className:
                'airport-cluster-icon',
              iconSize: [50, 50]
            });
          }
        }).addTo(map);

      const markerRecords = [];
      const airports = [];
      const airportById = new Map();
      const videoAirportMap = new Map();

      const createPlaneIcon = (
        hasVideo,
        size = 20
      ) =>
        L.divIcon({
          html: `
            <div class="airport-plane ${
              hasVideo
                ? 'has-video'
                : ''
            }">
              ✈
            </div>
          `,
          className:
            'airport-plane-marker',
          iconSize: [size, size],
          iconAnchor: [
            size / 2,
            size / 2
          ]
        });

      const createPopup = (airport) => {
        const properties =
          airport.properties;

        const country =
          getCountryName(
            properties.isoCountry
          );

        const relatedVideos =
          properties.relatedVideos ||
          [];

        const videosHtml =
          relatedVideos.length > 0
            ? `
              <div class="airport-popup-videos">
                ${relatedVideos
                  .slice(0, 6)
                  .map(
                    (video) => `
                      <a
                        href="${escapeHtml(video.url)}"
                        class="airport-popup-video"
                      >
                        <img
                          src="${escapeHtml(video.thumbnail)}"
                          alt=""
                          loading="lazy"
                        />
                        <span>
                          ${escapeHtml(video.title)}
                        </span>
                      </a>
                    `
                  )
                  .join('')}
              </div>
            `
            : '';

        return `
          <div class="airport-popup">
            <div class="airport-popup-code">
              <span>✈</span>
              <strong>
                ${escapeHtml(
                  properties.iata ||
                  properties.icao ||
                  properties.ident
                )}
              </strong>
            </div>

            <h3>
              ${escapeHtml(properties.name)}
            </h3>

            <p>
              ${escapeHtml(
                properties.municipality
              )}
              ${
                properties.municipality &&
                country
                  ? ' · '
                  : ''
              }
              ${escapeHtml(country)}
            </p>

            <div class="airport-popup-meta">
              ${
                properties.iata
                  ? `<span>IATA ${escapeHtml(properties.iata)}</span>`
                  : ''
              }
              ${
                properties.icao
                  ? `<span>ICAO ${escapeHtml(properties.icao)}</span>`
                  : ''
              }
              <span>
                ${escapeHtml(
                  String(properties.type || '')
                    .replace(/_/g, ' ')
                )}
              </span>
            </div>

            ${videosHtml}
          </div>
        `;
      };

      const updateVisibleCount = () => {
        const visible =
          markerRecords.filter(
            (record) =>
              markerLayer.hasLayer(
                record.marker
              )
          ).length;

        if (visibleAirportCount) {
          visibleAirportCount.textContent =
            `${visible.toLocaleString()} ${clientLabels.airports}`;
        }
      };

      const applyFilters = () => {
        const query =
          normalizeText(
            searchInput?.value || ''
          );

        const selectedCountry =
          String(
            countrySelect?.value || ''
          );

        markerLayer.clearLayers();

        const visibleMarkers = [];

        for (
          const record of markerRecords
        ) {
          const properties =
            record.airport.properties;

          const matchesSearch =
            !query ||
            record.searchText.includes(
              query
            );

          const matchesCountry =
            !selectedCountry ||
            properties.isoCountry ===
              selectedCountry;

          if (
            matchesSearch &&
            matchesCountry
          ) {
            visibleMarkers.push(
              record.marker
            );
          }
        }

        markerLayer.addLayers(
          visibleMarkers
        );

        if (visibleAirportCount) {
          visibleAirportCount.textContent =
            `${visibleMarkers.length.toLocaleString()} ${clientLabels.airports}`;
        }

        if (
          query &&
          visibleMarkers.length === 1
        ) {
          const marker =
            visibleMarkers[0];

          map.flyTo(
            marker.getLatLng(),
            11,
            {
              duration: 0.8
            }
          );

          marker.openPopup();
        } else if (
          query &&
          visibleMarkers.length > 1 &&
          visibleMarkers.length <= 100
        ) {
          const group =
            L.featureGroup(
              visibleMarkers
            );

          map.fitBounds(
            group
              .getBounds()
              .pad(0.18),
            {
              maxZoom: 7,
              animate: true
            }
          );
        }
      };

      const focusVideoAirport = (
        videoId
      ) => {
        const airport =
          videoAirportMap.get(videoId);

        if (!airport) return;

        const record =
          markerRecords.find(
            (item) =>
              item.airport.properties.id ===
              airport.properties.id
          );

        if (!record) return;

        map.flyTo(
          record.marker.getLatLng(),
          Math.max(
            map.getZoom(),
            10
          ),
          {
            duration: 0.8
          }
        );

        setTimeout(
          () => record.marker.openPopup(),
          500
        );
      };

      fetch(AIRPORT_DATA_URL, {
        cache: 'force-cache'
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error(
              `Airport data request failed: ${response.status}`
            );
          }

          return response.json();
        })
        .then((records) => {
          if (!Array.isArray(records)) {
            throw new Error(
              'Airport data format is invalid.'
            );
          }

          const countryCodes =
            new Set();

          const codeIndex =
            new Map();

          const cityCountryIndex =
            new Map();

          for (
            let index = 0;
            index < records.length;
            index += 1
          ) {
            const record = records[index];

            const latitude =
              Number(record.lat);

            const longitude =
              Number(record.lng);

            if (
              !Number.isFinite(latitude) ||
              !Number.isFinite(longitude)
            ) {
              continue;
            }

            const type =
              String(record.type || '');

            if (
              !type ||
              type === 'closed'
            ) {
              continue;
            }

            const id =
              String(
                record.id ||
                record.ident ||
                index
              );

            const isoCountry =
              String(record.country || '');

            const municipality =
              String(record.city || '');

            const countryName =
              getCountryName(
                isoCountry
              );

            const airport = {
              type: 'Feature',
              geometry: {
                type: 'Point',
                coordinates: [
                  longitude,
                  latitude
                ]
              },
              properties: {
                id,
                ident:
                  String(
                    record.ident || ''
                  ),
                type,
                name:
                  String(
                    record.name || ''
                  ),
                isoCountry,
                municipality,
                scheduled:
                  String(
                    record.scheduled || ''
                  ),
                iata:
                  String(
                    record.iata || ''
                  ),
                icao:
                  String(
                    record.icao || ''
                  ),
                relatedVideos: []
              }
            };

            airports.push(airport);
            airportById.set(
              id,
              airport
            );

            if (isoCountry) {
              countryCodes.add(
                isoCountry
              );
            }

            [
              airport.properties.iata,
              airport.properties.icao,
              airport.properties.ident
            ]
              .filter(Boolean)
              .forEach((code) => {
                codeIndex.set(
                  String(code)
                    .toUpperCase(),
                  airport
                );
              });

            const cityKey =
              normalizeText(
                municipality
              );

            const countryKey =
              canonicalCountryKey(
                countryName
              );

            const exactKey =
              `${cityKey}|${countryKey}`;

            if (
              !cityCountryIndex.has(
                exactKey
              )
            ) {
              cityCountryIndex.set(
                exactKey,
                []
              );
            }

            cityCountryIndex
              .get(exactKey)
              ?.push(airport);

            const cityOnlyKey =
              `${cityKey}|`;

            if (
              !cityCountryIndex.has(
                cityOnlyKey
              )
            ) {
              cityCountryIndex.set(
                cityOnlyKey,
                []
              );
            }

            cityCountryIndex
              .get(cityOnlyKey)
              ?.push(airport);
          }

          for (
            const video of airportVideos
          ) {
            const airport =
              findBestAirportForVideo(
                video,
                airports,
                codeIndex,
                cityCountryIndex
              );

            if (!airport) continue;

            airport.properties
              .relatedVideos
              .push(video);

            videoAirportMap.set(
              video.id,
              airport
            );
          }

          const sortedCountries =
            Array.from(countryCodes)
              .sort(
                (a, b) =>
                  getCountryName(a)
                    .localeCompare(
                      getCountryName(b)
                    )
              );

          for (
            const code of sortedCountries
          ) {
            const option =
              document.createElement(
                'option'
              );

            option.value = code;
            option.textContent =
              getCountryName(code);

            countrySelect
              ?.appendChild(option);
          }

          if (airportCountElement) {
            airportCountElement.textContent =
              airports.length
                .toLocaleString();
          }

          if (countryCountElement) {
            countryCountElement.textContent =
              countryCodes.size
                .toLocaleString();
          }

          const markersToAdd = [];

          for (
            const airport of airports
          ) {
            const properties =
              airport.properties;

            const hasVideo =
              properties.relatedVideos
                .length > 0;

            const marker =
              L.marker(
                [
                  airport.geometry
                    .coordinates[1],
                  airport.geometry
                    .coordinates[0]
                ],
                {
                  icon:
                    createPlaneIcon(
                      hasVideo,
                      hasVideo
                        ? 22
                        : 16
                    ),
                  relatedVideoCount:
                    properties
                      .relatedVideos
                      .length
                }
              );

            marker.bindPopup(
              createPopup(airport),
              {
                maxWidth: 340,
                minWidth: 250
              }
            );

            markersToAdd.push(marker);

            const searchText =
              [
                properties.name,
                properties.municipality,
                getCountryName(
                  properties.isoCountry
                ),
                properties.iata,
                properties.icao,
                properties.ident
              ]
                .map(normalizeText)
                .join(' ');

            markerRecords.push({
              marker,
              airport,
              searchText
            });
          }

          if (visibleAirportCount) {
            visibleAirportCount.textContent =
              `${airports.length.toLocaleString()} ${clientLabels.airports}`;
          }

          markerLayer.addLayers(markersToAdd);

          const waitForClusterLoad = () => {
            if (markerLayer.getLayers().length >= markersToAdd.length) {
              loadingElement
                ?.classList
                .add('is-hidden');
              return;
            }

            window.setTimeout(waitForClusterLoad, 120);
          };

          waitForClusterLoad();

          airportVideoCards
            .forEach((card) => {
              const videoId =
                card.dataset.videoId;

              if (!videoId) return;

              card.addEventListener(
                'mouseenter',
                () =>
                  focusVideoAirport(
                    videoId
                  )
              );

              card.addEventListener(
                'focus',
                () =>
                  focusVideoAirport(
                    videoId
                  )
              );
            });
        })
        .catch((error) => {
          console.error(error);

          if (loadingElement) {
            loadingElement.innerHTML = `
              <span class="airport-loading-plane">!</span>
              <span>Airport data could not be loaded.</span>
            `;
          }
        });

      const debouncedApplyFilters =
        debounce(applyFilters, 200);

      searchInput?.addEventListener(
        'input',
        debouncedApplyFilters
      );

      countrySelect?.addEventListener(
        'change',
        applyFilters
      );

      window.addEventListener(
        'resize',
        () => {
          map.invalidateSize();
          fitMinZoomToContainer();
        }
      );
    }
  </script>
</BaseLayout>


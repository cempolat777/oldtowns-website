---
import MainPage from '../../components/MainPage.astro';
import videos from '../../data/videos.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'tr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
    { params: { lang: 'it' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'zh' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'ar' } },
    { params: { lang: 'hi' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'sv' } },
    { params: { lang: 'id' } },
    { params: { lang: 'vi' } }
  ];
}

const { lang } = Astro.params;
---

<MainPage videos={videos} lang={lang} />
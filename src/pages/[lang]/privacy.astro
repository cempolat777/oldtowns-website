---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang }
  }));
}

const privacyContent = {
  en: {
    "metaTitle": "Privacy Policy | Old Towns Walks",
    "metaDescription": "Learn how Old Towns Walks handles website data, analytics, cookies, embedded content, advertising technologies, privacy choices, and third-party services.",
    "backHome": "Back to Home",
    "headingLead": "Privacy",
    "headingAccent": "Policy",
    "lastUpdated": "Last updated: September 16, 2026",
    "intro1": "Old Towns Walks respects your privacy. This policy explains what information may be processed when you use oldtownswalks.com, why it may be processed, which third-party services may receive data, and what choices are available to you.",
    "intro2": "This policy applies to this website. External websites, video platforms, advertisers, booking providers, and other third-party services have their own privacy practices and policies.",
    "s1Title": "Information We Process",
    "s1Text": "When you contact us, you may voluntarily provide your name, email address, message content, and other details. When you visit the site, technical data may also be processed automatically, including IP address, browser and device information, operating system, referring page, requested pages, timestamps, approximate network-derived location, and security or performance logs.",
    "s2Title": "Analytics and Server Logs",
    "s2Text": "We use Google Analytics 4 to understand website usage and measure traffic and performance. Google may process device, browser, network, identifier, and interaction information according to its policies and our configuration. Hosting, content-delivery, and security providers may also process technical request data and security logs to operate and protect the site.",
    "s3Title": "Cookies and Similar Technologies",
    "s3Text": "The site and services used on it may use cookies, local storage, pixels, or similar technologies for essential operation, security, analytics, preferences, embedded content, and advertising where enabled. You can control or delete cookies through your browser, although blocking some technologies may affect website features.",
    "s4Title": "Embedded Content and Third Parties",
    "s4Text": "Pages may contain embedded videos or other content from platforms such as YouTube. Loading or interacting with embedded content may allow the provider to receive technical and usage information and to use cookies or similar identifiers under its own policies. External content remains hosted by the relevant third party.",
    "s5Title": "Advertising and Google Services",
    "s5Text": "If advertising services such as Google AdSense are enabled, Google and other advertising vendors may use cookies or similar technologies to serve, measure, limit, and personalize ads. Google advertising cookies can allow Google and its partners to serve ads based on visits to this website and/or other websites. Google advertising preferences can be managed through My Ad Center.",
    "s6Title": "Sharing, International Processing, and Retention",
    "s6Text": "Information may be processed by providers supporting hosting, security, analytics, embedded media, advertising, communications, or other website functions, and may be disclosed when required by law or to protect rights and security. Because providers may operate internationally, data may be processed outside your country. We retain information only as long as reasonably necessary for the relevant purpose or legal obligations.",
    "s7Title": "Your Privacy Choices and Rights",
    "s7Text": "Depending on where you live, you may have rights to request access, correction, deletion, restriction, portability, objection to certain processing, or withdrawal of consent where processing relies on consent. Legal exceptions may apply. Browser controls, available consent controls, Google advertising settings, and third-party settings may also help manage certain choices.",
    "s8Title": "Children, Security, and Policy Changes",
    "s8Text": "Old Towns Walks is not directed to children under 13 and we do not knowingly request personal information from children under 13. We use reasonable technical and organizational measures to protect the site, but no internet transmission or storage method can be guaranteed completely secure. We may update this policy when the site, services, legal requirements, or third-party tools change.",
    "resourcesTitle": "Third-Party Privacy Resources",
    "resourcesIntro": "These links provide additional information about services that may process data when you use this website:",
    "googlePrivacy": "Google Privacy Policy",
    "googlePartners": "Google Partner Sites",
    "googleAds": "Google My Ad Center",
    "cloudflare": "Cloudflare Privacy Policy",
    "contactTitle": "Privacy Questions?",
    "contactText": "Contact us if you have a privacy question or want to make a privacy-related request.",
    "contactButton": "Contact Us",
  },
  tr: {
    "metaTitle": "Gizlilik Politikası | Old Towns Walks",
    "metaDescription": "Old Towns Walks sitesinde verilerin, analizlerin, çerezlerin, gömülü içeriklerin, reklam teknolojilerinin, gizlilik tercihlerinin ve üçüncü taraf hizmetlerinin nasıl ele alındığını öğrenin.",
    "backHome": "Ana Sayfaya Dön",
    "headingLead": "Gizlilik",
    "headingAccent": "Politikası",
    "lastUpdated": "Son güncelleme: 16 Eylül 2026",
    "intro1": "Old Towns Walks gizliliğinize saygı duyar. Bu politika, oldtownswalks.com sitesini kullandığınızda hangi bilgilerin işlenebileceğini, neden işlenebileceğini, hangi üçüncü taraf hizmetlerin veri alabileceğini ve hangi seçeneklere sahip olduğunuzu açıklar.",
    "intro2": "Bu politika bu web sitesi için geçerlidir. Harici web siteleri, video platformları, reklamverenler, rezervasyon sağlayıcıları ve diğer üçüncü taraf hizmetlerin kendi gizlilik uygulamaları ve politikaları vardır.",
    "s1Title": "İşleyebileceğimiz Bilgiler",
    "s1Text": "Bizimle iletişime geçtiğinizde adınızı, e-posta adresinizi, mesaj içeriğinizi ve diğer bilgileri gönüllü olarak paylaşabilirsiniz. Siteyi ziyaret ettiğinizde IP adresi, tarayıcı ve cihaz bilgileri, işletim sistemi, yönlendiren sayfa, istenen sayfalar, zaman damgaları, ağdan türetilen yaklaşık konum ve güvenlik veya performans günlükleri gibi teknik veriler de otomatik olarak işlenebilir.",
    "s2Title": "Analiz ve Sunucu Günlükleri",
    "s2Text": "Web sitesi kullanımını anlamak, trafik ve performansı ölçmek için Google Analytics 4 kullanıyoruz. Google, kendi politikaları ve yapılandırmamıza göre cihaz, tarayıcı, ağ, tanımlayıcı ve etkileşim bilgilerini işleyebilir. Barındırma, içerik dağıtımı ve güvenlik sağlayıcıları da siteyi çalıştırmak ve korumak için teknik istek verilerini ve güvenlik günlüklerini işleyebilir.",
    "s3Title": "Çerezler ve Benzer Teknolojiler",
    "s3Text": "Site ve üzerinde kullanılan hizmetler; temel işlevler, güvenlik, analiz, tercihler, gömülü içerik ve etkinleştirilmişse reklam amacıyla çerezler, yerel depolama, pikseller veya benzer teknolojiler kullanabilir. Çerezleri tarayıcınızdan kontrol edebilir veya silebilirsiniz; ancak bazı teknolojilerin engellenmesi site özelliklerini etkileyebilir.",
    "s4Title": "Gömülü İçerik ve Üçüncü Taraflar",
    "s4Text": "Sayfalarda YouTube gibi platformlardan gömülü videolar veya başka içerikler bulunabilir. Gömülü içeriğin yüklenmesi ya da onunla etkileşim kurulması, sağlayıcının teknik ve kullanım bilgileri almasına ve kendi politikaları uyarınca çerezler veya benzer tanımlayıcılar kullanmasına olanak verebilir. Harici içerik ilgili üçüncü taraf tarafından barındırılmaya devam eder.",
    "s5Title": "Reklamcılık ve Google Hizmetleri",
    "s5Text": "Google AdSense gibi reklam hizmetleri etkinleştirilirse Google ve diğer reklam sağlayıcıları reklam sunmak, ölçmek, sınırlandırmak ve kişiselleştirmek için çerezler veya benzer teknolojiler kullanabilir. Google reklam çerezleri, Google ve iş ortaklarının bu siteye ve/veya diğer sitelere yapılan ziyaretlere göre reklam göstermesine olanak tanıyabilir. Google reklam tercihleri My Ad Center üzerinden yönetilebilir.",
    "s6Title": "Paylaşım, Uluslararası İşleme ve Saklama",
    "s6Text": "Bilgiler; barındırma, güvenlik, analiz, gömülü medya, reklam, iletişim veya diğer site işlevlerini destekleyen sağlayıcılar tarafından işlenebilir ve yasa gerektirdiğinde ya da hakları ve güvenliği korumak için açıklanabilir. Sağlayıcılar uluslararası faaliyet gösterebildiği için veriler ülkeniz dışında işlenebilir. Bilgileri yalnızca ilgili amaç veya yasal yükümlülükler için makul ölçüde gerekli olduğu sürece saklarız.",
    "s7Title": "Gizlilik Seçenekleriniz ve Haklarınız",
    "s7Text": "Yaşadığınız yere bağlı olarak erişim, düzeltme, silme, kısıtlama, veri taşınabilirliği, belirli işlemlere itiraz veya işlemenin rızaya dayandığı durumlarda rızayı geri çekme haklarına sahip olabilirsiniz. Yasal istisnalar uygulanabilir. Tarayıcı kontrolleri, mevcut onay kontrolleri, Google reklam ayarları ve üçüncü taraf ayarları da bazı tercihleri yönetmenize yardımcı olabilir.",
    "s8Title": "Çocuklar, Güvenlik ve Politika Değişiklikleri",
    "s8Text": "Old Towns Walks 13 yaşın altındaki çocuklara yönelik değildir ve 13 yaşın altındaki çocuklardan bilerek kişisel bilgi talep etmeyiz. Siteyi korumak için makul teknik ve organizasyonel önlemler kullanırız; ancak hiçbir internet iletimi veya depolama yöntemi tamamen güvenli olarak garanti edilemez. Site, hizmetler, yasal gereklilikler veya üçüncü taraf araçlar değiştiğinde bu politikayı güncelleyebiliriz.",
    "resourcesTitle": "Üçüncü Taraf Gizlilik Kaynakları",
    "resourcesIntro": "Bu bağlantılar, bu web sitesini kullandığınızda veri işleyebilecek hizmetler hakkında ek bilgi sağlar:",
    "googlePrivacy": "Google Gizlilik Politikası",
    "googlePartners": "Google İş Ortağı Siteleri",
    "googleAds": "Google My Ad Center",
    "cloudflare": "Cloudflare Gizlilik Politikası",
    "contactTitle": "Gizlilik Sorunuz mu Var?",
    "contactText": "Gizlilikle ilgili bir sorunuz veya talebiniz varsa bizimle iletişime geçin.",
    "contactButton": "Bize Ulaşın",
  },
  de: {
    "metaTitle": "Datenschutz | Old Towns Walks",
    "metaDescription": "Erfahren Sie, wie Old Towns Walks Websitedaten, Analysen, Cookies, eingebettete Inhalte, Werbetechnologien, Datenschutzoptionen und Drittanbieter behandelt.",
    "backHome": "Zur Startseite",
    "headingLead": "Datenschutz",
    "headingAccent": "richtlinie",
    "lastUpdated": "Zuletzt aktualisiert: 16. September 2026",
    "intro1": "Old Towns Walks respektiert Ihre Privatsphäre. Diese Richtlinie erklärt, welche Informationen bei der Nutzung von oldtownswalks.com verarbeitet werden können, warum dies geschieht, welche Drittanbieter Daten erhalten können und welche Wahlmöglichkeiten Sie haben.",
    "intro2": "Diese Richtlinie gilt für diese Website. Externe Websites, Videoplattformen, Werbeanbieter, Buchungsanbieter und andere Drittanbieterdienste haben eigene Datenschutzpraktiken und Richtlinien.",
    "s1Title": "Informationen, die wir verarbeiten",
    "s1Text": "Wenn Sie uns kontaktieren, können Sie freiwillig Ihren Namen, Ihre E-Mail-Adresse, den Inhalt Ihrer Nachricht und weitere Angaben übermitteln. Beim Besuch der Website können außerdem automatisch technische Daten verarbeitet werden, darunter IP-Adresse, Browser- und Geräteinformationen, Betriebssystem, verweisende Seite, aufgerufene Seiten, Zeitstempel, ungefähre netzwerkbasierte Position sowie Sicherheits- oder Leistungsprotokolle.",
    "s2Title": "Analysen und Serverprotokolle",
    "s2Text": "Wir verwenden Google Analytics 4, um die Nutzung der Website zu verstehen sowie Traffic und Leistung zu messen. Google kann Geräte-, Browser-, Netzwerk-, Kennungs- und Interaktionsdaten gemäß seinen Richtlinien und unserer Konfiguration verarbeiten. Hosting-, Content-Delivery- und Sicherheitsanbieter können ebenfalls technische Anfragedaten und Sicherheitsprotokolle verarbeiten, um die Website zu betreiben und zu schützen.",
    "s3Title": "Cookies und ähnliche Technologien",
    "s3Text": "Die Website und die darauf verwendeten Dienste können Cookies, lokalen Speicher, Pixel oder ähnliche Technologien für grundlegende Funktionen, Sicherheit, Analysen, Einstellungen, eingebettete Inhalte und – sofern aktiviert – Werbung verwenden. Sie können Cookies über Ihren Browser steuern oder löschen; das Blockieren bestimmter Technologien kann jedoch Funktionen der Website beeinträchtigen.",
    "s4Title": "Eingebettete Inhalte und Drittanbieter",
    "s4Text": "Seiten können eingebettete Videos oder andere Inhalte von Plattformen wie YouTube enthalten. Das Laden oder die Interaktion mit solchen Inhalten kann dem Anbieter ermöglichen, technische und Nutzungsinformationen zu erhalten und gemäß seinen eigenen Richtlinien Cookies oder ähnliche Kennungen zu verwenden. Externe Inhalte bleiben beim jeweiligen Drittanbieter gehostet.",
    "s5Title": "Werbung und Google-Dienste",
    "s5Text": "Wenn Werbedienste wie Google AdSense aktiviert werden, können Google und andere Werbeanbieter Cookies oder ähnliche Technologien nutzen, um Anzeigen auszuliefern, zu messen, zu begrenzen und zu personalisieren. Google-Werbecookies können Google und seinen Partnern ermöglichen, Anzeigen auf Grundlage von Besuchen dieser und/oder anderer Websites zu schalten. Google-Werbeeinstellungen können über My Ad Center verwaltet werden.",
    "s6Title": "Weitergabe, internationale Verarbeitung und Speicherung",
    "s6Text": "Informationen können von Anbietern verarbeitet werden, die Hosting, Sicherheit, Analysen, eingebettete Medien, Werbung, Kommunikation oder andere Websitefunktionen unterstützen, und können offengelegt werden, wenn dies gesetzlich erforderlich ist oder dem Schutz von Rechten und Sicherheit dient. Da Anbieter international tätig sein können, können Daten außerhalb Ihres Landes verarbeitet werden. Wir speichern Informationen nur so lange, wie dies für den jeweiligen Zweck oder gesetzliche Pflichten angemessen erforderlich ist.",
    "s7Title": "Ihre Datenschutzoptionen und Rechte",
    "s7Text": "Je nach Ihrem Wohnort können Sie Rechte auf Auskunft, Berichtigung, Löschung, Einschränkung, Datenübertragbarkeit, Widerspruch gegen bestimmte Verarbeitungen oder Widerruf einer Einwilligung haben, wenn die Verarbeitung auf Einwilligung beruht. Gesetzliche Ausnahmen können gelten. Browserkontrollen, verfügbare Einwilligungsoptionen, Google-Werbeeinstellungen und Drittanbietereinstellungen können ebenfalls bei der Verwaltung bestimmter Entscheidungen helfen.",
    "s8Title": "Kinder, Sicherheit und Änderungen dieser Richtlinie",
    "s8Text": "Old Towns Walks richtet sich nicht an Kinder unter 13 Jahren und wir fordern wissentlich keine personenbezogenen Daten von Kindern unter 13 Jahren an. Wir setzen angemessene technische und organisatorische Maßnahmen zum Schutz der Website ein, doch keine Internetübertragung oder Speichermethode kann als vollständig sicher garantiert werden. Wir können diese Richtlinie aktualisieren, wenn sich Website, Dienste, gesetzliche Anforderungen oder Drittanbieterwerkzeuge ändern.",
    "resourcesTitle": "Datenschutzressourcen von Drittanbietern",
    "resourcesIntro": "Diese Links bieten zusätzliche Informationen zu Diensten, die bei der Nutzung dieser Website Daten verarbeiten können:",
    "googlePrivacy": "Google-Datenschutzerklärung",
    "googlePartners": "Google-Partnerwebsites",
    "googleAds": "Google My Ad Center",
    "cloudflare": "Cloudflare-Datenschutzerklärung",
    "contactTitle": "Fragen zum Datenschutz?",
    "contactText": "Kontaktieren Sie uns, wenn Sie eine Datenschutzfrage haben oder eine datenschutzbezogene Anfrage stellen möchten.",
    "contactButton": "Kontakt",
  },
  es: {
    "metaTitle": "Política de Privacidad | Old Towns Walks",
    "metaDescription": "Conoce cómo Old Towns Walks gestiona datos del sitio, analítica, cookies, contenido incrustado, tecnologías publicitarias, opciones de privacidad y servicios de terceros.",
    "backHome": "Volver al inicio",
    "headingLead": "Política de",
    "headingAccent": "Privacidad",
    "lastUpdated": "Última actualización: 16 de septiembre de 2026",
    "intro1": "Old Towns Walks respeta tu privacidad. Esta política explica qué información puede procesarse cuando utilizas oldtownswalks.com, por qué puede procesarse, qué servicios de terceros pueden recibir datos y qué opciones tienes disponibles.",
    "intro2": "Esta política se aplica a este sitio web. Los sitios externos, plataformas de vídeo, anunciantes, proveedores de reservas y otros servicios de terceros tienen sus propias prácticas y políticas de privacidad.",
    "s1Title": "Información que procesamos",
    "s1Text": "Cuando te pones en contacto con nosotros, puedes proporcionar voluntariamente tu nombre, dirección de correo electrónico, contenido del mensaje y otros datos. Al visitar el sitio, también pueden procesarse automáticamente datos técnicos como dirección IP, información del navegador y dispositivo, sistema operativo, página de referencia, páginas solicitadas, marcas de tiempo, ubicación aproximada derivada de la red y registros de seguridad o rendimiento.",
    "s2Title": "Analítica y registros del servidor",
    "s2Text": "Utilizamos Google Analytics 4 para comprender el uso del sitio web y medir el tráfico y el rendimiento. Google puede procesar información del dispositivo, navegador, red, identificadores e interacciones según sus políticas y nuestra configuración. Los proveedores de alojamiento, distribución de contenido y seguridad también pueden procesar datos técnicos de solicitudes y registros de seguridad para operar y proteger el sitio.",
    "s3Title": "Cookies y tecnologías similares",
    "s3Text": "El sitio y los servicios utilizados en él pueden usar cookies, almacenamiento local, píxeles o tecnologías similares para funciones esenciales, seguridad, analítica, preferencias, contenido incrustado y publicidad cuando esté habilitada. Puedes controlar o eliminar cookies desde tu navegador, aunque bloquear algunas tecnologías puede afectar funciones del sitio.",
    "s4Title": "Contenido incrustado y terceros",
    "s4Text": "Las páginas pueden incluir vídeos incrustados u otro contenido de plataformas como YouTube. Cargar o interactuar con contenido incrustado puede permitir al proveedor recibir información técnica y de uso y utilizar cookies o identificadores similares conforme a sus propias políticas. El contenido externo permanece alojado por el tercero correspondiente.",
    "s5Title": "Publicidad y servicios de Google",
    "s5Text": "Si se habilitan servicios publicitarios como Google AdSense, Google y otros proveedores de publicidad pueden usar cookies o tecnologías similares para servir, medir, limitar y personalizar anuncios. Las cookies publicitarias de Google pueden permitir que Google y sus socios muestren anuncios basados en visitas a este y/o otros sitios web. Las preferencias publicitarias de Google pueden gestionarse mediante My Ad Center.",
    "s6Title": "Compartición, procesamiento internacional y conservación",
    "s6Text": "La información puede ser procesada por proveedores que apoyan el alojamiento, seguridad, analítica, medios incrustados, publicidad, comunicaciones u otras funciones del sitio, y puede divulgarse cuando lo exija la ley o para proteger derechos y seguridad. Como los proveedores pueden operar internacionalmente, los datos pueden procesarse fuera de tu país. Conservamos la información solo durante el tiempo razonablemente necesario para la finalidad correspondiente o las obligaciones legales.",
    "s7Title": "Tus opciones y derechos de privacidad",
    "s7Text": "Según dónde vivas, puedes tener derechos para solicitar acceso, corrección, eliminación, restricción, portabilidad, oponerte a determinados tratamientos o retirar el consentimiento cuando el tratamiento dependa de él. Pueden aplicarse excepciones legales. Los controles del navegador, controles de consentimiento disponibles, ajustes publicitarios de Google y ajustes de terceros también pueden ayudarte a gestionar determinadas opciones.",
    "s8Title": "Menores, seguridad y cambios en la política",
    "s8Text": "Old Towns Walks no está dirigido a menores de 13 años y no solicitamos conscientemente información personal de menores de 13 años. Utilizamos medidas técnicas y organizativas razonables para proteger el sitio, pero ningún método de transmisión o almacenamiento por Internet puede garantizarse como completamente seguro. Podemos actualizar esta política cuando cambien el sitio, los servicios, los requisitos legales o las herramientas de terceros.",
    "resourcesTitle": "Recursos de privacidad de terceros",
    "resourcesIntro": "Estos enlaces ofrecen información adicional sobre servicios que pueden procesar datos cuando utilizas este sitio web:",
    "googlePrivacy": "Política de Privacidad de Google",
    "googlePartners": "Sitios asociados de Google",
    "googleAds": "Google My Ad Center",
    "cloudflare": "Política de Privacidad de Cloudflare",
    "contactTitle": "¿Preguntas sobre privacidad?",
    "contactText": "Contáctanos si tienes una pregunta sobre privacidad o deseas realizar una solicitud relacionada con tus datos.",
    "contactButton": "Contáctanos",
  },
  fr: {
    "metaTitle": "Politique de confidentialité | Old Towns Walks",
    "metaDescription": "Découvrez comment Old Towns Walks traite les données du site, les analyses, les cookies, les contenus intégrés, les technologies publicitaires, les choix de confidentialité et les services tiers.",
    "backHome": "Retour à l’accueil",
    "headingLead": "Politique de",
    "headingAccent": "confidentialité",
    "lastUpdated": "Dernière mise à jour : 16 septembre 2026",
    "intro1": "Old Towns Walks respecte votre vie privée. Cette politique explique quelles informations peuvent être traitées lorsque vous utilisez oldtownswalks.com, pourquoi elles peuvent l’être, quels services tiers peuvent recevoir des données et quels choix s’offrent à vous.",
    "intro2": "Cette politique s’applique à ce site web. Les sites externes, plateformes vidéo, annonceurs, services de réservation et autres services tiers disposent de leurs propres pratiques et politiques de confidentialité.",
    "s1Title": "Informations que nous traitons",
    "s1Text": "Lorsque vous nous contactez, vous pouvez fournir volontairement votre nom, votre adresse e-mail, le contenu de votre message et d’autres informations. Lorsque vous visitez le site, des données techniques peuvent également être traitées automatiquement, notamment l’adresse IP, les informations sur le navigateur et l’appareil, le système d’exploitation, la page de provenance, les pages demandées, les horodatages, la localisation approximative dérivée du réseau et les journaux de sécurité ou de performance.",
    "s2Title": "Analyses et journaux serveur",
    "s2Text": "Nous utilisons Google Analytics 4 pour comprendre l’utilisation du site et mesurer le trafic et les performances. Google peut traiter des informations relatives à l’appareil, au navigateur, au réseau, aux identifiants et aux interactions conformément à ses politiques et à notre configuration. Les fournisseurs d’hébergement, de diffusion de contenu et de sécurité peuvent également traiter des données techniques de requête et des journaux de sécurité afin d’exploiter et de protéger le site.",
    "s3Title": "Cookies et technologies similaires",
    "s3Text": "Le site et les services qui y sont utilisés peuvent recourir à des cookies, au stockage local, à des pixels ou à des technologies similaires pour le fonctionnement essentiel, la sécurité, les analyses, les préférences, les contenus intégrés et la publicité lorsqu’elle est activée. Vous pouvez contrôler ou supprimer les cookies depuis votre navigateur, même si le blocage de certaines technologies peut affecter certaines fonctionnalités.",
    "s4Title": "Contenus intégrés et tiers",
    "s4Text": "Les pages peuvent contenir des vidéos intégrées ou d’autres contenus provenant de plateformes telles que YouTube. Le chargement ou l’interaction avec ces contenus peut permettre au fournisseur de recevoir des informations techniques et d’utilisation et d’employer des cookies ou identifiants similaires selon ses propres politiques. Les contenus externes restent hébergés par le tiers concerné.",
    "s5Title": "Publicité et services Google",
    "s5Text": "Si des services publicitaires tels que Google AdSense sont activés, Google et d’autres fournisseurs publicitaires peuvent utiliser des cookies ou des technologies similaires pour diffuser, mesurer, limiter et personnaliser les annonces. Les cookies publicitaires de Google peuvent permettre à Google et à ses partenaires de diffuser des annonces en fonction des visites sur ce site et/ou d’autres sites. Les préférences publicitaires Google peuvent être gérées dans My Ad Center.",
    "s6Title": "Partage, traitement international et conservation",
    "s6Text": "Les informations peuvent être traitées par des prestataires prenant en charge l’hébergement, la sécurité, les analyses, les médias intégrés, la publicité, les communications ou d’autres fonctions du site, et peuvent être divulguées lorsque la loi l’exige ou pour protéger des droits et la sécurité. Les prestataires pouvant opérer à l’international, les données peuvent être traitées hors de votre pays. Nous conservons les informations uniquement pendant la durée raisonnablement nécessaire à la finalité concernée ou aux obligations légales.",
    "s7Title": "Vos choix et droits en matière de confidentialité",

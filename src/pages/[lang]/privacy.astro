  { title: t.s6Title, text: t.s6Text },
  { title: t.s7Title, text: t.s7Text },
  { title: t.s8Title, text: t.s8Text }
];

const privacyResources = [
  { label: t.googlePrivacy, href: 'https://policies.google.com/privacy' },
  { label: t.googlePartners, href: 'https://policies.google.com/technologies/partner-sites' },
  { label: t.googleAds, href: 'https://myadcenter.google.com/' },
  { label: t.cloudflare, href: 'https://www.cloudflare.com/privacypolicy/' }
];

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonicalUrl,
  name: metaTitle,
  description: metaDescription,
  inLanguage: currentLang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Old Towns Walks',
    url: Astro.url.origin
  }
};
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={canonicalUrl}>
  <Fragment slot="head">
    {alternateLinks.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL('/en/privacy', Astro.url.origin).href}
    />
  </Fragment>

  <div class="privacy-wrapper">
    <a href={`/${currentLang}/`} class="back-link">← {t.backHome}</a>

    <section class="privacy-header info-card" aria-labelledby="privacy-title">
      <h1 id="privacy-title">{t.headingLead} <span class="highlight">{t.headingAccent}</span></h1>
      <p class="subtitle">{t.lastUpdated}</p>
    </section>

    <section class="info-card">
      <p>{t.intro1}</p>
      <p>{t.intro2}</p>
    </section>

    {sections.map((section) => (
      <section class="info-card">
        <h2 class="card-title">{section.title}</h2>
        <p>{section.text}</p>
      </section>
    ))}

    <section class="info-card">
      <h2 class="card-title">{t.resourcesTitle}</h2>
      <p>{t.resourcesIntro}</p>
      <div class="resource-list">
        {privacyResources.map((resource) => (
          <a href={resource.href} target="_blank" rel="noopener noreferrer" class="resource-link">
            <span>{resource.label}</span><span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="info-card contact-card">
      <div>
        <h2>{t.contactTitle}</h2>
        <p>{t.contactText}</p>
      </div>
      <a href="/contact" class="btn-primary">{t.contactButton}</a>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(privacySchema)} />
</BaseLayout>

<style>
  .privacy-wrapper {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    color: #e5e7eb;
    font-family: system-ui, -apple-system, sans-serif;
    box-sizing: border-box;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 18px;
    color: #fbc02d;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .privacy-header {
    position: static;
    inset: auto;
    z-index: auto;
    text-align: center;
  }

  .privacy-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
  }

  .highlight {
    color: #fbc02d;
  }

  .subtitle {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0;
  }

  .info-card {
    background-color: #181818;
    border: 1px solid #272727;
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  .info-card p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #d1d5db;
    margin: 0 0 16px 0;
  }

  .info-card p:last-child {
    margin-bottom: 0;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 16px 0;
  }

  .resource-list {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .resource-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 14px;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
    background-color: #0f0f0f;
    color: #fbc02d;
    text-decoration: none;
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .contact-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px 0;
  }

  .contact-card p {
    font-size: 0.95rem;
    color: #9ca3af;
    margin: 0;
  }

  .btn-primary {
    background-color: #fbc02d;
    color: #0f0f0f;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .privacy-wrapper {
      padding: 20px 16px;
    }

    .contact-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .btn-primary {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>

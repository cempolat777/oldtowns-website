const summaryTemplates: Record<
  string,
  (country: string, videoCount: number, cityCount: number, categoryCount: number) => string
> = {
  en: (country, videoCount, cityCount, categoryCount) =>
    `Explore ${country} through ${videoCount} real walking and travel videos covering ${cityCount} cities and ${categoryCount} categories. Discover street-level views, different urban atmospheres and local travel experiences, then continue into individual city hubs and video tours.`,
  tr: (country, videoCount, cityCount, categoryCount) =>
    `${country} için ${cityCount} şehir ve ${categoryCount} kategoride ${videoCount} gerçek yürüyüş ve seyahat videosunu keşfedin. Sokak seviyesindeki görüntülere, farklı şehir atmosferlerine ve yerel seyahat deneyimlerine göz atın; ardından şehir merkezlerine ve bireysel video turlarına geçin.`,
  de: (country, videoCount, cityCount, categoryCount) =>
    `Entdecke ${country} mit ${videoCount} echten Spaziergangs- und Reisevideos aus ${cityCount} Städten und ${categoryCount} Kategorien. Erkunde Straßenansichten, unterschiedliche Stadtatmosphären und lokale Reiseerlebnisse und wechsle anschließend zu einzelnen Stadtseiten und Videotouren.`,
  es: (country, videoCount, cityCount, categoryCount) =>
    `Explora ${country} mediante ${videoCount} videos reales de caminatas y viajes que cubren ${cityCount} ciudades y ${categoryCount} categorías. Descubre calles, ambientes urbanos y experiencias locales, y continúa hacia los centros de ciudad y recorridos individuales.`,
  it: (country, videoCount, cityCount, categoryCount) =>
    `Esplora ${country} attraverso ${videoCount} video reali di passeggiate e viaggi in ${cityCount} città e ${categoryCount} categorie. Scopri strade, atmosfere urbane ed esperienze locali, quindi passa alle pagine delle singole città e ai tour video.`,
  fr: (country, videoCount, cityCount, categoryCount) =>
    `Explorez ${country} à travers ${videoCount} vidéos réelles de promenades et de voyage couvrant ${cityCount} villes et ${categoryCount} catégories. Découvrez des rues, des ambiances urbaines et des expériences locales, puis accédez aux pages de villes et aux visites individuelles.`,
  ja: (country, videoCount, cityCount, categoryCount) =>
    `${country}を、${cityCount}都市・${categoryCount}カテゴリー・${videoCount}本のリアルな街歩き／旅行動画で探索できます。街路風景や都市の雰囲気、現地の旅行体験を比較し、各都市ページや個別ツアーへ進めます。`,
  pt: (country, videoCount, cityCount, categoryCount) =>
    `Explore ${country} através de ${videoCount} vídeos reais de caminhadas e viagens em ${cityCount} cidades e ${categoryCount} categorias. Descubra ruas, diferentes atmosferas urbanas e experiências locais e continue para as páginas de cidades e passeios individuais.`,
  ru: (country, videoCount, cityCount, categoryCount) =>
    `Исследуйте ${country} через ${videoCount} реальных прогулочных и туристических видео из ${cityCount} городов и ${categoryCount} категорий. Смотрите улицы, сравнивайте городскую атмосферу и переходите к отдельным страницам городов и видеомаршрутам.`,
  zh: (country, videoCount, cityCount, categoryCount) =>
    `通过 ${cityCount} 个城市、${categoryCount} 个分类中的 ${videoCount} 个真实步行与旅行视频探索${country}。浏览街道实景、不同城市氛围与当地旅行体验，并继续进入城市中心页和单个视频。`,
  ko: (country, videoCount, cityCount, categoryCount) =>
    `${country}을 ${cityCount}개 도시, ${categoryCount}개 카테고리의 ${videoCount}개 실제 도보 및 여행 영상으로 탐험하세요. 거리 풍경과 다양한 도시 분위기, 현지 여행 경험을 살펴보고 각 도시 페이지와 개별 투어로 이동할 수 있습니다.`,
  ar: (country, videoCount, cityCount, categoryCount) =>
    `استكشف ${country} عبر ${videoCount} فيديو حقيقي للمشي والسفر يغطي ${cityCount} مدينة و${categoryCount} فئات. شاهد الشوارع والأجواء الحضرية وتجارب السفر المحلية، ثم انتقل إلى صفحات المدن والجولات الفردية.`,
  hi: (country, videoCount, cityCount, categoryCount) =>
    `${country} को ${cityCount} शहरों और ${categoryCount} श्रेणियों में ${videoCount} वास्तविक वॉकिंग और ट्रैवल वीडियो के माध्यम से देखें। सड़क-स्तर के दृश्य, अलग-अलग शहरी माहौल और स्थानीय यात्रा अनुभव देखें, फिर शहर पेज और अलग-अलग टूर खोलें।`,
  nl: (country, videoCount, cityCount, categoryCount) =>
    `Ontdek ${country} via ${videoCount} echte wandel- en reisvideo’s uit ${cityCount} steden en ${categoryCount} categorieën. Bekijk straatbeelden, verschillende stedelijke sferen en lokale reiservaringen en ga daarna verder naar stadspagina’s en afzonderlijke tours.`,
  pl: (country, videoCount, cityCount, categoryCount) =>
    `Odkrywaj ${country} dzięki ${videoCount} prawdziwym filmom spacerowym i podróżniczym z ${cityCount} miast w ${categoryCount} kategoriach. Zobacz ulice, różne miejskie atmosfery i lokalne doświadczenia, a następnie przejdź do stron miast i poszczególnych tras.`,
  sv: (country, videoCount, cityCount, categoryCount) =>
    `Utforska ${country} genom ${videoCount} verkliga promenad- och resevideor från ${cityCount} städer i ${categoryCount} kategorier. Se gator, olika stadsmiljöer och lokala reseupplevelser och fortsätt sedan till stadssidor och enskilda turer.`,
  id: (country, videoCount, cityCount, categoryCount) =>
    `Jelajahi ${country} melalui ${videoCount} video jalan kaki dan perjalanan nyata dari ${cityCount} kota dalam ${categoryCount} kategori. Lihat suasana jalan, berbagai karakter kota, dan pengalaman perjalanan lokal, lalu lanjutkan ke halaman kota dan tur individual.`,
  vi: (country, videoCount, cityCount, categoryCount) =>
    `Khám phá ${country} qua ${videoCount} video đi bộ và du lịch thực tế tại ${cityCount} thành phố thuộc ${categoryCount} danh mục. Xem khung cảnh đường phố, nhiều bầu không khí đô thị và trải nghiệm địa phương, sau đó chuyển đến trang thành phố và từng tour riêng.`
};

function label(key: string) {
  return labels[key]?.[currentLang] || labels[key]?.en || key;
}

const cityMap = new Map<
  string,
  {
    name: string;
    videos: Video[];
  }
>();

for (const video of countryVideos) {
  if (!video.city) continue;

  const slug = createSlug(video.city);

  if (!cityMap.has(slug)) {
    cityMap.set(slug, {
      name: video.city,
      videos: []
    });
  }

  cityMap.get(slug)?.videos.push(video);
}

const cities = Array.from(cityMap.entries())
  .map(([slug, city]) => {
    const heroVideo =
      city.videos.find((video) => video.thumbnail) ||
      city.videos[0];

    return {
      slug,
      name: city.name,
      count: city.videos.length,
      thumbnail:
        heroVideo?.thumbnail ||
        (heroVideo
          ? `https://i.ytimg.com/vi/${heroVideo.id}/hqdefault.jpg`
          : '')
    };
  })
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const categoryMap = new Map<string, Video[]>();

for (const video of countryVideos) {
  const category = video.category || 'Walking Tours';

  if (!categoryMap.has(category)) {
    categoryMap.set(category, []);
  }

  categoryMap.get(category)?.push(video);
}

const categories = Array.from(categoryMap.entries())
  .map(([name, items]) => ({
    name,
    label: getCategoryName(name, currentLang),
    count: items.length
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const videoCount = countryVideos.length;
const cityCount = cities.length;
const categoryCount = categories.length;

const countrySummary =
  summaryTemplates[currentLang]?.(
    countryName,
    videoCount,
    cityCount,
    categoryCount
  ) ||
  summaryTemplates.en(
    countryName,
    videoCount,
    cityCount,
    categoryCount
  );

const heroVideo =
  countryVideos.find((video) => video.thumbnail) ||
  countryVideos[0];

const heroImage =
  heroVideo?.thumbnail ||
  (heroVideo
    ? `https://i.ytimg.com/vi/${heroVideo.id}/maxresdefault.jpg`
    : '');

const pageTitle =
  `${countryName} | ${label('walkingTours')} 4K`;

const metaDescription =
  countrySummary.slice(0, 160);

const pageUrl = Astro.url.href;

const itemListSchema = {
  '@type': 'ItemList',
  itemListElement: countryVideos.map((video, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(
      `/${currentLang}/walks/${video.id}`,
      Astro.url.origin
    ).href,
    name: getVideoCardTitle(video, currentLang)
  }))
};

const cityItemListSchema = {
  '@type': 'ItemList',
  itemListElement: cities.map((city, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(
      `/${currentLang}/cities/${city.slug}`,
      Astro.url.origin
    ).href,
    name: city.name
  }))
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#collection`,
      url: pageUrl,
      name: pageTitle,
      description: countrySummary,
      inLanguage: currentLang,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Old Towns Walks',
        url: Astro.url.origin
      },
      about: {
        '@type': 'Country',
        name: countryName
      },
      mainEntity: itemListSchema,
      hasPart: cityItemListSchema
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: label('backHome'),
          item: new URL(
            `/${currentLang}/`,
            Astro.url.origin
          ).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: countryName,
          item: pageUrl
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
>
  <main class="country-page">
    <div class="country-shell">

      <nav
        class="breadcrumbs"
        aria-label="Breadcrumb"
      >
        <a href={`/${currentLang}/`}>
          {label('backHome')}
        </a>

        <span>/</span>

        <span aria-current="page">
          {countryName}
        </span>
      </nav>

      <section
        class:list={[
          'country-hero',
          heroImage && 'has-image'
        ]}
        style={
          heroImage
            ? `--hero-image: url("${heroImage}")`
            : undefined
        }
      >
        <div class="hero-overlay"></div>

        <div class="hero-content">
          <span class="eyebrow">
            {label('countryHub')}
          </span>

          <h1>{countryName}</h1>

          <p class="hero-intro">
            {label('aboutCountry')}
          </p>

          <div class="hero-stats">
            <div class="stat">
              <strong>{videoCount}</strong>
              <span>{label('videos')}</span>
            </div>

            <div class="stat">
              <strong>{cityCount}</strong>
              <span>{label('cities')}</span>
            </div>

            <div class="stat">
              <strong>{categoryCount}</strong>
              <span>{label('categories')}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="country-summary">
        <div>
          <span class="section-kicker">
            {label('explore')}
          </span>

          <h2>
            {countryName} {label('walkingTours')}
          </h2>
        </div>

        <p>{countrySummary}</p>
      </section>

      {cities.length > 0 && (
        <section class="cities-section">
          <div class="section-title-row">
            <div>
              <span class="section-kicker">
                {label('topCities')}
              </span>

              <h2>{countryName}</h2>
            </div>
          </div>

          <div class="city-grid">
            {cities.map((city) => (
              <a
                href={`/${currentLang}/cities/${city.slug}`}
                class="city-card"
              >
                <div class="city-image">
                  {city.thumbnail && (
                    <img
                      src={city.thumbnail}
                      alt={city.name}
                      loading="lazy"
                    />
                  )}

                  <div class="city-shade"></div>
                </div>

                <div class="city-info">
                  <h3>{city.name}</h3>

                  <span>
                    {city.count} {label('videos')}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {categories.length > 0 && (
        <section class="category-overview">
          <div class="section-title-row">
            <div>
              <span class="section-kicker">
                {label('categories')}
              </span>

              <h2>
                {label('explore')} {countryName}
              </h2>
            </div>
          </div>

          <div class="category-grid">
            {categories.map((category) => (
              <button
                type="button"
                class="category-card"
                data-category-target={category.name}
              >
                <span class="category-name">
                  {category.label}
                </span>

                <span class="category-count">
                  {category.count}
                </span>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="videos-section">
        <div class="section-title-row">
          <div>
            <span class="section-kicker">
              {label('allVideos')}
            </span>

            <h2>{countryName}</h2>
          </div>

          <button
            type="button"
            class="reset-filter"
            data-category-target="All"
          >
            {label('allVideos')} · {videoCount}
          </button>
        </div>

        <div class="video-grid">
          {countryVideos.map((video) => (
            <article
              class="video-card"
              data-video-card
              data-category={video.category || 'Walking Tours'}
            >
              <a
                href={`/${currentLang}/walks/${video.id}`}
                class="thumbnail"
              >
                <img
                  src={
                    video.thumbnail ||
                    `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`
                  }
                  alt={getVideoCardTitle(video, currentLang)}
                  loading="lazy"
                />

                <div class="thumbnail-shade"></div>

                {video.badge && (
                  <span class="badge">
                    {video.badge}
                  </span>
                )}

                <span class="category-badge">
                  {getCategoryName(
                    video.category || 'Walking Tours',
                    currentLang
                  )}
                </span>
              </a>

              <div class="video-info">
                <h3>
                  <a href={`/${currentLang}/walks/${video.id}`}>
                    {getVideoCardTitle(video, currentLang)}
                  </a>
                </h3>

                {video.city && (
                  <a
                    href={`/${currentLang}/cities/${createSlug(video.city)}`}
                    class="city-link"
                  >
                    {video.city}
                  </a>
                )}

                {(video.channelTitle || video.channel) && (
                  <p class="channel">
                    {video.channelTitle || video.channel}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageSchema)}
  />

  <script is:inline>
    const buttons = document.querySelectorAll('[data-category-target]');
    const cards = document.querySelectorAll('[data-video-card]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-category-target');

        buttons.forEach((item) => {
          item.classList.remove('is-active');
        });

        button.classList.add('is-active');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          const shouldShow =
            target === 'All' ||
            category === target;

          card.classList.toggle('is-hidden', !shouldShow);
        });

        const videosSection = document.querySelector('.videos-section');

        if (videosSection) {
          videosSection.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  </script>
</BaseLayout>


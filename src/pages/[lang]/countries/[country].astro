---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, defaultLang } from '../../../i18n/ui';
import videos from '../../../data/videos.json';
import {
  getVideoCardTitle,
  getCategoryName
} from '../../../lib/videoSeo';

interface Video {
  id: string;
  title: string;
  description?: string;
  thumbnail?: string;
  category?: string;
  channel?: string;
  channelTitle?: string;
  badge?: string;
  publishedAt?: string;
  city?: string;
  country?: string;
}

function createSlug(value: string) {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

export function getStaticPaths() {
  function pathSlug(value: string) {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  const allVideos = videos as Video[];

  const countryMap = new Map<
    string,
    {
      country: string;
      videos: Video[];
    }
  >();

  for (const video of allVideos) {
    if (!video.country) continue;

    const slug = pathSlug(video.country);
    if (!slug) continue;

    if (!countryMap.has(slug)) {
      countryMap.set(slug, {
        country: video.country,
        videos: []
      });
    }

    countryMap.get(slug)?.videos.push(video);
  }

  const paths: Array<{
    params: {
      lang: string;
      country: string;
    };
    props: {
      countryName: string;
      countryVideos: Video[];
    };
  }> = [];

  for (const lang of Object.keys(languages)) {
    for (const [slug, countryData] of countryMap) {
      paths.push({
        params: {
          lang,
          country: slug
        },
        props: {
          countryName: countryData.country,
          countryVideos: countryData.videos
        }
      });
    }
  }

  return paths;
}

const { lang } = Astro.params;

const currentLang =
  lang && lang in languages
    ? lang
    : defaultLang;

const {
  countryName,
  countryVideos
} = Astro.props as {
  countryName: string;
  countryVideos: Video[];
};


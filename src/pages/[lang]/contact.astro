const requestedLang = Astro.params.lang || defaultLang;
const currentLang = requestedLang in contactContent ? requestedLang : defaultLang;
const t = contactContent[currentLang as keyof typeof contactContent];

const canonicalUrl = new URL(`/${currentLang}/contact`, Astro.url.origin).href;
const alternateLinks = Object.keys(languages).map((lang) => ({
  lang,
  href: new URL(`/${lang}/contact`, Astro.url.origin).href
}));

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: canonicalUrl,
  name: t.metaTitle,
  description: t.metaDescription,
  inLanguage: currentLang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Old Towns Walks',
    url: Astro.url.origin
  }
};
---

<BaseLayout title={t.metaTitle} description={t.metaDescription} canonical={canonicalUrl}>
  <Fragment slot="head">
    {alternateLinks.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/contact', Astro.url.origin).href} />
  </Fragment>

  <div class="contact-wrapper">
    <a href={`/${currentLang}/`} class="back-link">← {t.backHome}</a>

    <section class="contact-header">
      <h1>{t.headingLead} <span class="highlight">{t.headingAccent}</span></h1>
      <p class="subtitle">{t.subtitle}</p>
    </section>

    <div class="contact-grid">
      <section class="info-card">
        <h2 class="card-title">{t.infoTitle}</h2>
        <p class="card-desc">{t.infoDesc}</p>

        <div class="contact-details">
          <div class="contact-item">
            <span class="label">{t.emailLabel}</span>
            <a href="mailto:contact@oldtownswalks.com" class="value link">contact@oldtownswalks.com</a>
          </div>

          <div class="contact-item">
            <span class="label">{t.youtubeLabel}</span>
            <a href="https://www.youtube.com/@OldTowns" target="_blank" rel="noopener noreferrer" class="value link">{t.youtubeText}</a>
          </div>

          <div class="contact-item">
            <span class="label">{t.focusLabel}</span>
            <span class="value">{t.focusText}</span>
          </div>
        </div>
      </section>

      <section class="info-card">
        <h2 class="card-title">{t.formTitle}</h2>
        <form class="contact-form" action="#" method="POST">
          <div class="form-group">
            <label for="name">{t.name}</label>
            <input type="text" id="name" name="name" placeholder={t.namePh} required />
          </div>

          <div class="form-group">
            <label for="email">{t.email}</label>
            <input type="email" id="email" name="email" placeholder={t.emailPh} required />
          </div>

          <div class="form-group">
            <label for="subject">{t.subject}</label>
            <input type="text" id="subject" name="subject" placeholder={t.subjectPh} required />
          </div>

          <div class="form-group">
            <label for="message">{t.message}</label>
            <textarea id="message" name="message" rows="5" placeholder={t.messagePh} required></textarea>
          </div>

          <p class="privacy-note">
            {t.privacyNote}
            <a href={`/${currentLang}/privacy`}>{t.privacyLink}</a>
          </p>

          <button type="submit" class="btn-primary">{t.send}</button>
        </form>
      </section>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
</BaseLayout>

<style>
  .contact-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 24px;
    color: #e5e7eb;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 18px;
    color: #fbc02d;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .contact-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .contact-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .highlight {
    color: #fbc02d;
  }

  .subtitle {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .info-card {
    background-color: #181818;
    border: 1px solid #272727;
    border-radius: 12px;
    padding: 28px;
    height: fit-content;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 0.95rem;
    color: #9ca3af;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-item .label {
    font-size: 0.85rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-item .value {
    font-size: 1rem;
    color: #ffffff;
    font-weight: 500;
  }

  .link {
    color: #fbc02d;
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    color: #d1d5db;
    font-weight: 500;
  }

  .form-group input,
  .form-group textarea {
    background-color: #0f0f0f;
    border: 1px solid #272727;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #fbc02d;
  }

  .privacy-note {
    color: #9ca3af;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
  }

  .privacy-note a {
    color: #fbc02d;
    text-decoration: none;
  }

  .privacy-note a:hover {
    text-decoration: underline;
  }

  .btn-primary {
    background-color: #fbc02d;
    color: #0f0f0f;
    font-weight: 600;
    padding: 12px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    transition: background-color 0.2s ease;
    margin-top: 8px;
  }

  .btn-primary:hover {
    background-color: #fdd835;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-wrapper {
      padding: 24px 16px;
    }
  }
</style>

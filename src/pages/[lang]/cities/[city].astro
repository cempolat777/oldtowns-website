---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, defaultLang } from '../../../i18n/ui';
import videos from '../../../data/videos.json';
import {
  getVideoCardTitle,
  getCategoryName
} from '../../../lib/videoSeo';

interface Video {
  id: string;
  title: string;
  description?: string;
  thumbnail?: string;
  category?: string;
  channel?: string;
  channelTitle?: string;
  badge?: string;
  publishedAt?: string;
  city?: string;
  country?: string;
}

function createSlug(value: string) {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

export function getStaticPaths() {
  function pathSlug(value: string) {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  const allVideos = videos as Video[];

  const cityMap = new Map<
    string,
    {
      city: string;
      country: string;
      videos: Video[];
    }
  >();

  for (const video of allVideos) {
    if (!video.city) continue;

    const slug = pathSlug(video.city);
    if (!slug) continue;

    if (!cityMap.has(slug)) {
      cityMap.set(slug, {
        city: video.city,
        country: video.country || '',
        videos: []
      });
    }

    cityMap.get(slug)?.videos.push(video);
  }

  const paths: Array<{
    params: {
      lang: string;
      city: string;
    };
    props: {
      cityName: string;
      countryName: string;
      cityVideos: Video[];
    };
  }> = [];

  for (const lang of Object.keys(languages)) {
    for (const [slug, cityData] of cityMap) {
      paths.push({
        params: {
          lang,
          city: slug
        },
        props: {
          cityName: cityData.city,
          countryName: cityData.country,
          cityVideos: cityData.videos
        }
      });
    }
  }

  return paths;
}

const { lang } = Astro.params;

const currentLang =
  lang && lang in languages
    ? lang
    : defaultLang;

const {
  cityName,
  countryName,
  cityVideos
} = Astro.props as {
  cityName: string;
  countryName: string;
  cityVideos: Video[];
};


const summaryTemplates: Record<
  string,
  (city: string, country: string, videoCount: number, categoryCount: number) => string
> = {
  en: (city, country, videoCount, categoryCount) =>
    `Discover ${city}${country ? `, ${country}` : ''} through ${videoCount} immersive walking and travel videos across ${categoryCount} categories. Browse real street-level footage, compare different atmospheres and continue into individual tours for a closer look at the city.`,
  tr: (city, country, videoCount, categoryCount) =>
    `${city}${country ? `, ${country}` : ''} için ${categoryCount} kategoride ${videoCount} gerçek yürüyüş ve seyahat videosunu keşfedin. Sokak seviyesindeki görüntülere göz atın, farklı atmosferleri karşılaştırın ve şehri daha yakından görmek için bireysel turlara geçin.`,
  de: (city, country, videoCount, categoryCount) =>
    `Entdecke ${city}${country ? `, ${country}` : ''} mit ${videoCount} authentischen Spaziergangs- und Reisevideos in ${categoryCount} Kategorien. Erkunde echte Straßenansichten, vergleiche verschiedene Atmosphären und öffne einzelne Touren für einen genaueren Blick auf die Stadt.`,
  es: (city, country, videoCount, categoryCount) =>
    `Descubre ${city}${country ? `, ${country}` : ''} mediante ${videoCount} videos reales de caminatas y viajes en ${categoryCount} categorías. Explora escenas a pie de calle, compara distintos ambientes y entra en cada recorrido para conocer mejor la ciudad.`,
  it: (city, country, videoCount, categoryCount) =>
    `Scopri ${city}${country ? `, ${country}` : ''} attraverso ${videoCount} video reali di passeggiate e viaggi in ${categoryCount} categorie. Esplora scene a livello strada, confronta atmosfere diverse e apri i singoli tour per conoscere meglio la città.`,
  fr: (city, country, videoCount, categoryCount) =>
    `Découvrez ${city}${country ? `, ${country}` : ''} à travers ${videoCount} vidéos réelles de promenades et de voyage réparties dans ${categoryCount} catégories. Parcourez les rues, comparez différentes ambiances et ouvrez chaque visite pour explorer la ville plus en détail.`,
  ja: (city, country, videoCount, categoryCount) =>
    `${city}${country ? `（${country}）` : ''}を、${categoryCount}カテゴリー・${videoCount}本のリアルな街歩き／旅行動画で探索できます。実際の街路風景や雰囲気を比較し、各ツアーから都市をより詳しく体験できます。`,
  pt: (city, country, videoCount, categoryCount) =>
    `Descubra ${city}${country ? `, ${country}` : ''} através de ${videoCount} vídeos reais de caminhadas e viagens em ${categoryCount} categorias. Explore cenas ao nível da rua, compare diferentes atmosferas e abra cada passeio para conhecer melhor a cidade.`,
  ru: (city, country, videoCount, categoryCount) =>
    `Откройте ${city}${country ? `, ${country}` : ''} через ${videoCount} реальных прогулочных и туристических видео в ${categoryCount} категориях. Смотрите улицы с уровня пешехода, сравнивайте атмосферу и переходите к отдельным маршрутам для более подробного знакомства с городом.`,
  zh: (city, country, videoCount, categoryCount) =>
    `通过 ${categoryCount} 个分类中的 ${videoCount} 个真实步行与旅行视频探索${city}${country ? `，${country}` : ''}。浏览街道实景、比较不同城市氛围，并进入单个视频进一步了解这座城市。`,
  ko: (city, country, videoCount, categoryCount) =>
    `${city}${country ? `, ${country}` : ''}을 ${categoryCount}개 카테고리의 ${videoCount}개 실제 도보 및 여행 영상으로 탐험하세요. 거리 시점의 실제 풍경과 다양한 분위기를 비교하고 개별 투어에서 도시를 더 자세히 살펴볼 수 있습니다.`,
  ar: (city, country, videoCount, categoryCount) =>
    `استكشف ${city}${country ? `، ${country}` : ''} عبر ${videoCount} فيديو حقيقي للمشي والسفر ضمن ${categoryCount} فئات. شاهد الشوارع من منظور واقعي، وقارن الأجواء المختلفة، وانتقل إلى الجولات الفردية لاكتشاف المدينة بشكل أعمق.`,
  hi: (city, country, videoCount, categoryCount) =>
    `${city}${country ? `, ${country}` : ''} को ${categoryCount} श्रेणियों में ${videoCount} वास्तविक वॉकिंग और ट्रैवल वीडियो के माध्यम से देखें। सड़क-स्तर के दृश्य देखें, अलग-अलग माहौल की तुलना करें और शहर को करीब से जानने के लिए अलग-अलग टूर खोलें।`,
  nl: (city, country, videoCount, categoryCount) =>
    `Ontdek ${city}${country ? `, ${country}` : ''} via ${videoCount} echte wandel- en reisvideo’s in ${categoryCount} categorieën. Bekijk straatbeelden, vergelijk verschillende sferen en open afzonderlijke tours om de stad verder te ontdekken.`,
  pl: (city, country, videoCount, categoryCount) =>
    `Odkrywaj ${city}${country ? `, ${country}` : ''} dzięki ${videoCount} prawdziwym filmom spacerowym i podróżniczym w ${categoryCount} kategoriach. Zobacz miasto z poziomu ulicy, porównaj różne atmosfery i przejdź do poszczególnych tras.`,
  sv: (city, country, videoCount, categoryCount) =>
    `Utforska ${city}${country ? `, ${country}` : ''} genom ${videoCount} verkliga promenad- och resevideor i ${categoryCount} kategorier. Se staden från gatunivå, jämför olika miljöer och öppna enskilda turer för att upptäcka mer.`,
  id: (city, country, videoCount, categoryCount) =>
    `Jelajahi ${city}${country ? `, ${country}` : ''} melalui ${videoCount} video jalan kaki dan perjalanan nyata dalam ${categoryCount} kategori. Lihat suasana jalan secara langsung, bandingkan berbagai atmosfer, lalu buka tur individual untuk mengenal kota lebih dekat.`,
  vi: (city, country, videoCount, categoryCount) =>
    `Khám phá ${city}${country ? `, ${country}` : ''} qua ${videoCount} video đi bộ và du lịch thực tế thuộc ${categoryCount} danh mục. Xem khung cảnh đường phố chân thực, so sánh nhiều bầu không khí khác nhau và mở từng tour để khám phá thành phố sâu hơn.`
};

function label(key: string) {
  return labels[key]?.[currentLang] || labels[key]?.en || key;
}

const categoryMap = new Map<string, Video[]>();

for (const video of cityVideos) {
  const category = video.category || 'Walking Tours';

  if (!categoryMap.has(category)) {
    categoryMap.set(category, []);
  }

  categoryMap.get(category)?.push(video);
}

const categories = Array.from(categoryMap.entries())
  .map(([name, items]) => ({
    name,
    label: getCategoryName(name, currentLang),
    count: items.length,
    slug: createSlug(name)
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const categoryCount = categories.length;
const videoCount = cityVideos.length;

const citySummary =
  summaryTemplates[currentLang]?.(
    cityName,
    countryName,
    videoCount,
    categoryCount
  ) ||
  summaryTemplates.en(
    cityName,
    countryName,
    videoCount,
    categoryCount
  );

const countryUrl =
  countryName
    ? `/${currentLang}/countries/${createSlug(countryName)}`
    : null;

const heroVideo = cityVideos.find((video) => video.thumbnail) || cityVideos[0];

const heroImage =
  heroVideo?.thumbnail ||
  (heroVideo
    ? `https://i.ytimg.com/vi/${heroVideo.id}/maxresdefault.jpg`
    : '');

const pageTitle =
  countryName
    ? `${cityName}, ${countryName} | ${label('walkingTours')} 4K`
    : `${cityName} | ${label('walkingTours')} 4K`;

const metaDescription = citySummary.slice(0, 160);

const pageUrl = Astro.url.href;

const itemListSchema = {
  '@type': 'ItemList',
  itemListElement: cityVideos.map((video, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(
      `/${currentLang}/walks/${video.id}`,
      Astro.url.origin
    ).href,
    name: getVideoCardTitle(video, currentLang)
  }))
};

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: label('backHome'),
    item: new URL(`/${currentLang}/`, Astro.url.origin).href
  }
];

if (countryName && countryUrl) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: countryName,
    item: new URL(countryUrl, Astro.url.origin).href
  });

  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: cityName,
    item: pageUrl
  });
} else {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: cityName,
    item: pageUrl
  });
}

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#collection`,
      url: pageUrl,
      name: pageTitle,
      description: citySummary,
      inLanguage: currentLang,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Old Towns Walks',
        url: Astro.url.origin
      },
      mainEntity: itemListSchema,
      about: {
        '@type': 'City',
        name: cityName,
        ...(countryName
          ? {
              containedInPlace: {
                '@type': 'Country',
                name: countryName
              }
            }
          : {})
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
>
  <main class="city-page">
    <div class="city-shell">

      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={`/${currentLang}/`}>
          {label('backHome')}
        </a>

        {countryName && countryUrl && (
          <>
            <span>/</span>
            <a href={countryUrl}>
              {countryName}
            </a>
          </>
        )}

        <span>/</span>
        <span aria-current="page">
          {cityName}
        </span>
      </nav>

      <section
        class:list={[
          'city-hero',
          heroImage && 'has-image'
        ]}
        style={
          heroImage
            ? `--hero-image: url("${heroImage}")`
            : undefined
        }
      >
        <div class="hero-overlay"></div>

        <div class="hero-content">
          <span class="eyebrow">
            {label('cityGuide')}
          </span>

          <h1>{cityName}</h1>

          {countryName && countryUrl && (
            <a
              href={countryUrl}
              class="country-link"
            >
              <span>{label('country')}</span>
              <strong>{countryName}</strong>
            </a>
          )}

          <p class="hero-intro">
            {label('aboutCity')}
          </p>

          <div class="hero-stats">
            <div class="stat">
              <strong>{videoCount}</strong>
              <span>{label('videos')}</span>
            </div>

            <div class="stat">
              <strong>{categoryCount}</strong>
              <span>{label('categories')}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="city-summary">
        <div>
          <span class="section-kicker">
            {label('explore')}
          </span>

          <h2>
            {cityName} {label('walkingTours')}
          </h2>
        </div>

        <p>{citySummary}</p>
      </section>

      {categories.length > 0 && (
        <section class="category-overview">
          <div class="section-title-row">
            <div>
              <span class="section-kicker">
                {label('categories')}
              </span>

              <h2>
                {label('explore')} {cityName}
              </h2>
            </div>
          </div>

          <div class="category-grid">
            {categories.map((category) => (
              <button
                type="button"
                class="category-card"
                data-category-target={category.name}
              >
                <span class="category-name">
                  {category.label}
                </span>

                <span class="category-count">
                  {category.count}
                </span>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="videos-section">
        <div class="section-title-row">
          <div>
            <span class="section-kicker">
              {label('allVideos')}
            </span>

            <h2>
              {cityName}
            </h2>
          </div>

          <button
            type="button"
            class="reset-filter"
            data-category-target="All"
          >
            {label('allVideos')} · {videoCount}
          </button>
        </div>

        <div class="video-grid">
          {cityVideos.map((video) => (
            <article
              class="video-card"
              data-video-card
              data-category={video.category || 'Walking Tours'}
            >
              <a
                href={`/${currentLang}/walks/${video.id}`}
                class="thumbnail"
              >
                <img
                  src={
                    video.thumbnail ||
                    `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`
                  }
                  alt={getVideoCardTitle(video, currentLang)}
                  loading="lazy"
                />

                <div class="thumbnail-shade"></div>

                {video.badge && (
                  <span class="badge">
                    {video.badge}
                  </span>
                )}

                <span class="category-badge">
                  {getCategoryName(
                    video.category || 'Walking Tours',
                    currentLang
                  )}
                </span>
              </a>

              <div class="video-info">
                <h3>
                  <a href={`/${currentLang}/walks/${video.id}`}>
                    {getVideoCardTitle(video, currentLang)}
                  </a>
                </h3>

                {(video.channelTitle || video.channel) && (
                  <p class="channel">
                    {video.channelTitle || video.channel}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      {countryName && countryUrl && (
        <section class="country-cta">
          <div>
            <span class="section-kicker">
              {label('viewCountry')}
            </span>

            <h2>{countryName}</h2>
          </div>

          <a href={countryUrl}>
            {label('explore')} {countryName} →
          </a>
        </section>
      )}

    </div>
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(pageSchema)}
  />

  <script is:inline>
    const buttons = document.querySelectorAll('[data-category-target]');
    const cards = document.querySelectorAll('[data-video-card]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-category-target');

        buttons.forEach((item) => {
          item.classList.remove('is-active');
        });

        button.classList.add('is-active');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          const shouldShow =
            target === 'All' ||
            category === target;

          card.classList.toggle('is-hidden', !shouldShow);
        });

        const videosSection = document.querySelector('.videos-section');

        if (videosSection) {
          videosSection.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  </script>
</BaseLayout>


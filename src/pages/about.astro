---
import BaseLayout from '../layouts/BaseLayout.astro';

const metaTitle = 'About Us | Old Towns Walks';
const metaDescription = 'Learn about Old Towns Walks, a travel video platform for immersive walking tours, destination discovery, original 4K footage, and curated travel videos.';
const canonicalUrl = new URL('/about', Astro.url.origin).href;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: canonicalUrl,
  name: metaTitle,
  description: metaDescription,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Old Towns Walks',
    url: Astro.url.origin
  }
};
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={canonicalUrl}>
  <div class="about-container">
    <a href="/en/" class="back-link">← Back to Home</a>

    <div class="info-card header-card">
      <h1>About Us <span class="highlight">Old Towns Walks</span></h1>
      <p class="subtitle">Immersive walking tours and destination videos that help you explore places around the world from your screen.</p>
    </div>

    <div class="info-card">
      <p>
        Old Towns Walks is a travel video discovery platform focused on real streets, neighborhoods,
        old towns, waterfronts, airports, markets, and everyday city life. Our goal is to make
        destinations easy to explore through long-form, visually clear video experiences.
      </p>
      <p>
        We publish original walking content and may also organize selected videos that are publicly
        embeddable from third-party platforms. External videos remain hosted by and belong to their
        original publishers. Our original productions prioritize natural point-of-view footage,
        real ambient sound, and a calm, narration-free viewing style.
      </p>
    </div>

    <div class="info-card">
      <h2 class="card-title">How Old Towns Walks Works</h2>
      <div class="features-grid">
        <div class="feature-box">
          <h3>Original Walking Tours</h3>
          <p>Our own productions are created for immersive viewing, with high-resolution footage and on-location sound whenever available.</p>
        </div>
        <div class="feature-box">
          <h3>Curated Destination Videos</h3>
          <p>Selected embeddable travel videos help expand coverage across cities and destinations beyond our own filming locations.</p>
        </div>
        <div class="feature-box">
          <h3>Useful Travel Context</h3>
          <p>Pages are organized around destinations, routes, airports, and nearby travel information so visitors can discover related places more easily.</p>
        </div>
      </div>
    </div>

    <div class="info-card contact-card">
      <div>
        <h2>Get in Touch</h2>
        <p>Have a question, location suggestion, content inquiry, or business request?</p>
      </div>
      <a href="/contact" class="btn-primary">Contact Us</a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
</BaseLayout>

<style>
  .about-container {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    box-sizing: border-box;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 18px;
    color: #fbc02d;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .info-card {
    background-color: #181818;
    border: 1px solid #272727;
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  .header-card h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
  }

  .highlight { color: #fbc02d; }

  .subtitle {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0;
  }

  .info-card p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #d1d5db;
    margin: 0 0 16px 0;
  }

  .info-card p:last-child { margin-bottom: 0; }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 20px 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .feature-box {
    background-color: #0f0f0f;
    border: 1px solid #222222;
    border-radius: 8px;
    padding: 20px;
  }

  .feature-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #fbc02d;
    margin: 0 0 8px 0;
  }

  .feature-box p {
    font-size: 0.9rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0;
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .contact-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px 0;
  }

  .contact-card p {
    font-size: 0.95rem;
    color: #9ca3af;
    margin: 0;
  }

  .btn-primary {
    background-color: #fbc02d;
    color: #0f0f0f;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .about-container { padding: 20px 16px; }
    .contact-card { flex-direction: column; align-items: flex-start; }
    .btn-primary { width: 100%; text-align: center; box-sizing: border-box; }
  }
</style>

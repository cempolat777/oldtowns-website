---
import BaseLayout from '../layouts/BaseLayout.astro';

const metaTitle = 'About Old Towns Walks | Walking Tours & Destination Videos';
const metaDescription = 'Explore virtual walking tours and YouTube travel videos with maps, walking routes, destination information, and nearby hotels at Old Towns Walks.';
const canonicalUrl = new URL('/about', Astro.url.origin).href;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: canonicalUrl,
  name: metaTitle,
  description: metaDescription,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Old Towns Walks',
    url: Astro.url.origin
  }
};
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={canonicalUrl}>
  <div class="about-container">
    <a href="/en/" class="back-link">← Back to Home</a>

    <div class="info-card header-card">
      <h1>About <span class="highlight">Old Towns Walks</span></h1>
      <p class="subtitle">Explore the world through virtual walking tours, travel videos, maps, and destination guides.</p>
    </div>

    <div class="info-card">
      <p>
        Old Towns Walks brings together walking tour videos from YouTube to help you discover cities
        and destinations around the world. Explore historic streets, neighborhoods, waterfronts,
        markets, airports, and everyday city life from your screen.
      </p>
      <p>
        Videos are embedded from YouTube, remain hosted on YouTube, and belong to their respective
        creators and rights holders.
      </p>
    </div>

    <div class="info-card">
      <h2 class="card-title">Explore Walking Tours</h2>
      <div class="features-grid">
        <div class="feature-box">
          <h3>Browse Videos</h3>
          <p>Browse videos by city, country, or category.</p>
        </div>
        <div class="feature-box">
          <h3>Maps &amp; Walking Routes</h3>
          <p>Discover related walks, explore available maps and walking routes.</p>
        </div>
        <div class="feature-box">
          <h3>Destination Information</h3>
          <p>Find useful destination information, including nearby hotels where available. Whether you are planning a trip or exploring from home, Old Towns Walks makes it easier to discover places through video.</p>
        </div>
      </div>
    </div>

    <div class="info-card contact-card">
      <div>
        <h2>Get in Touch</h2>
        <p>Send us a question, destination suggestion, business inquiry, or request concerning a video featured on this site.</p>
      </div>
      <a href="/contact" class="btn-primary">Contact Us</a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
</BaseLayout>

<style>
  .about-container {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    box-sizing: border-box;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 18px;
    color: #fbc02d;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .info-card {
    background-color: #181818;
    border: 1px solid #272727;
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  .header-card h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
  }

  .highlight { color: #fbc02d; }

  .subtitle {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0;
  }

  .info-card p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #d1d5db;
    margin: 0 0 16px 0;
  }

  .info-card p:last-child { margin-bottom: 0; }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 20px 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .feature-box {
    background-color: #0f0f0f;
    border: 1px solid #222222;
    border-radius: 8px;
    padding: 20px;
  }

  .feature-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #fbc02d;
    margin: 0 0 8px 0;
  }

  .feature-box p {
    font-size: 0.9rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0;
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .contact-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px 0;
  }

  .contact-card p {
    font-size: 0.95rem;
    color: #9ca3af;
    margin: 0;
  }

  .btn-primary {
    background-color: #fbc02d;
    color: #0f0f0f;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .about-container { padding: 20px 16px; }
    .contact-card { flex-direction: column; align-items: flex-start; }
    .btn-primary { width: 100%; text-align: center; box-sizing: border-box; }
  }
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us - Old Towns Walks" 
  description="Get in touch with Old Towns Walks for business inquiries, walking location recommendations, or general questions."
>
  <div class="max-w-4xl mx-auto px-4 py-12 text-gray-200">
    <h1 class="text-3xl md:text-4xl font-bold mb-6 text-white">Contact Us</h1>
    
    <p class="text-lg leading-relaxed mb-8 text-gray-300">
      Have feedback, destination suggestions, or business inquiry? We would love to hear from you!
    </p>

    <div class="bg-gray-900 border border-gray-800 rounded-lg p-6 space-y-6">
      <div>
        <h2 class="text-xl font-semibold text-white mb-2">Email Us</h2>
        <p class="text-gray-300">
          For all general inquiries and collaboration requests:
        </p>
        <a href="mailto:contact@oldtownswalks.com" class="text-yellow-500 font-medium hover:underline text-lg block mt-1">
          contact@oldtownswalks.com
        </a>
      </div>

      <hr class="border-gray-800" />

      <div>
        <h2 class="text-xl font-semibold text-white mb-2">Follow & Support</h2>
        <p class="text-gray-300">
          Stay connected and watch our latest 4K 60fps walking tours on YouTube.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
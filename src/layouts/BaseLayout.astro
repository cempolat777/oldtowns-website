---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OLD TOWNS | Global Walking Tours & Cinematic Urban Exploration",
  description = "Experience immersive 4K 60fps walking tours across historic cities, ancient streets, and modern metropolis routes around the world."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-v3.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <!-- SEO & Open Graph Meta Tags -->
  <meta name="description" content="Explore historic cities, atmospheric old towns, and scenic walking tours in 4K 60fps binaural 3D sound. Experience immersive city walks worldwide." />
  <meta name="keywords" content="walking tour, 4k walking tour, old towns, binaural audio, city walk, izmir walking tour, dusseldorf walk, travel 4k" />
  <meta name="author" content="Old Towns Walks" />
  <link rel="canonical" href="https://oldtownswalks.com/" />

  <!-- Social Media Share (Open Graph) -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://oldtownswalks.com/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Explore historic cities, atmospheric old towns, and scenic walking tours in 4K 60fps binaural 3D sound." />
  <meta property="og:image" content="https://oldtownswalks.com/favicon-v3.png" />

      <meta property="og:image" content="https://oldtownswalks.com/og-image.png" />
      <meta property="og:title" content="OLD TOWNS | Global Walking Tours & Cinematic Urban Exploration" />
      <meta property="og:description" content="Experience immersive 4K 60fps walking tours across historic cities" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content="https://oldtownswalks.com/og-image.png" />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #0b0f17;
        color: #f1f5f9;
        font-family: 'Plus Jakarta Sans', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(11, 15, 23, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 3px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .badge {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
      }
      .nav-btn {
        background: #f59e0b;
        color: #0f172a;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 10px 22px;
        border-radius: 50px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);
      }
      .nav-btn:hover {
        background: #fbbf24;
        transform: translateY(-1px);
      }
      footer {
        background: #070a0f;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 40px 24px;
        text-align: center;
        color: #64748b;
        font-size: 13px;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-container">
        <a href="/" class="logo">
          OLD TOWNS <span class="badge">POV TV</span>
        </a>
        <a href="#featured" class="nav-btn">Watch Latest Tour</a>
      </div>
    </header>

    <main style="padding-top: 72px;">
      <slot />
    </main>

    <footer>
      <p>© OLD TOWNS — Immersive 4K Walking Tours & Atmospheric Exploration.</p>
    </footer>
  </body>
</html>
<!-- Schema.org Structural Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Old Towns Walks",
  "url": "https://oldtownswalks.com/",
  "description": "4K 60fps Binaural 3D Sound Walking Tours and Historic Old Town Explorations",
  "publisher": {
    "@type": "Organization",
    "name": "Old Towns Walks",
    "logo": "https://oldtownswalks.com/favicon-v3.png"
  }
}
</script>
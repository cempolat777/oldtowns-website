---
import LanguagePicker from '../components/LanguagePicker.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OLD TOWNS | Global Walking Tours & Cinematic Urban Exploration",
  description = "Experience immersive 4K 60fps walking tours across historic cities, ancient streets, and modern metropolis routes around the world."
} = Astro.props;
---

<!DOCTYPE html>
<html lang={Astro.currentLocale || "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-v3.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <!-- SEO & Open Graph Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="walking tour, 4k walking tour, old towns, binaural audio, city walk, izmir walking tour, dusseldorf walk, travel 4k"
    />
    <meta name="author" content="Old Towns Walks" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Social Media Share (Open Graph) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://oldtownswalks.com/favicon-v3.png"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content="https://oldtownswalks.com/favicon-v3.png"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #0b0f17;
        color: #f1f5f9;
        font-family: 'Plus Jakarta Sans', sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(11, 15, 23, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .logo {
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 3px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .badge {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
      }

      .site-main {
        padding-top: 72px;
      }

      footer {
        background: #070a0f;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 40px 24px;
        text-align: center;
        color: #64748b;
        font-size: 13px;
      }

      @media (max-width: 700px) {
        .nav-container {
          height: 64px;
          padding: 0 14px;
        }

        .site-main {
          padding-top: 64px;
        }

        .logo {
          font-size: 17px;
          letter-spacing: 2px;
        }

        .badge {
          display: none;
        }
      }
    </style>

    <!-- Google Analytics (GA4) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-Z4B6GBNNE8"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z4B6GBNNE8');
    </script>
  </head>

  <body>
    <header>
      <div class="nav-container">
        <a href="/" class="logo">
          OLD TOWNS <span class="badge">POV TV</span>
        </a>

        <div class="nav-actions">
          <LanguagePicker />
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer>
      <div>
        <div>
          <a href="/about">About Us</a>
          <span> · </span>
          <a href="/privacy">Privacy Policy</a>
          <span> · </span>
          <a href="/contact">Contact</a>
        </div>

        <p style="margin-top:12px;">
          &copy; {new Date().getFullYear()} Old Towns Walks. All rights reserved.
        </p>
      </div>
    </footer>

    <!-- Schema.org Structural Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Old Towns Walks",
      "url": "https://oldtownswalks.com/"
    }
    </script>
  </body>
</html>
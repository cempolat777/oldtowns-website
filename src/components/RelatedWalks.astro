---
import videos from '../data/videos.json';

// Video veri tipini tanımlıyoruz (city ve category opsiyonel/güvenli hale getirildi)
interface VideoItem {
  id: string;
  title: string;
  description?: string;
  thumbnail?: string;
  category?: string;
  badge?: string;
  city?: string;
}

interface Props {
  currentVideoId: string;
  city?: string;
  category?: string;
  currentLang?: string;
}

const { currentVideoId, city, category, currentLang = 'en' } = Astro.props;

// JSON verisini tipimize döküyoruz
const typedVideos = videos as VideoItem[];

// İlgili videoları bulma algoritması
const relatedVideos = typedVideos
  .filter((video) => video.id !== currentVideoId) // Şu anki videoyu hariç tut
  .filter((video) => {
    // Önce aynı şehre, yoksa aynı kategoriye göre filtrele
    if (city && video.city) {
      return video.city.toLowerCase() === city.toLowerCase();
    }
    if (category && video.category) {
      return video.category.toLowerCase() === category.toLowerCase();
    }
    return true;
  })
  .slice(0, 3); // En fazla 3 ilgili video göster
---

{relatedVideos.length > 0 && (
  <div class="related-walks-container">
    <h3 class="related-title">
      {city ? `More Walks in ${city}` : 'You Might Also Like'}
    </h3>
    <div class="related-grid">
      {relatedVideos.map((video) => (
        <a href={`/${currentLang}/walks/${video.id}`} class="related-card">
          <div class="thumbnail-wrapper">
            <img 
              src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} 
              alt={`${video.title} - Walking Tour`}
              loading="lazy"
              width="320"
              height="180"
            />
            {video.badge && <span class="badge">{video.badge}</span>}
          </div>
          <p class="video-title">{video.title}</p>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .related-walks-container {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .related-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #fff;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .related-card {
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }
  .related-card:hover {
    transform: translateY(-4px);
  }
  .thumbnail-wrapper {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16/9;
  }
  .thumbnail-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .video-title {
    font-size: 0.875rem;
    margin-top: 0.5rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #e0e0e0;
  }
</style>
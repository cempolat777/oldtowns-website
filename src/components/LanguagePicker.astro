---
import { languages } from '../i18n/ui';

const languageOrder = [
  'en', 'de', 'es', 'fr', 'it', 'tr', 'nl', 'pl', 'pt',
  'sv', 'ru', 'ja', 'ko', 'zh', 'hi', 'id', 'vi', 'ar'
] as const;

const currentPath = Astro.url.pathname;
const pathSegments = currentPath.split('/').filter(Boolean);
const langKeys = Object.keys(languages);

const currentLang = langKeys.includes(pathSegments[0])
  ? pathSegments[0]
  : 'en';

const cleanPath = langKeys.includes(pathSegments[0])
  ? '/' + pathSegments.slice(1).join('/')
  : currentPath;
---

<div class="lang-picker-container">
  <select class="lang-select" data-language-select aria-label="Language">
    {languageOrder.map((lang) => {
      const label = languages[lang];
      const newPath =
        cleanPath === '/' || cleanPath === ''
          ? `/${lang}/`
          : `/${lang}${cleanPath}`;

      return (
        <option
          value={newPath}
          data-lang={lang}
          selected={currentLang === lang}
        >
          {label}
        </option>
      );
    })}
  </select>
</div>

<script>
  document
    .querySelectorAll('[data-language-select]')
    .forEach((element) => {
      if (!(element instanceof HTMLSelectElement)) return;

      element.addEventListener('change', () => {
        const selectedOption = element.options[element.selectedIndex];
        const selectedLang = selectedOption?.getAttribute('data-lang');

        if (selectedLang) {
          localStorage.setItem('preferredLang', selectedLang);
        }

        if (element.value) {
          window.location.href = element.value;
        }
      });
    });
</script>

<style>
  .lang-picker-container {
    display: inline-block;
  }

  .lang-select {
    background-color: #181818;
    color: #fbc02d;
    border: 1px solid #272727;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .lang-select:hover,
  .lang-select:focus {
    border-color: #fbc02d;
  }

  .lang-select option {
    background-color: #181818;
    color: #ffffff;
  }

  @media (max-width: 700px) {
    .lang-select {
      max-width: 150px;
      padding: 6px 8px;
    }
  }
</style>

---
import LanguagePicker from './LanguagePicker.astro';
import { ui } from '../i18n/ui';
import { getPageSeo, getVideoCardTitle, getVideoSchema } from '../lib/videoSeo';

// Dışarıdan gelecek verileri (props) tanımlıyoruz
interface Props {
  videos: Array<any>;
  lang?: string;
}

const { videos = [], lang = 'en' } = Astro.props;

// Dil çevirisi için ui.ts dosyasından ilgili dili çekiyoruz
const translations = ui as Record<string, Record<string, string>>;
const t = translations[lang] || translations.en || translations.tr;
const pageSeo = getPageSeo(lang);

const categories = [
  { id: 'All', label: t['cat.all'] || 'All' },
  { id: 'Walking Tours', label: t['cat.walkingTours'] || 'Walking Tours' },
  { id: 'Drone & Aerial', label: t['cat.droneAerial'] || 'Drone & Aerial' },
  { id: 'POV Rides', label: t['cat.povRides'] || 'POV Rides' },
  { id: 'Night & Rain', label: t['cat.nightRain'] || 'Night & Rain' },
  { id: 'Museums & Culture', label: t['cat.museumsCulture'] || 'Museums & Culture' },
  { id: 'Street Food', label: t['cat.streetFood'] || 'Street Food' },
  { id: 'Nature Trails', label: t['cat.natureTrails'] || 'Nature Trails' },
  { id: 'Documentaries', label: t['cat.documentaries'] || 'Documentaries' }
];

const videoSchema = {
  "@context": "https://schema.org",
  "@graph": videos.map((video) => getVideoSchema(video, lang))
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageSeo.title}</title>

    <meta
      name="description"
      content={pageSeo.description}
    />

    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />

    <style is:inline>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        height: 100%;
        background-color: #0f0f0f;
        color: #f1f1f1;
        font-family: 'Roboto', sans-serif;
        overflow: hidden;
      }

      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      ::-webkit-scrollbar-track {
        background: #0f0f0f;
      }

      ::-webkit-scrollbar-thumb {
        background: #373737;
        border-radius: 4px;
      }

      /* Navbar Layout */

      .navbar {
        height: 56px;
        background-color: #0f0f0f;
        border-bottom: 1px solid #222222;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .icon-btn {
        background: transparent;
        border: none;
        color: #f1f1f1;
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .icon-btn:hover {
        background-color: #272727;
      }

      /* Brand Logo */

      .brand-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        font-weight: 800;
        font-size: 15px;
        letter-spacing: 0.5px;
        border-radius: 3px;
        overflow: hidden;
      }

      .logo-box-1 {
        background-color: #1a1a1a;
        color: #ffffff;
        padding: 4px 8px;
      }

      .logo-box-2 {
        background-color: #ffffff;
        color: #0f0f0f;
        padding: 4px 8px;
      }

      /* Search Bar */

      .nav-center {
        display: flex;
        align-items: center;
        width: 45%;
        max-width: 650px;
      }

      .search-box {
        display: flex;
        width: 100%;
      }

      .search-input {
        width: 100%;
        background-color: #121212;
        border: 1px solid #303030;
        border-radius: 40px 0 0 40px;
        padding: 8px 16px;
        color: #f1f1f1;
        font-size: 14px;
        outline: none;
      }

      .search-input:focus {
        border-color: #aaaaaa;
      }

      .search-btn {
        background-color: #222222;
        border: 1px solid #303030;
        border-left: none;
        border-radius: 0 40px 40px 0;
        padding: 0 20px;
        color: #f1f1f1;
        cursor: pointer;
        display: flex;
        align-items: center;
      }

      .search-btn:hover {
        background-color: #272727;
      }

      /* App Body Structure */

      .app-body {
        display: flex;
        margin-top: 56px;
        height: calc(100vh - 56px);
      }

      /* FIXED SIDEBAR */

      .sidebar {
        width: 240px;
        background-color: #0f0f0f;
        border-right: 1px solid #222222;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex-shrink: 0;
        height: 100%;
        overflow-y: auto;
      }

      .nav-link {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 10px 12px;
        border-radius: 10px;
        color: #aaaaaa;
        text-decoration: none;
        font-size: 14px;
      }

      .nav-link:hover {
        background-color: #272727;
        color: #ffffff;
      }

      .nav-link.active {
        background-color: #272727;
        color: #ffffff;
        font-weight: 500;
      }

      .nav-link.active .material-symbols-outlined {
        color: #ffffff;
      }

      .sidebar-divider {
        border: none;
        border-top: 1px solid #222222;
        margin: 8px 0;
      }

      .sidebar-lang {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 10px 12px;
        border-radius: 10px;
        color: #aaaaaa;
        font-size: 14px;
      }

      .sidebar-lang :global(.lang-picker-container) {
        display: inline-block;
      }

      .sidebar-lang :global(.lang-select) {
        background-color: transparent !important;
        color: #aaaaaa !important;
        border: none !important;
        padding: 0 !important;
        font-size: 14px !important;
        font-weight: 400 !important;
      }

      .sidebar-lang :global(.lang-select:hover) {
        color: #ffffff !important;
      }

      .sidebar-ad-container {
        position: sticky;
        top: 10px;
        margin-top: auto;
        padding: 12px;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        min-height: 250px;
        width: 100%;
      }

      .ad-banner-top {
        width: 100%;
        min-height: 90px;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        margin-bottom: 24px;
      }

      .ad-card-slot {
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        min-height: 220px;
        width: 100%;
      }

      /* MAIN CONTENT CONTAINER */

      .content-area {
        flex: 1;
        overflow-y: auto;
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .sticky-header-wrapper {
        position: sticky;
        top: 0;
        background-color: #0f0f0f;
        z-index: 10;
        padding: 24px 24px 0 24px;
      }

      .chips-bar {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 16px;
      }

      .chips-bar::-webkit-scrollbar {
        display: none;
      }

      .chip {
        background-color: #272727;
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
        cursor: pointer;
      }

      .chip:hover {
        background-color: #3f3f3f;
      }

      .chip.active {
        background-color: #ffffff;
        color: #000000;
      }

      .scrollable-grid-container {
        padding: 0 24px 24px 24px;
      }

      .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px 20px;
      }

      /* Fragment yerine kullanılan wrapper */
      .video-card-wrapper {
        display: contents;
      }

      .video-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .thumbnail-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        background-color: #1f1f1f;
        border: 1px solid #222222;
        cursor: pointer;
      }

      .video-poster {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .thumbnail-wrapper:hover .video-poster {
        transform: scale(1.03);
      }

      .thumbnail-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      .video-details {
        display: flex;
        gap: 12px;
      }

      .video-info {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      .video-title {
        font-size: 15px;
        font-weight: 500;
        color: #f1f1f1;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .channel-name {
        font-size: 13px;
        color: #aaaaaa;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .verified-icon {
        font-size: 15px;
        color: #aaaaaa;
      }

      .video-stats {
        font-size: 13px;
        color: #aaaaaa;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 2px;
      }

      .badge-tag {
        margin-left: auto;
        background-color: #272727;
        color: #aaaaaa;
        font-size: 11px;
        font-weight: bold;
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid #303030;
      }

      @media (max-width: 1100px) {
        .video-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 700px) {
        .sidebar {
          display: none;
        }

        .video-grid {
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .nav-center {
          width: 50%;
        }

        .content-area {
          padding-bottom: 80px;
        }

        .sticky-header-wrapper {
          padding: 12px 12px 0 12px;
        }

        .scrollable-grid-container {
          padding: 0 12px 12px 12px;
        }

        .ad-banner-top {
          min-height: 50px;
        }

        .ad-card-slot {
          min-height: 180px;
        }
      }

      .mobile-bottom-nav {
        display: none;
      }

      @media (max-width: 700px) {
        .mobile-bottom-nav {
          display: flex;
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          height: 60px;
          background-color: #0f0f0f;
          border-top: 1px solid #222222;
          justify-content: space-around;
          align-items: center;
          z-index: 1000;
        }

        .mobile-nav-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          color: #aaaaaa;
          text-decoration: none;
          font-size: 10px;
          gap: 2px;
        }

        .mobile-nav-item.active,
        .mobile-nav-item:hover {
          color: #ffffff;
        }

        .mobile-nav-item .material-symbols-outlined {
          font-size: 22px;
        }
      }
    </style>

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z4B6GBNNE8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z4B6GBNNE8');
    </script>
  </head>

  <body>

    <!-- FIXED TOP NAVBAR -->

    <header class="navbar">
      <div class="nav-left">

        <button class="icon-btn" aria-label="Open menu">
          <span class="material-symbols-outlined">menu</span>
        </button>

        <a href="/" class="brand-logo">
          <div class="logo-box-1">OLD</div>
          <div class="logo-box-2">TOWNS</div>
        </a>

      </div>

      <div class="nav-center">
        <div class="search-box">

          <input
            type="text"
            id="searchInput"
            placeholder="Search cities, countries, or walking tours..."
            class="search-input"
          />

          <button class="search-btn" aria-label="Search">
            <span class="material-symbols-outlined">search</span>
          </button>

        </div>
      </div>
    </header>


    <!-- MAIN APP STRUCTURE -->

    <div class="app-body">

      <!-- FIXED SIDEBAR -->

      <aside class="sidebar">

        <a href={`/${lang}/`} class="nav-link active">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>{t['nav.home'] || 'Home'}</span>
        </a>

        <a href="/map" class="nav-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span>{t['nav.map'] || 'World Map'}</span>
        </a>

        <a href="/hotels" class="nav-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/>
            <path d="M9 6h6"/>
            <path d="M9 10h6"/>
            <path d="M9 14h6"/>
            <path d="M9 18h6"/>
          </svg>
          <span>{t['nav.hotels'] || 'Hotels'}</span>
        </a>

        <a href="/photos" class="nav-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
          <span>{t['nav.photos'] || 'World Photos'}</span>
        </a>

        <a href="/historic" class="nav-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="22" x2="20" y2="22"/>
            <line x1="10" y1="2" x2="14" y2="2"/>
            <path d="M6 18V11M10 18V11M14 18V11M18 18V11"/>
            <polygon points="12 2 4 7 20 7 12 2"/>
          </svg>
          <span>{t['nav.historic'] || 'Historic & Boutique'}</span>
        </a>

        <hr class="sidebar-divider" />

        <div class="sidebar-lang">

          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 1-9 9"/>
            <path d="M21 12a9 9 0 0 0-9-9"/>
            <path d="M21 12H3"/>
            <path d="M12 21a9 9 0 0 1-9-9"/>
            <path d="M12 21c1.657 0 3-4.03 3-9s-1.343-9-3-9"/>
            <path d="M12 21c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
            <path d="M12 3a9 9 0 0 1 9 9"/>
          </svg>

          <LanguagePicker />

        </div>

        <a href="/about" class="nav-link">
          <span class="material-symbols-outlined">info</span>
          <span>{t['nav.about'] || 'About'}</span>
        </a>

        <a href="/privacy" class="nav-link">
          <span class="material-symbols-outlined">policy</span>
          <span>{t['nav.privacy'] || 'Privacy Policy'}</span>
        </a>

        <a href="/contact" class="nav-link">
          <span class="material-symbols-outlined">mail</span>
          <span>{t['nav.contact'] || 'Contact'}</span>
        </a>

        <!-- REKLAM 1: SOL SIDEBAR STICKY AD SLOT -->

        <div class="sidebar-ad-container"></div>

      </aside>


      <!-- MAIN SCROLLABLE CONTENT AREA -->

      <main class="content-area">

        <div class="sticky-header-wrapper">

          <div class="chips-bar">

            {categories.map((cat, index) => (
              <button
                class={`chip ${index === 0 ? 'active' : ''}`}
                data-category-target={cat.id}
              >
                {cat.label}
              </button>
            ))}

          </div>

          <div class="ad-banner-top"></div>

        </div>


        <!-- VIDEO GRID CONTAINER -->

        <div class="scrollable-grid-container">

          <div class="video-grid">

            {videos.map((video, index) => (

              <div class="video-card-wrapper">

                <div
                  class="video-card"
                  data-category={video.category || 'Walking Tours'}
                >

                  <div
                    class="thumbnail-wrapper"
                    data-video-id={video.id}
                  >

                    <img
                      src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                      alt={getVideoCardTitle(video, lang)}
                      class="video-poster"
                      loading="lazy"
                    />

                  </div>


                  <div class="video-details">

                    <div class="video-info">

                      <h3 class="video-title">
                        {getVideoCardTitle(video, lang)}
                      </h3>

                      <div class="channel-name">
                        <span>{video.channel}</span>

                        <span class="material-symbols-outlined verified-icon">
                          check_circle
                        </span>
                      </div>

                      <div class="video-stats">
                        <span class="badge-tag">
                          {video.badge}
                        </span>
                      </div>

                    </div>

                  </div>

                </div>


                {(index + 1) % 5 === 0 && (
                  <div class="ad-card-slot"></div>
                )}

              </div>

            ))}

          </div>

        </div>

      </main>

    </div>


    <!-- MOBILE NAVIGATION BAR -->

    <nav class="mobile-bottom-nav">

      <a href={`/${lang}/`} class="mobile-nav-item active">
        <span class="material-symbols-outlined">home</span>
        <span>{t['nav.home'] || 'Home'}</span>
      </a>

      <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">bolt</span>
        <span>Shorts</span>
      </a>

      <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">flight</span>
        <span>Drone</span>
      </a>

      <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">grid_view</span>
        <span>Categories</span>
      </a>

    </nav>


    <!-- Inline Script -->

    <script is:inline>

      function setupFilters() {

        const chips = document.querySelectorAll('.chip');
        const videoCards = document.querySelectorAll('.video-card');
        const adSlots = document.querySelectorAll('.ad-card-slot');
        const searchInput = document.getElementById('searchInput');

        if (!chips.length && !videoCards.length) return;

        let currentCategory = 'All';


        function filterVideos() {

          const searchTerm = searchInput
            ? searchInput.value.toLowerCase().trim()
            : '';

          videoCards.forEach(card => {

            const videoCategory =
              card.getAttribute('data-category') || '';

            const titleEl =
              card.querySelector('.video-title');

            const title =
              titleEl
                ? titleEl.textContent.toLowerCase()
                : '';

            const matchesCategory =
              currentCategory === 'All' ||
              videoCategory.toLowerCase().trim() ===
              currentCategory.toLowerCase().trim();

            const matchesSearch =
              title.includes(searchTerm);

            if (matchesCategory && matchesSearch) {

              card.style.setProperty(
                'display',
                'flex',
                'important'
              );

            } else {

              card.style.setProperty(
                'display',
                'none',
                'important'
              );

            }

          });


          // Filtreleme yapıldığında boş reklam alanlarını gizle

          adSlots.forEach(ad => {

            if (currentCategory === 'All' && !searchTerm) {

              ad.style.setProperty(
                'display',
                'block',
                'important'
              );

            } else {

              ad.style.setProperty(
                'display',
                'none',
                'important'
              );

            }

          });

        }


        chips.forEach(chip => {

          chip.addEventListener('click', (e) => {

            e.preventDefault();

            chips.forEach(c =>
              c.classList.remove('active')
            );

            chip.classList.add('active');

            currentCategory =
              chip.getAttribute('data-category-target') || 'All';

            filterVideos();

          });

        });


        if (searchInput) {

          searchInput.addEventListener(
            'input',
            filterVideos
          );

        }


        // Lazy Load Embeds

        document
          .querySelectorAll('.thumbnail-wrapper')
          .forEach(wrapper => {

            wrapper.addEventListener('click', () => {

              const videoId =
                wrapper.getAttribute('data-video-id');

              if (videoId) {

                wrapper.innerHTML = `
                  <iframe
                    src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&modestbranding=1&rel=0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
                  </iframe>
                `;

              }

            });

          });

      }


      if (document.readyState === 'loading') {

        document.addEventListener(
          'DOMContentLoaded',
          setupFilters
        );

      } else {

        setupFilters();

      }

    </script>


    <!-- Schema Structure -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(videoSchema)}
    />

  </body>
</html>
    <script is:inline>

      function setupFilters() {

        const chips = document.querySelectorAll('.chip');
        const videoCards = document.querySelectorAll('.video-card');
        const videoGrid = document.querySelector('.video-grid');
        const emptyState = document.getElementById('emptyState');
        const searchInput = document.getElementById('searchInput');

        const initialSearch = new URLSearchParams(window.location.search).get('q');

        if (searchInput instanceof HTMLInputElement && initialSearch) {
          searchInput.value = initialSearch;
        }

        if (!chips.length && !videoCards.length) return;

        let currentCategory = 'All';

        const POPULAR_CITIES = [
          'Tokyo', 'London', 'Paris', 'New York', 'Istanbul', 'Rome', 'Bangkok',
          'Barcelona', 'Amsterdam', 'Berlin', 'Vienna', 'Prague', 'Madrid',
          'Lisbon', 'Dubai', 'Singapore', 'Seoul', 'Kyoto', 'Osaka', 'Venice',
          'Florence'
        ];

        function shuffleArray(items) {
          const result = [...items];
          for (let i = result.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [result[i], result[j]] = [result[j], result[i]];
          }
          return result;
        }

        function getCardCity(card) {
          return (card.getAttribute('data-city') || '').trim();
        }

        function buildMixedOrder(cards) {
          const popular = [];
          const other = [];

          cards.forEach(card => {
            const city = getCardCity(card).toLowerCase();
            const isPopular = POPULAR_CITIES.some(
              popularCity => popularCity.toLowerCase() === city
            );
            (isPopular ? popular : other).push(card);
          });

          const popularPool = shuffleArray(popular);
          const otherPool = shuffleArray(other);
          const result = [];
          const recentCities = [];

          function takeBest(pool) {
            if (!pool.length) return null;
            let index = pool.findIndex(card => {
              const city = getCardCity(card).toLowerCase();
              return !city || !recentCities.includes(city);
            });
            if (index < 0) index = 0;
            return pool.splice(index, 1)[0];
          }

          while (popularPool.length || otherPool.length) {
            const preferPopular =
              popularPool.length > 0 &&
              (otherPool.length === 0 || Math.random() < 0.6);

            let card = preferPopular ? takeBest(popularPool) : takeBest(otherPool);
            if (!card) card = takeBest(popularPool) || takeBest(otherPool);
            if (!card) break;

            result.push(card);
            const city = getCardCity(card).toLowerCase();
            if (city) {
              recentCities.push(city);
              if (recentCities.length > 3) recentCities.shift();
            }
          }

          return result;
        }

        function reorderVisibleVideos() {
          if (!videoGrid) return;
          const visibleCards = Array.from(videoCards).filter(
            card => card.style.display !== 'none'
          );
          buildMixedOrder(visibleCards).forEach(card => {
            const wrapper = card.closest('.video-card-wrapper');
            if (wrapper) videoGrid.appendChild(wrapper);
          });
        }


        function filterVideos() {

          const searchTerm = searchInput
            ? searchInput.value.toLowerCase().trim()
            : '';

          videoCards.forEach(card => {

            const videoCategory =
              card.getAttribute('data-category') || '';

            const titleEl =
              card.querySelector('.video-title');

            const title =
              titleEl
                ? titleEl.textContent.toLowerCase()
                : '';

            const matchesCategory =
              currentCategory === 'All' ||
              videoCategory.toLowerCase().trim() ===
              currentCategory.toLowerCase().trim();

            const matchesSearch =
              title.includes(searchTerm);

            if (matchesCategory && matchesSearch) {

              card.style.setProperty(
                'display',
                'flex',
                'important'
              );

            } else {

              card.style.setProperty(
                'display',
                'none',
                'important'
              );

            }

          });


          // Her 5 gÃƒÆ’Ã‚Â¶rÃƒÆ’Ã‚Â¼nÃƒÆ’Ã‚Â¼r videodan sonra 1 reklam alanÃƒâ€žÃ‚Â± oluÃƒâ€¦Ã…Â¸tur.
          // BÃƒÆ’Ã‚Â¶ylece TÃƒÆ’Ã‚Â¼mÃƒÆ’Ã‚Â¼ veya herhangi bir kategori seÃƒÆ’Ã‚Â§ildiÃƒâ€žÃ…Â¸inde
          // reklamlar sadece o anda gÃƒÆ’Ã‚Â¶rÃƒÆ’Ã‚Â¼nen videolara gÃƒÆ’Ã‚Â¶re yeniden dizilir.
          if (videoGrid) {

            videoGrid
              .querySelectorAll('.ad-card-slot')
              .forEach(ad => ad.remove());

            reorderVisibleVideos();

            const visibleCards = Array.from(videoGrid.querySelectorAll('.video-card')).filter(card =>
              card.style.display !== 'none'
            );

            if (emptyState) {
              emptyState.hidden = visibleCards.length !== 0;
            }

            visibleCards.forEach((card, index) => {

              if ((index + 1) % 5 !== 0) return;

              const wrapper = card.closest('.video-card-wrapper');

              if (!wrapper) return;

              const adSlot = document.createElement('div');
              adSlot.className = 'ad-card-slot';
              adSlot.setAttribute('aria-hidden', 'true');

              wrapper.insertAdjacentElement('afterend', adSlot);

            });

          }

        }


        chips.forEach(chip => {

          chip.addEventListener('click', (e) => {

            e.preventDefault();

            chips.forEach(c =>
              c.classList.remove('active')
            );

            chip.classList.add('active');

            currentCategory =
              chip.getAttribute('data-category-target') || 'All';

            filterVideos();

          });

        });


        if (searchInput) {

          searchInput.addEventListener(
            'input',
            filterVideos
          );

        }


        // Ãƒâ€žÃ‚Â°lk aÃƒÆ’Ã‚Â§Ãƒâ€žÃ‚Â±lÃƒâ€žÃ‚Â±Ãƒâ€¦Ã…Â¸ta da 5 video + 1 reklam dÃƒÆ’Ã‚Â¼zenini kur.
        filterVideos();


        // Hover Video Preview

        const previewWrappers = Array.from(
          document.querySelectorAll('.thumbnail-wrapper')
        );

        // Ãƒâ€žÃ‚Â°lk ekrandaki videolarÃƒâ€žÃ‚Â±n YouTube baÃƒâ€žÃ…Â¸lantÃƒâ€žÃ‚Â±sÃƒâ€žÃ‚Â±nÃƒâ€žÃ‚Â± tarayÃƒâ€žÃ‚Â±cÃƒâ€žÃ‚Â± boÃƒâ€¦Ã…Â¸ta iken
        // ÃƒÆ’Ã‚Â¶nceden Ãƒâ€žÃ‚Â±sÃƒâ€žÃ‚Â±tÃƒâ€žÃ‚Â±r. BÃƒÆ’Ã‚Â¶ylece ilk hover daha hÃƒâ€žÃ‚Â±zlÃƒâ€žÃ‚Â± baÃƒâ€¦Ã…Â¸layabilir.
        const prewarmPreviewConnections = () => {

          previewWrappers
            .slice(0, 6)
            .forEach(wrapper => {

              const videoId =
                wrapper.getAttribute('data-video-id');

              if (!videoId) return;

              const prefetch = document.createElement('link');
              prefetch.rel = 'prefetch';
              prefetch.href =
                `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&playsinline=1&modestbranding=1&rel=0`;

              document.head.appendChild(prefetch);

            });

        };

        if ('requestIdleCallback' in window) {

          window.requestIdleCallback(
            prewarmPreviewConnections,
            { timeout: 1200 }
          );

        } else {

          setTimeout(
            prewarmPreviewConnections,
            500
          );

        }


        previewWrappers.forEach(wrapper => {

          let previewActive = false;
          let previewFrame = null;

          const startPreview = () => {

            const videoId =
              wrapper.getAttribute('data-video-id');

            if (!videoId || previewActive) return;

            previewActive = true;

            const iframe = document.createElement('iframe');

            iframe.className = 'preview-frame';
            iframe.src =
              `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&playsinline=1&modestbranding=1&rel=0`;
            iframe.title = 'Video preview';
            iframe.tabIndex = -1;
            iframe.allow =
              'autoplay; encrypted-media; picture-in-picture';

            iframe.addEventListener(
              'load',
              () => iframe.classList.add('is-ready'),
              { once: true }
            );

            previewFrame = iframe;
            wrapper.appendChild(iframe);

          };

          const stopPreview = () => {

            if (!previewActive) return;

            previewActive = false;

            if (previewFrame) {
              previewFrame.remove();
              previewFrame = null;
            }

          };

          // Bilgisayar: mouse hover
          wrapper.addEventListener('mouseenter', startPreview);
          wrapper.addEventListener('mouseleave', stopPreview);

          // Smart TV / klavye: kumanda odaÃƒâ€žÃ…Â¸Ãƒâ€žÃ‚Â± karta geldiÃƒâ€žÃ…Â¸inde aynÃƒâ€žÃ‚Â± ÃƒÆ’Ã‚Â¶nizleme davranÃƒâ€žÃ‚Â±Ãƒâ€¦Ã…Â¸Ãƒâ€žÃ‚Â±
          wrapper.addEventListener('focus', startPreview);
          wrapper.addEventListener('blur', stopPreview);

        });

      }


      if (document.readyState === 'loading') {

        document.addEventListener(
          'DOMContentLoaded',
          setupFilters
        );

      } else {

        setupFilters();

      }

    </script>

    <script
      is:inline
      define:vars={{ shareLabel, copiedLabel }}
    >
      const siteShareButton = document.querySelector('[data-site-share-button]');

      if (siteShareButton instanceof HTMLButtonElement) {
        const siteShareLabel = siteShareButton.querySelector('[data-site-share-label]');

        siteShareButton.addEventListener('click', async () => {
          const shareUrl = `${window.location.origin}${window.location.pathname}`;
          const useNativeShare =
            navigator.maxTouchPoints > 0 &&
            typeof navigator.share === 'function';

          try {
            if (useNativeShare) {
              await navigator.share({ title: document.title, url: shareUrl });
              return;
            }

            await navigator.clipboard.writeText(shareUrl);

            if (siteShareLabel) {
              siteShareLabel.textContent = copiedLabel;
              window.setTimeout(() => {
                siteShareLabel.textContent = shareLabel;
              }, 1800);
            }
          } catch (error) {
            if (error instanceof Error && error.name !== 'AbortError') {
              console.error('Share failed.', error);
            }
          }
        });
      }
    </script>


    <script is:inline>
      const mobileMenuOpen = document.querySelector('[data-mobile-menu-open]');
      const mobileMenuClose = document.querySelector('[data-mobile-menu-close]');
      const mobileMenuOverlay = document.querySelector('[data-mobile-menu-overlay]');
      const mobileMenuPanel = document.querySelector('[data-mobile-menu-panel]');
      const mobileLanguagePicker = document.querySelector('[data-mobile-language-picker]');
      const mobileLanguageButton = document.querySelector('[data-mobile-language-button]');
      const mobileLanguageMenu = document.querySelector('[data-mobile-language-menu]');
      const currentLanguageFlag = document.querySelector('[data-current-language-flag]');
      const mobileBackToTop = document.querySelector('[data-mobile-back-to-top]');
      const mobileScrollTrack = document.querySelector('[data-mobile-scroll-track]');
      const mobileScrollThumb = document.querySelector('[data-mobile-scroll-thumb]');
      const contentArea = document.querySelector('.content-area');

      function setMobileMenu(open) {
        if (!mobileMenuPanel || !mobileMenuOverlay) return;
        mobileMenuPanel.classList.toggle('is-open', open);
        mobileMenuOverlay.classList.toggle('is-open', open);
        mobileMenuPanel.setAttribute('aria-hidden', String(!open));
        if (mobileMenuOpen instanceof HTMLButtonElement) {
          mobileMenuOpen.setAttribute('aria-expanded', String(open));
        }
      }

      function setLanguageMenu(open) {
        if (!mobileLanguageMenu) return;
        mobileLanguageMenu.classList.toggle('is-open', open);
        if (mobileLanguageButton instanceof HTMLButtonElement) {
          mobileLanguageButton.setAttribute('aria-expanded', String(open));
        }
      }

      if (mobileMenuOpen) {
        mobileMenuOpen.addEventListener('click', () => setMobileMenu(true));
      }

      if (mobileMenuClose) {
        mobileMenuClose.addEventListener('click', () => setMobileMenu(false));
      }

      if (mobileMenuOverlay) {
        mobileMenuOverlay.addEventListener('click', () => setMobileMenu(false));
      }

      if (mobileLanguageButton) {
        mobileLanguageButton.addEventListener('click', (event) => {
          event.stopPropagation();
          const open = mobileLanguageMenu?.classList.contains('is-open') ?? false;
          setLanguageMenu(!open);
        });
      }

      const languageFlags = {
        en: '🇬🇧', tr: '🇹🇷', de: '🇩🇪', es: '🇪🇸', it: '🇮🇹', fr: '🇫🇷',
        ja: '🇯🇵', pt: '🇵🇹', ru: '🇷🇺', zh: '🇨🇳', ko: '🇰🇷', ar: '🇸🇦',
        hi: '🇮🇳', nl: '🇳🇱', pl: '🇵🇱', sv: '🇸🇪', id: '🇮🇩', vi: '🇻🇳'
      };

      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const activeLanguage = pathParts[0] || 'en';

      if (currentLanguageFlag) {
        currentLanguageFlag.textContent = languageFlags[activeLanguage] || '🌐';
      }

      document.querySelectorAll('[data-lang-code]').forEach((link) => {
        const code = link.getAttribute('data-lang-code');
        link.classList.toggle('is-active', code === activeLanguage);
        if (code) {
          const nextParts = [...pathParts];
          if (nextParts.length) nextParts[0] = code;
          else nextParts.push(code);
          link.setAttribute('href', '/' + nextParts.join('/') + window.location.search + window.location.hash);
        }
      });

      document.addEventListener('click', (event) => {
        if (mobileLanguagePicker && !mobileLanguagePicker.contains(event.target)) {
          setLanguageMenu(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMobileMenu(false);
          setLanguageMenu(false);
        }
      });

      if (contentArea && mobileBackToTop instanceof HTMLButtonElement) {
        let lastScrollTop = contentArea.scrollTop;

        const updateBackToTop = () => {
          const currentScrollTop = contentArea.scrollTop;
          const scrollingUp = currentScrollTop < lastScrollTop;
          const farEnoughDown = currentScrollTop > 500;
          mobileBackToTop.classList.toggle('is-visible', scrollingUp && farEnoughDown);
          lastScrollTop = currentScrollTop;
        };

        contentArea.addEventListener('scroll', updateBackToTop, { passive: true });

        mobileBackToTop.addEventListener('click', () => {
          contentArea.scrollTop = 0;
          mobileBackToTop.classList.remove('is-visible');
        });
      }

      if (contentArea && mobileScrollTrack instanceof HTMLElement && mobileScrollThumb instanceof HTMLElement) {
        const updateScrollThumb = () => {
          const maxScroll = Math.max(0, contentArea.scrollHeight - contentArea.clientHeight);
          const maxThumbTravel = Math.max(0, mobileScrollTrack.clientHeight - mobileScrollThumb.clientHeight);
          const ratio = maxScroll > 0 ? contentArea.scrollTop / maxScroll : 0;
          mobileScrollThumb.style.transform = `translateY(${Math.round(ratio * maxThumbTravel)}px)`;
        };

        const scrollFromPointer = (clientY) => {
          const rect = mobileScrollTrack.getBoundingClientRect();
          const maxThumbTravel = Math.max(0, rect.height - mobileScrollThumb.offsetHeight);
          const thumbTop = Math.min(maxThumbTravel, Math.max(0, clientY - rect.top - mobileScrollThumb.offsetHeight / 2));
          const ratio = maxThumbTravel > 0 ? thumbTop / maxThumbTravel : 0;
          const maxScroll = Math.max(0, contentArea.scrollHeight - contentArea.clientHeight);
          contentArea.scrollTop = ratio * maxScroll;
        };

        let draggingThumb = false;

        mobileScrollThumb.addEventListener('pointerdown', (event) => {
          draggingThumb = true;
          mobileScrollThumb.setPointerCapture(event.pointerId);
          scrollFromPointer(event.clientY);
          event.preventDefault();
        });

        mobileScrollThumb.addEventListener('pointermove', (event) => {
          if (!draggingThumb) return;
          scrollFromPointer(event.clientY);
        });

        mobileScrollThumb.addEventListener('pointerup', (event) => {
          draggingThumb = false;
          if (mobileScrollThumb.hasPointerCapture(event.pointerId)) {
            mobileScrollThumb.releasePointerCapture(event.pointerId);
          }
        });

        mobileScrollTrack.addEventListener('pointerdown', (event) => {
          if (event.target === mobileScrollThumb) return;
          scrollFromPointer(event.clientY);
        });

        contentArea.addEventListener('scroll', updateScrollThumb, { passive: true });
        window.addEventListener('resize', updateScrollThumb);
        updateScrollThumb();
      }
    </script>


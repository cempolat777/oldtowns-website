---
import LanguagePicker from './LanguagePicker.astro';
import { ui } from '../i18n/ui';
import { getPageSeo, getVideoCardTitle, getVideoSchema } from '../lib/videoSeo';

// DÃƒâ€žÃ‚Â±Ãƒâ€¦Ã…Â¸arÃƒâ€žÃ‚Â±dan gelecek verileri (props) tanÃƒâ€žÃ‚Â±mlÃƒâ€žÃ‚Â±yoruz
interface Props {
  videos: Array<any>;
  lang?: string;
}

const { videos = [], lang = 'en' } = Astro.props;

// Dil ÃƒÆ’Ã‚Â§evirisi iÃƒÆ’Ã‚Â§in ui.ts dosyasÃƒâ€žÃ‚Â±ndan ilgili dili ÃƒÆ’Ã‚Â§ekiyoruz
const translations = ui as Record<string, Record<string, string>>;
const t = translations[lang] || translations.en || translations.tr;
const pageSeo = getPageSeo(lang);

const emptyStateText = t['state.videosComingSoon'] || 'Videos coming soon';
const shareLabels: Record<string, string> = {
  en: 'Share', tr: 'Paylaş', de: 'Teilen', es: 'Compartir', it: 'Condividi',
  fr: 'Partager', ja: 'ÃƒÂ¥Ã¢â‚¬Â¦Ã‚Â±ÃƒÂ¦Ã…â€œÃ¢â‚¬Â°', pt: 'Compartilhar', ru: 'ÃƒÂÃ…Â¸ÃƒÂÃ‚Â¾ÃƒÂÃ‚Â´ÃƒÂÃ‚ÂµÃƒÂÃ‚Â»ÃƒÂÃ‚Â¸Ãƒâ€˜Ã¢â‚¬Å¡Ãƒâ€˜Ã…â€™Ãƒâ€˜Ã‚ÂÃƒâ€˜Ã‚Â', zh: 'ÃƒÂ¥Ã‹â€ Ã¢â‚¬Â ÃƒÂ¤Ã‚ÂºÃ‚Â«',
  ko: 'ÃƒÂªÃ‚Â³Ã‚ÂµÃƒÂ¬Ã…â€œÃ‚Â ', ar: 'Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â´ÃƒËœÃ‚Â§ÃƒËœÃ‚Â±Ãƒâ„¢Ã†â€™ÃƒËœÃ‚Â©', hi: 'ÃƒÂ Ã‚Â¤Ã‚Â¸ÃƒÂ Ã‚Â¤Ã‚Â¾ÃƒÂ Ã‚Â¤Ã‚ÂÃƒÂ Ã‚Â¤Ã‚Â¾ ÃƒÂ Ã‚Â¤Ã¢â‚¬Â¢ÃƒÂ Ã‚Â¤Ã‚Â°ÃƒÂ Ã‚Â¥Ã¢â‚¬Â¡ÃƒÂ Ã‚Â¤Ã¢â‚¬Å¡', nl: 'Delen', pl: 'UdostÃƒâ€žÃ¢â€žÂ¢pnij',
  sv: 'Dela', id: 'Bagikan', vi: 'Chia sÃƒÂ¡Ã‚ÂºÃ‚Â»'
};
const copiedLabels: Record<string, string> = {
  en: 'Copied', tr: 'Kopyalandı', de: 'Kopiert', es: 'Copiado', it: 'Copiato',
  fr: 'CopiÃƒÆ’Ã‚Â©', ja: 'ÃƒÂ£Ã¢â‚¬Å¡Ã‚Â³ÃƒÂ£Ã†â€™Ã¢â‚¬ÂÃƒÂ£Ã†â€™Ã‚Â¼ÃƒÂ¦Ã‚Â¸Ã‹â€ ÃƒÂ£Ã‚ÂÃ‚Â¿', pt: 'Copiado', ru: 'ÃƒÂÃ‚Â¡ÃƒÂÃ‚ÂºÃƒÂÃ‚Â¾ÃƒÂÃ‚Â¿ÃƒÂÃ‚Â¸Ãƒâ€˜Ã¢â€šÂ¬ÃƒÂÃ‚Â¾ÃƒÂÃ‚Â²ÃƒÂÃ‚Â°ÃƒÂÃ‚Â½ÃƒÂÃ‚Â¾', zh: 'ÃƒÂ¥Ã‚Â·Ã‚Â²ÃƒÂ¥Ã‚Â¤Ã‚ÂÃƒÂ¥Ã‹â€ Ã‚Â¶',
  ko: 'ÃƒÂ«Ã‚Â³Ã‚ÂµÃƒÂ¬Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ«Ã‚ÂÃ‚Â¨', ar: 'ÃƒËœÃ‚ÂªÃƒâ„¢Ã¢â‚¬Â¦ ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚Â³ÃƒËœÃ‚Â®', hi: 'ÃƒÂ Ã‚Â¤Ã¢â‚¬Â¢ÃƒÂ Ã‚Â¥Ã¢â‚¬Â°ÃƒÂ Ã‚Â¤Ã‚ÂªÃƒÂ Ã‚Â¥Ã¢â€šÂ¬ ÃƒÂ Ã‚Â¤Ã¢â‚¬Â¢ÃƒÂ Ã‚Â¤Ã‚Â¿ÃƒÂ Ã‚Â¤Ã‚Â¯ÃƒÂ Ã‚Â¤Ã‚Â¾ ÃƒÂ Ã‚Â¤Ã¢â‚¬â€ÃƒÂ Ã‚Â¤Ã‚Â¯ÃƒÂ Ã‚Â¤Ã‚Â¾', nl: 'Gekopieerd', pl: 'Skopiowano',
  sv: 'Kopierad', id: 'Disalin', vi: 'Ãƒâ€žÃ‚ÂÃƒÆ’Ã‚Â£ sao chÃƒÆ’Ã‚Â©p'
};
const shareLabel = shareLabels[lang] || shareLabels.en;
const copiedLabel = copiedLabels[lang] || copiedLabels.en;
const languageFlags: Record<string, string> = {
  en: '🇬🇧', tr: '🇹🇷', de: '🇩🇪', es: '🇪🇸', it: '🇮🇹', fr: '🇫🇷',
  ja: '🇯🇵', pt: '🇵🇹', ru: '🇷🇺', zh: '🇨🇳', ko: '🇰🇷', ar: '🇸🇦',
  hi: '🇮🇳', nl: '🇳🇱', pl: '🇵🇱', sv: '🇸🇪', id: '🇮🇩', vi: '🇻🇳'
};
const currentLanguageFlag = languageFlags[lang] || languageFlags.en;
const categories = [
  { id: 'All', label: t['cat.all'] || 'All' },
  { id: 'Walking Tours', label: t['cat.walkingTours'] || 'Walking Tours' },
  { id: 'Airport Walks', label: t['cat.airportWalks'] || 'Airport Walks' },
  { id: 'Beach Walking Tours', label: t['cat.beachWalkingTours'] || 'Beach Walks' },
  { id: 'Drone & Aerial', label: t['cat.droneAerial'] || 'Drone & Aerial' },
  { id: 'POV Rides', label: t['cat.povRides'] || 'POV Rides' },
  { id: 'Night & Rain', label: t['cat.nightRain'] || 'Night & Rain' },
  { id: 'Museums & Culture', label: t['cat.museumsCulture'] || 'Museums & Culture' },
  { id: 'Street Food', label: t['cat.streetFood'] || 'Street Food' },
  { id: 'Nature Trails', label: t['cat.natureTrails'] || 'Nature Trails' },
  { id: 'Documentaries', label: t['cat.documentaries'] || 'Documentaries' }
];

const videoSchema = {
  "@context": "https://schema.org",
  "@graph": videos.map((video) => getVideoSchema(video, lang))
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageSeo.title}</title>

    <meta
      name="description"
      content={pageSeo.description}
    />

    <!-- Video preview baÃƒâ€žÃ…Â¸lantÃƒâ€žÃ‚Â±sÃƒâ€žÃ‚Â±nÃƒâ€žÃ‚Â± ÃƒÆ’Ã‚Â¶nceden hazÃƒâ€žÃ‚Â±rla -->
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="//www.youtube-nocookie.com" />
    <link rel="dns-prefetch" href="//googlevideo.com" />

    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />

    <style is:inline>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        height: 100%;
        background-color: #0f0f0f;
        color: #f1f1f1;
        font-family: 'Roboto', sans-serif;
        overflow: hidden;
      }

      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      ::-webkit-scrollbar-track {
        background: #0f0f0f;
      }

      ::-webkit-scrollbar-thumb {
        background: #373737;
        border-radius: 4px;
      }

      /* Navbar Layout */

      .navbar {
        height: 56px;
        background-color: #0f0f0f;
        border-bottom: 1px solid #222222;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .nav-right {
        display: flex;
        align-items: center;
        margin-left: auto;
      }

      .site-share-button {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 7px 12px;
        background: #222222;
        border: 1px solid #353535;
        border-radius: 8px;
        color: #f1f1f1;
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }

      .site-share-button:hover {
        background: #303030;
        border-color: #f5b400;
      }

      .site-share-button .material-symbols-outlined {
        font-size: 19px;
      }

      .icon-btn {
        background: transparent;
        border: none;
        color: #f1f1f1;
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .icon-btn:hover {
        background-color: #272727;
      }

      /* Brand Logo */

      .brand-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        font-weight: 800;
        font-size: 15px;
        letter-spacing: 0.5px;
        border-radius: 3px;
        overflow: hidden;
      }

      .logo-box-1 {
        background-color: #0f0f0f;
        color: #f5b400;
        padding: 4px 8px;
        border: 1px solid rgba(245, 180, 0, 0.35);
        border-right: none;
      }

      .logo-box-2 {
        background-color: #f5b400;
        color: #0f0f0f;
        padding: 4px 8px;
        border: 1px solid #f5b400;
      }

      /* Search Bar */

      .nav-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        width: 45%;
        max-width: 650px;
      }

      .search-box {
        display: flex;
        width: 100%;
      }

      .search-input {
        width: 100%;
        background-color: #121212;
        border: 1px solid #303030;
        border-radius: 40px 0 0 40px;
        padding: 8px 16px;
        color: #f1f1f1;
        font-size: 14px;
        outline: none;
      }

      .search-input:focus {
        border-color: #aaaaaa;
      }

      .search-btn {
        background-color: #222222;
        border: 1px solid #303030;
        border-left: none;
        border-radius: 0 40px 40px 0;
        padding: 0 20px;
        color: #f1f1f1;
        cursor: pointer;
        display: flex;
        align-items: center;
      }

      .search-btn:hover {
        background-color: #272727;
      }

      /* App Body Structure */

      .app-body {
        display: flex;
        margin-top: 56px;
        height: calc(100vh - 56px);
      }

      /* FIXED SIDEBAR */

      .sidebar {
        width: 240px;
        background-color: #0f0f0f;
        border-right: 1px solid #222222;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex-shrink: 0;
        height: 100%;
        overflow-y: auto;
      }

      .nav-link {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 10px 12px;
        border-radius: 10px;
        color: #aaaaaa;
        text-decoration: none;
        font-size: 14px;
      }

      .nav-link:hover {
        background-color: #272727;
        color: #ffffff;
      }

      .nav-link.active {
        background-color: #272727;
        color: #ffffff;
        font-weight: 500;
      }

      .nav-link.active .material-symbols-outlined {
        color: #ffffff;
      }

      .sidebar-divider {
        border: none;
        border-top: 1px solid #222222;
        margin: 8px 0;
      }

      .sidebar-lang {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 10px 12px;
        border-radius: 10px;
        color: #aaaaaa;
        font-size: 14px;
      }

      .sidebar-lang :global(.lang-picker-container) {
        display: inline-block;
      }

      .sidebar-lang :global(.lang-select) {
        background-color: transparent !important;
        color: #aaaaaa !important;
        border: none !important;
        padding: 0 !important;
        font-size: 14px !important;
        font-weight: 400 !important;
      }

      .sidebar-lang :global(.lang-select:hover) {
        color: #ffffff !important;
      }

      .sidebar-ad-container {
        position: sticky;
        top: 10px;
        margin-top: auto;
        padding: 12px;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        min-height: 250px;
        width: 100%;
      }

      /* AdSense henÃƒÆ’Ã‚Â¼z iÃƒÆ’Ã‚Â§erik yerleÃƒâ€¦Ã…Â¸tirmediyse sol reklam alanÃƒâ€žÃ‚Â±nÃƒâ€žÃ‚Â± tamamen gizle. */
      .sidebar-ad-container:empty {
        display: none;
      }

      .ad-banner-top {
        width: 100%;
        min-height: 90px;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        margin-bottom: 24px;
      }

      /* AdSense henÃƒÆ’Ã‚Â¼z iÃƒÆ’Ã‚Â§erik yerleÃƒâ€¦Ã…Â¸tirmediyse ÃƒÆ’Ã‚Â¼st reklam alanÃƒâ€žÃ‚Â±nÃƒâ€žÃ‚Â± tamamen gizle. */
      .ad-banner-top:empty {
        display: none;
      }

      .ad-card-slot {
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        min-height: 220px;
        width: 100%;
      }

      /* MAIN CONTENT CONTAINER */

      .content-area {
        flex: 1;
        overflow-y: auto;
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .sticky-header-wrapper {
        position: sticky;
        top: 0;
        background-color: #0f0f0f;
        z-index: 10;
        padding: 24px 24px 0 24px;
      }

      .chips-bar {
        display: flex;
        flex-wrap: nowrap;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 16px;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
      }

      .chips-bar::-webkit-scrollbar {
        display: none;
      }

      .chip {
        background-color: #272727;
        color: #ffffff;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
        cursor: pointer;
        flex: 0 0 auto;
      }

      .chip:hover {
        background-color: #3f3f3f;
      }

      .chip.active {
        background-color: #ffffff;
        color: #000000;
      }

      .scrollable-grid-container {
        padding: 0 24px 24px 24px;
      }

      .video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px 20px;
      }

      /* Fragment yerine kullanÃƒâ€žÃ‚Â±lan wrapper */
      .video-card-wrapper {
        display: contents;
      }

      .video-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .thumbnail-wrapper {
        display: block;
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        background-color: #1f1f1f;
        border: 1px solid #222222;
        cursor: pointer;
      }

      .video-poster {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }

      .thumbnail-wrapper:hover .video-poster {
        transform: scale(1.03);
      }

      .thumbnail-wrapper:focus-visible {
        outline: 3px solid #f5b400;
        outline-offset: 3px;
      }

      .thumbnail-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
        pointer-events: none;
      }

      .thumbnail-wrapper .preview-frame {
        opacity: 0;
        transition: opacity 0.12s ease;
      }

      .thumbnail-wrapper .preview-frame.is-ready {
        opacity: 1;
      }

      .video-details {
        display: flex;
        gap: 12px;
      }

      .video-info {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      .video-title {
        font-size: 15px;
        font-weight: 500;
        color: #f1f1f1;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .video-title-link {
        color: inherit;
        text-decoration: none;
      }

      .video-title-link:hover {
        text-decoration: underline;
      }

      .channel-name {
        font-size: 13px;
        color: #aaaaaa;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .verified-icon {
        font-size: 15px;
        color: #aaaaaa;
      }

      .video-stats {
        font-size: 13px;
        color: #aaaaaa;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 2px;
      }

      .badge-tag {
        margin-left: auto;
        background-color: #272727;
        color: #aaaaaa;
        font-size: 11px;
        font-weight: bold;
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid #303030;
      }

      .empty-state {
        width: 100%;
        padding: 56px 20px;
        text-align: center;
        color: #aaaaaa;
        font-size: 15px;
        font-weight: 500;
      }

      .empty-state[hidden] {
        display: none;
      }

      @media (max-width: 1100px) {
        .video-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* Mobile and tablet header */
      .mobile-menu-button,
      .mobile-language-picker,
      .mobile-menu-overlay,
      .mobile-menu-panel,
      .mobile-scroll-track,
      .mobile-back-to-top {
        display: none;
      }

      @media (max-width: 900px) {
        .navbar {
          height: 108px;
          padding: 8px 12px 10px;
          display: grid;
          grid-template-columns: 40px 1fr auto;
          grid-template-rows: 38px 44px;
          column-gap: 8px;
          row-gap: 8px;
          align-items: center;
        }

        .nav-left {
          grid-column: 1 / -1;
          grid-row: 1;
          width: 100%;
          display: flex;
          justify-content: center;
          pointer-events: none;
        }

        .brand-logo {
          pointer-events: auto;
          font-size: 15px;
          letter-spacing: 0.4px;
        }

        .logo-box-1,
        .logo-box-2 {
          padding: 4px 7px;
        }

        .mobile-menu-button {
          display: inline-flex;
          grid-column: 1;
          grid-row: 1;
          width: 36px;
          height: 36px;
          align-items: center;
          justify-content: center;
          background: transparent;
          border: 1px solid #2d2d2d;
          border-radius: 9px;
          color: #f1f1f1;
          cursor: pointer;
          z-index: 2;
        }

        .mobile-menu-button .material-symbols-outlined {
          font-size: 22px;
        }

        .nav-center {
          position: static;
          transform: none;
          grid-column: 1 / -1;
          grid-row: 2;
          width: 100%;
          max-width: none;
          min-width: 0;
          margin: 0;
        }

        .search-box {
          width: 100%;
          min-width: 0;
        }

        .search-input {
          min-width: 0;
          padding: 10px 14px;
          font-size: 14px;
        }

        .search-btn {
          flex: 0 0 46px;
          padding: 0;
          justify-content: center;
        }

        .nav-right {
          grid-column: 3;
          grid-row: 1;
          margin: 0;
          justify-self: end;
          display: flex;
          align-items: center;
          gap: 6px;
          z-index: 2;
        }

        .mobile-language-picker {
          display: block;
          position: relative;
        }

        .mobile-language-button {
          width: 36px;
          height: 36px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          border: 1px solid #2d2d2d;
          border-radius: 9px;
          background: #222222;
          color: #ffffff;
          font-size: 20px;
          line-height: 1;
          cursor: pointer;
        }

        .mobile-language-menu {
          display: none;
          position: absolute;
          top: 42px;
          right: 0;
          width: 210px;
          max-height: min(62vh, 430px);
          overflow-y: auto;
          padding: 8px;
          background: #151515;
          border: 1px solid #333333;
          border-radius: 12px;
          box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
          z-index: 1700;
        }

        .mobile-language-menu.is-open {
          display: block;
        }

        .mobile-language-option {
          display: flex;
          align-items: center;
          gap: 10px;
          width: 100%;
          padding: 10px 11px;
          border-radius: 8px;
          color: #f1f1f1;
          text-decoration: none;
          font-size: 14px;
          font-weight: 500;
        }

        .mobile-language-option:hover,
        .mobile-language-option.is-active {
          background: #272727;
        }

        .mobile-language-flag {
          width: 24px;
          text-align: center;
          font-size: 19px;
          line-height: 1;
        }

        .site-share-button {
          width: 36px;
          min-width: 36px;
          height: 36px;
          min-height: 36px;
          padding: 0;
          border-radius: 9px;
        }

        .site-share-text {
          display: none;
        }

        .app-body {
          margin-top: 108px;
          height: calc(100vh - 108px);
        }

        .sidebar {
          display: none;
        }

        .mobile-menu-overlay {
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.58);
          z-index: 1400;
        }


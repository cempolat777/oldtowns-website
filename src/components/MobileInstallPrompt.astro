const { lang = 'en' } = Astro.props;
const messages: Record<string, [string, string, string, string]> = {
  en: ['Save Old Towns Walks to your home screen.', 'Save to phone', 'Open your browser menu and choose Add to Home Screen.', 'In Safari, tap Share, then Add to Home Screen.'],

---
import LanguagePicker from './LanguagePicker.astro';
import { ui } from '../i18n/ui';

interface Props {
  lang: string;
  activePath?: string;
}

const { lang, activePath = Astro.url.pathname } = Astro.props;
const translations = ui as Record<string, Record<string, string>>;
const t = translations[lang] || translations.en;
const currentPath = activePath.replace(/\/+$/, '') || '/';
const sections = [
  { path: `/${lang}`, icon: 'home', label: t['nav.home'] || 'Home' },
  { path: `/${lang}/map`, icon: 'public', label: t['nav.map'] || 'World Map' },
  { path: `/${lang}/airports`, icon: 'flight', label: t['nav.airports'] || 'Airport Map' },
  { path: `/${lang}/hotels`, icon: 'hotel', label: t['nav.hotels'] || 'Hotels' }
];
const secondary = [
  { path: `/${lang}/about`, icon: 'info', label: t['nav.about'] || 'About' },
  { path: `/${lang}/privacy`, icon: 'policy', label: t['nav.privacy'] || 'Privacy Policy' },
  { path: `/${lang}/contact`, icon: 'mail', label: t['nav.contact'] || 'Contact' }
];
const activeSection = currentPath.startsWith(`/${lang}/walks/`)
  || currentPath.startsWith(`/${lang}/cities/`)
  || currentPath.startsWith(`/${lang}/countries/`)
  ? `/${lang}`
  : currentPath;
---

<div class="mobile-menu-overlay" data-mobile-menu-overlay aria-hidden="true"></div>
<aside class="mobile-menu-panel" id="site-mobile-navigation" data-mobile-menu-panel aria-label="Site navigation" aria-hidden="true" inert>
  <div class="mobile-menu-head">
    <a href={`/${lang}`} class="brand-logo" aria-label="Old Towns Walks">
      <img src="/android-chrome-192x192.png" alt="" class="brand-icon" width="32" height="32" />
      <span class="logo-box-1">OLD</span><span class="logo-box-2">TOWNS</span>
    </a>
    <button type="button" class="mobile-menu-close" data-mobile-menu-close aria-label="Close menu">
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
  </div>
  <nav aria-label="Site sections">
    {sections.map((item) => (
      <a href={item.path} class={`nav-link ${activeSection === item.path ? 'active' : ''}`}
         aria-current={activeSection === item.path ? 'page' : undefined}>
        <span class="material-symbols-outlined" aria-hidden="true">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
    <hr class="sidebar-divider" />
    <div class="sidebar-lang">
      <span class="material-symbols-outlined" aria-hidden="true">language</span>
      <LanguagePicker />
    </div>
    {secondary.map((item) => (
      <a href={item.path} class={`nav-link ${activeSection === item.path ? 'active' : ''}`}
         aria-current={activeSection === item.path ? 'page' : undefined}>
        <span class="material-symbols-outlined" aria-hidden="true">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
</aside>

<style is:global>
  .mobile-menu-overlay,
  .mobile-menu-panel { display: none; }

  @media (max-width: 900px) {
    .mobile-menu-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .58);
      z-index: 1400;
    }
    .mobile-menu-overlay.is-open { display: block; }
    .mobile-menu-panel {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(82vw, 320px);
      padding: 18px 14px 24px;
      background: #111111;
      border-right: 1px solid #2a2a2a;
      color: #f1f1f1;
      font-family: 'Roboto', sans-serif;
      z-index: 1500;
      overflow-y: auto;
      transform: translateX(-102%);
      transition: transform 160ms ease-out;
    }
    .mobile-menu-panel.is-open {
      display: block;
      transform: translateX(0);
    }
    .mobile-menu-panel .mobile-menu-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 0 4px 12px;
      margin-bottom: 18px;
      border-bottom: 1px solid #252525;
    }
    .mobile-menu-panel .brand-logo {
      display: inline-flex;
      align-items: center;
      overflow: hidden;
      border-radius: 3px;
      font-family: 'Roboto', sans-serif;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: .4px;
      text-decoration: none;
      white-space: nowrap;
    }
    .mobile-menu-panel .brand-icon {
      width: 32px;
      height: 32px;
      min-width: 32px;
      object-fit: contain;
      margin-right: 5px;
      border-radius: 5px;
    }
    .mobile-menu-panel .logo-box-1 {
      padding: 4px 7px;
      background: #0f0f0f;
      border: 1px solid rgba(245,180,0,.35);
      border-right: 0;
      color: #f5b400;
    }
    .mobile-menu-panel .logo-box-2 {
      padding: 4px 7px;
      background: #f5b400;
      border: 1px solid #f5b400;
      color: #0f0f0f;
    }
    .mobile-menu-panel .mobile-menu-close {
      flex: 0 0 36px;
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 50%;
      background: #222222;
      color: #ffffff;
      cursor: pointer;
    }
    .mobile-menu-panel .nav-link {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 12px;
      border-radius: 10px;
      color: #aaaaaa;
      font-size: 14px;
      text-decoration: none;
    }
    .mobile-menu-panel .nav-link.active,
    .mobile-menu-panel .nav-link:hover {
      background: #272727;
      color: #ffffff;
    }
    .mobile-menu-panel .sidebar-divider {
      border: 0;
      border-top: 1px solid #222222;
      margin: 8px 0;
    }
    .mobile-menu-panel .sidebar-lang {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 10px 12px;
      color: #aaaaaa;
    }
    .mobile-menu-panel .sidebar-lang :global(.lang-select) {
      background: #181818;
      color: #f5b400;
      border: 1px solid #303030;
      border-radius: 6px;
      max-width: 180px;
    }
  }
</style>
